{
  "schema": "simai-app/1",
  "profile": "node",
  "node": {
    "version": "22",
    "start": "node server.js",
    "install": "none"
  },
  "static": {
    "root": "dist",
    "fallback": "/index.html"
  },
  "routes": [
    {
      "path": "/api/",
      "to": "service"
    }
  ],
  "shared": [
    "state"
  ],
  "health": {
    "path": "/api/settings/get",
    "timeout": 60
  }
}
