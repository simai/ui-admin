{
  "name": "simai-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:runtime": "npm run pin:check && npm run pin:package:check && node scripts/materialize-framework-runtime.mjs --target .runtime && node scripts/materialize-package-runtime.mjs --target .runtime-package",
    "prepare:contracts": "node scripts/materialize-smart-contracts.mjs",
    "prepare:contracts:b0": "node scripts/materialize-smart-contracts.mjs",
    "verify:contracts": "node scripts/verify-smart-contracts-with-studio.mjs",
    "dev": "npm run prepare:runtime && npm run prepare:contracts && vite",
    "dev:runtime": "node scripts/verify-runtime-root.mjs && vite",
    "dev:api": "node server.js",
    "build": "npm run data:check && npm run prepare:runtime && npm run prepare:contracts && npm run check:port && npm run check:polygon && tsc && vite build && node scripts/materialize-framework-runtime.mjs --target \"dist/distr/$(node scripts/runtime-base.mjs --directory)\" && node scripts/materialize-package-runtime.mjs --target \"dist/distr-larena/$(node scripts/runtime-base.mjs --name larena --directory)\"",
    "test:runtime": "node --test tests/runtime-assets.test.mjs tests/navigation-menu-reference.test.mjs",
    "test:api": "node --test tests/mock-api-contract.test.mjs",
    "test:browser": "node tests/run-browser-smoke.mjs",
    "test:preview": "node tests/run-browser-smoke.mjs preview",
    "preview": "vite preview",
    "pin": "node scripts/pin-framework-pair.mjs",
    "pin:check": "node scripts/pin-framework-pair.mjs --check",
    "pin:package": "node scripts/pin-package.mjs",
    "pin:package:check": "node scripts/pin-package.mjs --check",
    "publish": "bash scripts/publish-local-site.sh",
    "check:port": "node scripts/check-port-conformance.mjs",
    "check:published": "node scripts/check-published-runtime.mjs",
    "data": "node scripts/build-polygon-data.mjs && node scripts/build-navigation-data.mjs",
    "data:check": "node scripts/build-polygon-data.mjs --check && node scripts/build-navigation-data.mjs --check",
    "check:polygon": "node scripts/check-polygon.mjs"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "json-server": "^1.0.0-beta.15",
    "playwright-core": "^1.62.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  }
}
