{
  "schema_version": 2,
  "id": "smart.admin-activity",
  "version": "1.0.0",
  "title": "Background activity",
  "summary": "The admin's background activity: «Идёт N» while something runs, a red failure mark beside it until the list was opened, «Не удалось N» in words when nothing runs, no element when nothing is to show; the list of runs in sf-popover; a run's end said by SF.notify and, for a failure, a notification.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "admin",
    "activity",
    "progress",
    "background"
  ],
  "capabilities": [
    "activity",
    "host-port",
    "live-announcement",
    "toast"
  ],
  "custom_element": "sf-admin-activity",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "component.icons",
      "smart.badge",
      "smart.button",
      "smart.popover",
      "smart.progress-run"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "properties": {
      "template": {
        "type": "string",
        "default": "default",
        "description": "Template variant name for SfBaseElement external templates.",
        "const": "default"
      },
      "root-class": {
        "type": "string",
        "default": "",
        "description": "Classes added to the root element the component draws."
      },
      "root-style": {
        "type": "string",
        "default": "",
        "description": "Inline style declarations set on the root element the component draws, custom properties included."
      },
      "history-href": {
        "type": "string",
        "default": "",
        "description": "The address of the activity history: «Все действия» at the list's foot, and where a failure's notification leads when the run has no href."
      },
      "size": {
        "type": "string",
        "default": "1/2",
        "description": "The trigger's rung: 1/2 in the crumbs row, 1 in the phone top line beside the bell.",
        "enum": [
          "1/2",
          "1"
        ]
      },
      "placement": {
        "type": "string",
        "default": "bottom-end",
        "description": "Where the list opens from the trigger.",
        "enum": [
          "bottom-end",
          "bottom-start",
          "bottom"
        ]
      },
      "notify": {
        "type": "boolean",
        "default": true,
        "description": "A run's end says itself: SF.notify success (gone by itself) or error (stays until closed, C339) and a notification in the admin's list (C332). Off, only the event finished."
      },
      "aria-label": {
        "type": "string",
        "default": ""
      },
      "runs": {
        "type": "array",
        "default": [],
        "description": "The host's runs, set anew on every change: each {id, label, state (running|failed|done|cancelled), value, total, unit, text, href, object, cancelable}. A run that leaves running, or is dropped while running, ended: the element tells it once."
      }
    },
    "additionalProperties": false
  },
  "item_contract": {},
  "contracts": {
    "run": {
      "const": "A run: id, label, state (running|failed|done|cancelled), value, total, unit, text, href, object, cancelable."
    }
  },
  "methods": {
    "refresh": {
      "summary": "Reads the runs again (activity.load) when the port offers activity.",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "{outcome: applied} or {outcome: refused, reason}"
      }
    },
    "show": {
      "summary": "Opens the list; refused when there is nothing to show.",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "{outcome: applied} or {outcome: refused, reason}"
      }
    },
    "close": {
      "summary": "Closes the list.",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "{outcome: applied} or {outcome: refused, reason}"
      }
    }
  },
  "events": {
    "sf-admin-activity-open": {
      "summary": "The list opened (vocabulary open): the failures in it count as seen and the mark goes.",
      "payload": {
        "type": "object",
        "required": [],
        "properties": {},
        "additionalProperties": true
      }
    },
    "sf-admin-activity-close": {
      "summary": "The list closed (vocabulary close).",
      "payload": {
        "type": "object",
        "required": [],
        "properties": {},
        "additionalProperties": true
      }
    },
    "sf-admin-activity-retry": {
      "summary": "«Повторить» on a failed run; over a port the element asks activity.retry {id} and reads again.",
      "payload": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "sf-admin-activity-cancel": {
      "summary": "«Отменить» on a running run; over a port the element asks activity.cancel {id} and reads again.",
      "payload": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "sf-admin-activity-finished": {
      "summary": "A run ended (state done or failed), once for the page. Cancelled, the element says nothing of it (no toast, no notification).",
      "payload": {
        "type": "object",
        "required": [
          "id",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "state": {
    "machines": {
      "indicator": [
        "none",
        "running",
        "running-with-failure",
        "failed"
      ]
    },
    "visual_states": [
      "default",
      "error"
    ]
  },
  "persistence": {
    "mode": "none",
    "source_of_truth": "host",
    "network_owner": "host",
    "revision_field": null
  },
  "ownership": {
    "source": "simai/ui-admin",
    "data": "host",
    "effects": "host",
    "forbidden_client_responsibilities": [
      "running the actions",
      "keeping the history of runs"
    ]
  },
  "security": {
    "permissions_owner": "host",
    "untrusted_inputs": [
      "labels and texts (drawn as text)",
      "hrefs (links)"
    ],
    "network_policy": "deny"
  },
  "accessibility": {
    "role": "group",
    "accessible_name": "internal",
    "keyboard": [
      "Tab",
      "Enter",
      "Space",
      "Escape"
    ],
    "focus": "The trigger in reading order; the list is sf-popover's, the focus returns to the trigger when it closes."
  },
  "presentation": {
    "themes": [
      "light",
      "dark"
    ],
    "locales": [
      "en",
      "ru"
    ],
    "responsive": [
      "desktop",
      "mobile"
    ],
    "skeleton": {
      "shape": "none",
      "while_loading": "none"
    }
  },
  "adapter": {
    "kind": "generic",
    "protocol": "simai.smart-studio-adapter.v1",
    "module": null
  },
  "artifacts": {
    "fixtures": [],
    "scenarios": []
  },
  "readiness": {
    "level": "host-required",
    "required_checks": [
      "manifest",
      "loader-rule",
      "admin-activity-contract",
      "admin-activity-browser"
    ]
  },
  "compatibility": {
    "contract_schema": {
      "id": "https://simai.io/contracts/smart-component-manifest.v2.schema.json",
      "version": 2
    },
    "runtime_pair": {
      "ui_revision": "89834691fb9dce692be5353f3214df7aee3a7e27",
      "ui_smart_revision": "89834691fb9dce692be5353f3214df7aee3a7e27"
    },
    "aliases": [],
    "deprecations": [],
    "replacement": null,
    "migrations": []
  },
  "provenance": {
    "source_repository": "simai/ui-admin",
    "source_revision": "0a1b6a3a2cad560220cb1ec19d689d3e3d22e5d5",
    "source_artifacts": [
      {
        "path": "src/smart/admin-activity/index.js",
