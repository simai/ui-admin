  "ai_guidance": {
    "use_when": "Use sf-admin-activity at the end of the crumbs row of an admin page and in the phone top line of sf-admin-shell (slot top-end), with the host's runs.",
    "do_not": [
      "Do not run the actions in the element; the host runs them",
      "Do not send percents as separate toasts: set runs anew and the element tells only the end",
      "Do not draw it when nothing runs: it draws nothing by itself"
    ],
    "required_reads": [
      "inputs",
      "contracts",
      "events",
      "accessibility"
    ],
    "minimal_example": "<sf-admin-activity history-href=\"/panel/activity\"></sf-admin-activity>",
    "owner_commands": [
      "node scripts/test.mjs",
      "node scripts/run-browser-probes.mjs <free> <set build>"
    ]
  }
}
