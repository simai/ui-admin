          "intent",
          "payload"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "intent": {
            "type": "string"
          },
          "payload": {
            "type": "object"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "site": {}
        },
        "additionalProperties": true
      },
      "canonical": true
    },
    "sf-admin-menu-open": {
