      "standard": "simai.composition.document.v1",
      "type": "smart.admin-menu",
      "mode": "leaf",
      "profiles": [
        "ui-layout"
      ],
      "props": [
        "template",
        "search-shortcut",
        "current",
        "expected-columns",
        "open",
        "aria-label"
      ],
      "presentation": {
        "views": [
          "default"
        ],
        "presets": [],
        "modifiers": []
      },
      "slots": {},
      "renderer": {
        "kind": "custom-element",
        "name": "sf-admin-menu"
      },
      "assets": [
        "smart/admin-menu"
      ],
      "data": {},
      "events": [
        "sf-admin-menu-query",
        "sf-admin-menu-reset",
        "sf-admin-menu-navigate",
        "sf-admin-menu-refresh",
        "sf-admin-menu-open",
        "sf-admin-menu-toggle",
        "sf-admin-menu-save",
        "sf-admin-menu-create",
        "sf-admin-menu-rename",
        "sf-admin-menu-delete",
