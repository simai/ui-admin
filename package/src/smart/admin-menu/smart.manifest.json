          "sf-admin-menu-intent -> sf-admin-menu-read until 2026-12-01 (event)",
          "sf-admin-menu-intent -> sf-admin-menu-reset until 2026-12-01 (event)",
          "sf-admin-menu-intent -> sf-admin-menu-sign-out until 2026-12-01 (event)",
          "sf-admin-menu-search -> sf-admin-menu-query until 2026-12-01 (event)",
