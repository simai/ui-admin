    "sf-host-port-request": {
      "summary": "Ask the page for a host port when connecting. A page that answers with simai.admin-navigation-port gets the menu; a page that answers nothing keeps its skeleton until it connects a port. Retired: the page hands the port with connectPort({port}); still sent until 2026-12-01.",
      "payload": {
        "type": "object",
        "required": [
          "component",
          "context"
        ],
        "properties": {
          "component": {
            "type": "object"
          },
          "context": {
            "type": "object",
            "required": [
              "owner",
              "record",
              "group"
            ],
            "properties": {
              "owner": {
                "type": "string",
                "const": "admin-menu"
              },
              "record": {
                "type": "null"
              },
              "group": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    "sf-admin-menu-intent": {
      "summary": "1.0: what a person asked of the host. Since 1.2.0 each intent is told by its verb (sf-admin-menu-refresh, -open, -toggle, -save, -query, -create, -rename, -delete, -read, -reset, -sign-out: {kind, ..., intent, payload}); this name follows each until 2026-12-01.",
