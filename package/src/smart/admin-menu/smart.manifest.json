        "revision_prop": null
      },
      "host_port": {
        "port": "simai.admin-navigation-port",
        "version": "1.1.0",
        "path": "src/core/contracts/ports/simai.admin-navigation-port/1.1.0/port.json",
        "sha256": "6280add7a969ea06ff92183b95bc845f2d3ffc0d959f742ca81b96e22623a324",
        "supported_versions": [
          "1.0.0",
          "1.1.0"
        ]
      }
    }
  },
  "inputs": {
    "type": "object",
    "required": [
      "aria-label"
    ],
    "properties": {
      "template": {
        "type": "string",
        "default": "default",
        "description": "Template variant name for SfBaseElement external templates.",
        "const": "default"
      },
      "root-class": {
        "type": "string",
        "default": "",
        "description": "Classes added to the root element the component draws."
      },
      "root-style": {
        "type": "string",
        "default": "",
        "description": "Inline style declarations set on the root element the component draws, custom properties included."
      },
      "search-shortcut": {
        "type": "string",
        "default": "mod+k",
        "description": "The key that opens the search from anywhere on the page; empty turns it off."
      },
      "current": {
        "type": "string",
        "default": "",
        "description": "The row the page is on, by its key; empty: the row whose address the page is at."
      },
      "expected-columns": {
        "type": "integer",
        "default": 2,
        "description": "How many columns the navigation skeleton draws on a wide screen before the host answers: 1 where the page's row has no open root (a dashboard), 2 where it has. The server knows which; with the right number the menu is as wide before the answer as after it. Never a limit: the answered menu takes the columns its rows need.",
        "minimum": 1,
        "maximum": 2
      },
      "open": {
        "type": "boolean",
        "default": false,
        "description": "Written by a page that opens the menu from its own button: on a narrow screen the menu is folded away while false (data-open). Not written: no change."
      },
      "aria-label": {
        "type": "string",
        "default": "Admin menu",
        "minLength": 1
      },
      "first-answer": {
        "type": "object",
        "description": "The host's first navigation.load answer printed with the page (the data-sf-settings island). The menu is drawn from it at once, with no skeleton; the port answers behind it."
      }
    },
    "additionalProperties": false
  },
  "item_contract": {},
  "contracts": {},
  "methods": {
    "refresh": {
      "summary": "Read the navigation menu again from its host, after something outside the menu changed what it shows (a star in the page header). No effect before a port.",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "A promise that settles when the host has answered."
      }
    },
    "toggle": {
      "summary": "Add a row to the person's favourites or take it out (favourite.toggle). Without a port it refuses.",
      "arguments": [
        {
          "name": "args",
          "type": "object",
          "required": true,
          "schema": {
            "type": "object",
            "properties": {
              "id": {},
              "on": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "on"
            ]
          }
        }
      ],
      "returns": {
        "type": "object",
        "description": "A promise of the outcome: applied, refused or unavailable."
      }
    },
    "showColumn": {
      "summary": "Show the section column again: the page's object menu or the root that holds the page (C321). With nothing for the column nothing opens. A page's «Показать колонку» calls it.",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "{outcome: applied, open} with whether the column is open after it; {outcome: refused, reason: no-port} before a navigation port."
      }
    },
    "hideColumn": {
      "summary": "Hide the section column; the rail stays and the column leaves no room (C321, AM-49).",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "{outcome: applied, open} with whether the column is open after it; {outcome: refused, reason: no-port} before a navigation port."
      }
    },
    "toggleColumn": {
      "summary": "Hide the column that is open or show the one that is hidden, as Ctrl/Cmd+B does (AM-36).",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "{outcome: applied, open} with whether the column is open after it; {outcome: refused, reason: no-port} before a navigation port."
      }
    },
    "setHostPort": {
      "summary": "Bind the host of simai.admin-navigation-port; the menu then draws the answered navigation instead of its skeleton.",
      "arguments": [
        {
          "name": "host",
          "type": "object",
          "required": true
        }
      ],
      "returns": {
        "type": "object",
        "description": "The outcome of connect-port, whose alias this is: {outcome: \"applied\"}, or refused with no-port, other-port or port-unsupported."
      }
    },
    "connectPort": {
      "summary": "The Framework's base action connect-port {port} (standard 1.3.8 §4.1, §4.9): hands the navigation port, kept as sfPort; answers an outcome (refused other-port for another port, port-unsupported for a version the menu does not take). setHostPort is its alias.",
      "arguments": [
        {
          "name": "port",
          "required": true,
          "schema": {
            "type": "object"
          }
        }
      ],
      "returns": {
        "type": "object"
      }
    }
  },
  "events": {
    "sf-admin-menu-query": {
      "summary": "a query: kind site or search (vocabulary 1.1.5).",
      "payload": {
        "type": "object",
        "required": [
          "kind",
          "query"
        ],
        "properties": {
          "kind": {
            "enum": [
              "site",
              "search"
            ]
          },
          "query": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "intent": {
            "type": "string"
          },
          "payload": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "sf-admin-menu-reset": {
      "summary": "kind view (vocabulary 1.1.5).",
