{
  "schema_version": 2,
  "id": "smart.admin-menu",
  "version": "1.15.0",
  "title": "Admin menu",
  "summary": "Admin navigation over the host's navigation port: the rail, the section column, search, favourites, notifications and the setting mode.",
  "kind": "composite",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "admin",
    "menu",
    "navigation",
    "settings"
  ],
  "capabilities": [
    "navigation",
    "search",
    "preferences",
    "responsive"
  ],
  "custom_element": "sf-admin-menu",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "component.admin-menu",
      "component.avatars",
      "component.badges",
      "component.icons",
      "component.inputs",
      "component.kbd",
      "smart.badge",
      "smart.button",
      "smart.button-icon",
      "smart.drawer",
      "smart.dropdown",
      "smart.empty-state",
      "smart.icon",
