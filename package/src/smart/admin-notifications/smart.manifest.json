  "ai_guidance": {
    "use_when": "Use sf-admin-notifications inside the notifications panel (sf-drawer size 2 on the right) and on the history page (look page) of an admin.",
    "do_not": [
      "Do not keep notifications in the element; the host keeps them",
      "Do not count unread in the page: the host answers unread",
      "Do not send markup in titles"
    ],
    "required_reads": [
      "inputs",
      "contracts",
      "events",
      "accessibility"
    ],
    "minimal_example": "<sf-admin-notifications history-href=\"/panel/notifications\"></sf-admin-notifications>",
    "owner_commands": [
      "node scripts/test.mjs",
      "node scripts/run-browser-probes.mjs <free> <set build>"
    ]
  }
}
