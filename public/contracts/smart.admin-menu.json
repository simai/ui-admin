  "ai_guidance": {
    "use_when": "Use the complete component for product admin navigation with search, nesting, badges, compact mode or editable preferences.",
    "do_not": [
      "Do not rebuild the menu from primitive SF tags",
      "Do not store Larena domain state in localStorage",
      "Do not let the browser decide access or routes"
    ],
    "required_reads": [
      "inputs",
      "events",
      "persistence",
      "ownership",
      "backend",
      "scenarios"
    ],
    "minimal_example": "<sf-admin-menu aria-label=\"Admin menu\" searchable collapsible persistence-mode=\"external\"></sf-admin-menu>"
  }
