{
  "schema_version": 2,
  "id": "smart.admin-menu",
  "version": "1.1.0",
  "title": "Admin menu",
  "summary": "Searchable nested admin navigation with compact mode and editable personal or system preferences.",
  "kind": "composite",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "admin",
    "menu",
    "navigation",
    "settings"
  ],
  "capabilities": [
    "navigation",
    "search",
    "nested-panels",
    "preferences",
    "responsive"
  ],
  "custom_element": "sf-admin-menu",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "component.admin-menu",
      "component.badges",
      "component.icons",
      "component.inputs",
      "smart.badges",
      "smart.buttons",
      "smart.context-menu",
      "smart.icon-buttons",
      "smart.icons",
      "smart.inputs"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "aria-label"
    ],
    "properties": {
      "template": {
        "type": "string",
        "const": "default",
        "default": "default"
      },
      "brand": {
        "type": "string",
        "default": ""
      },
      "logo": {
        "type": "string",
        "default": ""
      },
      "logo-href": {
        "type": "string",
        "default": "#"
      },
      "aria-label": {
        "type": "string",
        "minLength": 1,
        "default": "Admin menu"
      },
      "searchable": {
        "type": "boolean",
        "default": false
      },
      "collapsible": {
        "type": "boolean",
        "default": false
      },
      "settings": {
        "type": "boolean",
        "default": true
      },
      "settings-title": {
        "type": "string",
        "default": "Menu settings"
      },
      "compact": {
        "type": "boolean",
        "default": false
      },
      "persistence-mode": {
        "type": "string",
        "enum": [
          "local",
          "external"
        ],
        "default": "local"
      },
      "settings-mode": {
        "type": "string",
        "enum": [
          "user",
          "system"
        ],
        "default": "user"
      },
      "settings-revision": {
        "type": "integer",
        "minimum": 0,
        "default": 0
      },
      "system-settings-revision": {
        "type": "integer",
        "minimum": 0,
        "default": 0
      },
      "allow-system-settings": {
        "type": "boolean",
        "default": false
      },
      "search-placeholder": {
        "type": "string",
        "default": "Search sections"
      },
      "toggle-label": {
        "type": "string",
        "default": "Menu"
      },
      "panel-class": {
        "type": "string",
        "default": ""
      },
      "root-class": {
        "type": "string",
        "default": ""
      },
      "search-mode": {
        "type": "string",
        "enum": [
          "row",
          "panel"
        ],
        "default": "row",
        "description": "Where the search lives: a row under the header, or a panel opened from a magnifier in the header."
      },
      "search-label": {
        "type": "string",
        "default": "Search the admin (Ctrl+K)",
        "description": "Accessible name and tooltip of the magnifier that opens the search panel."
      },
      "search-shortcut": {
        "type": "string",
        "default": "mod+k",
        "description": "The key that opens the search from anywhere on the page; empty turns it off."
      },
      "search-hint": {
        "type": "string",
        "default": "",
        "description": "A short line shown under an empty query, when the host has one."
      },
      "search-keys-hint": {
        "type": "string",
        "default": "↑↓ select · Enter open · Esc close",
        "description": "The line of key hints at the bottom of the search panel."
      },
      "search-title": {
        "type": "string",
        "default": "",
        "description": "Heading shown above the search field in the navigation panel."
      }
    }
  },
  "item_contract": {
    "stable_id_attribute": "item-id",
    "package_owned": [
      "item-id",
      "label",
      "href",
      "icon",
      "badge",
      "access"
    ],
    "preference_fields": [
      "order",
      "hidden",
      "pinned"
    ],
    "supports": [
      "nested-items",
      "divider",
      "main-slot",
      "bottom-slot",
      "active",
      "current",
      "disabled"
    ]
  },
  "contracts": {
    "settings_profile": {
      "type": "object",
      "required": [
        "schema_version",
        "items",
        "layout"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "items": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "order": {
                "type": "number"
              },
              "hidden": {
                "type": "boolean"
              },
              "pinned": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "layout": {
          "type": "object",
          "properties": {
            "compact": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "methods": {
    "applyExternalSettingsState": {
      "summary": "Apply backend-resolved state and tree.",
      "arguments": [
        {
          "name": "state",
          "schema": {
            "type": "object"
          }
        },
        {
          "name": "target",
          "schema": {
            "enum": [
              "user",
              "system"
            ]
          }
        }
      ],
      "returns": {
        "type": "null"
      }
    },
    "applySettingsResult": {
      "summary": "Commit a successful external save response.",
      "arguments": [
        {
          "name": "result",
          "schema": {
            "type": "object"
          }
        }
      ],
      "returns": {
        "type": "null"
      }
    },
    "applySettingsError": {
      "summary": "Keep the draft and expose error or conflict state.",
      "arguments": [
        {
          "name": "error",
          "schema": {
            "type": "object"
          }
        }
      ],
      "returns": {
        "type": "null"
      }
    },
    "setCompact": {
      "summary": "Set compact navigation mode.",
      "arguments": [
        {
          "name": "compact",
          "schema": {
            "type": "boolean"
          }
        }
      ],
      "returns": {
        "type": "boolean"
      }
    },
    "toggleMenuSettings": {
      "summary": "Enter or leave the settings editor.",
      "arguments": [],
      "returns": {
        "type": "null"
      }
    }
  },
  "events": {
    "sf-admin-menu-compact-change": {
      "summary": "Notify the host shell about width mode.",
      "payload": {
        "type": "object",
        "required": [
          "compact",
          "source"
        ],
        "properties": {
          "compact": {
            "type": "boolean"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "sf-admin-menu-search": {
      "summary": "Runtime event sf-admin-menu-search.",
      "payload": {
        "type": "object"
      }
    },
    "sf-admin-menu-settings-cancel": {
      "summary": "Discard the local draft.",
      "payload": {
        "type": "object",
        "properties": {
          "target": {
            "enum": [
              "user",
              "system"
            ]
          }
        }
      }
    },
    "sf-admin-menu-settings-mode-change": {
      "summary": "Request state for another settings level.",
      "payload": {
        "type": "object",
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "enum": [
              "user",
              "system"
            ]
          }
        }
      }
    },
    "sf-admin-menu-settings-refresh": {
      "summary": "Request fresh backend state after a conflict.",
      "payload": {
        "type": "object",
        "required": [
          "target",
          "base_revision",
          "profile"
        ],
        "properties": {
          "target": {
            "enum": [
              "user",
              "system"
            ]
          },
          "base_revision": {
            "type": "integer",
            "minimum": 0
          },
          "profile": {
            "$ref": "#/contracts/settings_profile"
          }
        }
      }
    },
    "sf-admin-menu-settings-reset": {
      "summary": "Request reset of the selected preference level.",
      "payload": {
        "type": "object",
        "required": [
          "target",
          "base_revision"
        ],
        "properties": {
          "target": {
            "enum": [
              "user",
              "system"
            ]
          },
          "base_revision": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "sf-admin-menu-settings-save": {
      "summary": "Request persistence of the current delta.",
      "payload": {
        "type": "object",
        "required": [
          "target",
          "base_revision",
          "profile"
        ],
        "properties": {
          "target": {
            "enum": [
              "user",
              "system"
            ]
          },
          "base_revision": {
            "type": "integer",
            "minimum": 0
          },
          "profile": {
            "$ref": "#/contracts/settings_profile"
          }
        }
      }
    }
  },
  "state": {
    "machines": {
      "settings": [
        "idle",
        "saving",
        "success",
        "error",
        "conflict"
      ],
      "navigation": [
        "expanded",
        "compact",
        "nested",
        "searching"
      ]
    },
    "visual_states": [
      "loading",
      "empty",
      "saving",
      "success",
      "error",
      "conflict",
      "disabled",
      "compact",
      "nested",
      "mobile"
    ]
  },
  "persistence": {
    "mode": "hybrid",
    "source_of_truth": "host",
    "network_owner": "host",
    "revision_field": "base_revision"
  },
  "ownership": {
    "source": "simai/ui-source",
    "data": "host",
    "effects": "host",
    "forbidden_client_responsibilities": [
      "access decisions",
      "route discovery",
      "domain record semantics",
      "cross-user identity selection",
      "HTTP endpoint invention"
    ]
  },
  "backend": {
    "adapters": [
      "larena:ui.admin_menu"
    ],
    "integration_examples": {
      "larena_php": "Smart::render('ui.admin_menu', ['props' => $props]);",
      "event_bridge": "Register the generic Smart event bridge for save, reset, mode-change and refresh events."
    }
  },
  "security": {
    "permissions_owner": "host",
    "untrusted_inputs": [
      "Reject unknown item IDs",
      "Reject package-owned field mutations",
      "Treat labels, badges and URLs as untrusted render data"
    ],
    "network_policy": "host-only"
  },
  "accessibility": {
    "role": "navigation",
    "accessible_name": "required",
    "keyboard": [
      "Tab",
      "Enter",
      "Space",
      "Escape"
    ],
    "focus": "Context menus focus their first available native item after rendering. Escape returns to the native opener; Tab/Shift+Tab close and continue from the opener. Outside focus is preserved. If save/cancel removes the opener, abandoned body focus returns to the settings control or another available control in this Admin Menu. Shared portal ownership and stale callbacks are guarded. Popup geometry follows the native opener, including display-contents Smart hosts, LTR/RTL, responsive movement, content, font and viewport changes; --sf-context-menu-viewport-space derives from the spacing scale. Internal scrolling preserves the menu; outside document scrolling dismisses it. Search and nested drill-down layers make inactive panels inert. Opening a nested layer focuses its localized Back control; Back restores the corresponding tree trigger. Compact search focuses the revealed input. Search placement and directional chevrons follow LTR or RTL."
  },
  "presentation": {
    "themes": [
      "light",
      "dark"
    ],
    "locales": [
      "en",
      "ru"
    ],
    "responsive": [
      "desktop-expanded",
      "desktop-compact",
      "mobile-full-width",
      "viewport-bounded-context-menu"
    ]
  },
  "adapter": {
    "kind": "owner",
    "protocol": "simai.smart-studio-adapter.v1",
    "module": null
  },
