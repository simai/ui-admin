{
  "schema_version": 2,
  "id": "smart.alert",
  "version": "1.0.0",
  "title": "Alert",
  "summary": "Persistent inline notice with semantic roles, optional actions and dismiss behavior.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "alert"
  ],
  "capabilities": [
    "render",
    "theme",
    "responsive"
  ],
  "custom_element": "sf-alert",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "component.alerts",
      "component.buttons",
      "smart.icons",
      "smart.icon-buttons"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "properties": {
      "template": {
        "type": "string",
        "default": "default",
        "enum": [
          "default"
        ]
      },
      "status": {
        "type": "string",
        "default": "neutral",
        "enum": [
          "neutral",
          "info",
          "success",
          "warning",
          "error"
        ],
        "description": "What the alert reports, in the shared status vocabulary. The words this component used before — clear and danger — are still accepted and mean neutral and error."
      },
      "appearance": {
        "type": "string",
        "default": "default",
        "enum": [
          "default",
          "outlined",
          "flat"
        ],
        "description": "How the alert looks: a filled surface, an outline, or flat."
      },
      "icon": {
        "type": "string",
        "default": "",
        "description": "Optional icon override. Use none to hide the semantic icon."
      },
      "title": {
        "type": "string",
        "default": "",
        "description": "Short message heading."
      },
      "supporting-text": {
        "type": "string",
        "default": "",
        "description": "Supporting body text at the normal text size."
      },
      "action-text": {
        "type": "string",
        "default": "",
        "description": "Visible label of the primary optional action."
      },
      "action": {
        "type": "string",
        "default": "action",
        "description": "Stable action value emitted in sf-alert-action."
      },
      "secondary-action-text": {
        "type": "string",
        "default": "",
        "description": "Visible label of the secondary optional action."
      },
      "secondary-action": {
        "type": "string",
        "default": "secondary",
        "description": "Stable secondary action value emitted in sf-alert-action."
      },
      "closable": {
        "type": "boolean",
        "default": false,
        "description": "Render an explicitly named close action."
      },
      "close-label": {
        "type": "string",
        "default": "Close alert",
        "description": "Localized accessible name of the close action."
      },
      "root-class": {
        "type": "string",
        "default": ""
      },
      "type": {
        "type": "string",
        "default": "neutral",
        "description": "Legacy name for status, still honoured. See contracts/public-api-axes.json.",
        "enum": [
          "neutral",
          "info",
          "success",
          "warning",
          "error"
        ]
      },
      "variant": {
        "type": "string",
        "default": "default",
        "description": "Legacy name for appearance, still honoured. See contracts/public-api-axes.json.",
        "enum": [
          "default",
          "outlined",
          "flat"
        ]
      }
    },
    "additionalProperties": false
  },
  "item_contract": {},
  "contracts": {
    "semantic_types": {
      "type": "string",
      "enum": [
        "clear",
        "info",
        "danger",
        "warning",
        "success"
      ]
    },
    "surface_variants": {
      "type": "string",
      "enum": [
        "default",
        "outlined",
        "flat"
      ]
    },
    "canonical_behavior_attributes": {
      "type": "string",
      "enum": [
        "data-action",
        "data-close"
      ]
    },
    "dismissal_state": {
      "const": "closing"
    },
    "live_region_guidance": {
      "assertive": "role=alert only for a newly inserted urgent message",
      "polite": "role=status for a newly inserted non-urgent update",
      "static": "omit a live-region role when the notice is present on initial page load"
    }
  },
  "methods": {
    "close": {
      "summary": "Public runtime method close.",
      "arguments": [],
      "returns": {
        "type": [
          "object",
          "boolean",
          "null"
        ]
      }
    },
    "onAction": {
      "summary": "Public runtime method onAction.",
      "arguments": [],
      "returns": {
        "type": [
          "object",
          "boolean",
          "null"
