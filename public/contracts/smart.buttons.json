    "properties": {
      "template": {
        "type": "string",
        "default": "default",
        "description": "Template variant name for SfBaseElement external templates.",
        "enum": [
          "default"
        ]
      },
      "size": {
        "type": "string",
        "default": "1",
        "description": "Button size token.",
        "enum": [
          "1/3",
          "1/2",
          "1",
          "2",
          "3"
        ]
      },
      "appearance": {
        "type": "string",
        "default": "default",
        "description": "How the button looks. Surface and ghost read the neutral alpha ramp: surface keeps a faint fill and a border, ghost keeps nothing until it is hovered or focused.",
        "enum": [
          "default",
          "tonal",
          "outline",
          "link",
          "surface",
          "ghost"
        ]
      },
      "scheme": {
        "type": "string",
        "default": "primary",
        "description": "Which colour family the control takes. What the control is about is the status axis; a status set there wins over this.",
        "enum": [
          "primary",
          "secondary",
          "on-surface"
        ]
      },
      "status": {
        "type": "string",
        "default": "",
        "description": "What the control is about, in the shared status vocabulary. The only one a control paints today is `error`, the destructive one: a control that deletes, discards or cannot be undone.",
        "enum": [
          "",
          "error"
        ]
      },
      "text-position": {
        "type": "string",
        "default": "center"
      },
      "text": {
        "type": "string",
        "default": "",
        "description": "Visible button text when no text slot is provided."
      },
      "segment": {
        "type": "string",
        "default": ""
      },
      "icon": {
        "type": "string",
        "default": "",
        "description": "Single icon name shortcut.",
        "examples": [
          "home",
          "settings",
          "search",
          "edit",
          "check",
          "close"
        ]
      },
      "icon-start": {
        "type": "string",
        "default": "",
        "description": "Logical start icon name.",
        "examples": [
          "home",
          "settings",
          "search",
          "edit",
          "check",
          "close"
        ]
      },
      "icon-end": {
        "type": "string",
        "default": "",
        "description": "Logical end icon name.",
        "examples": [
          "home",
          "settings",
          "search",
          "edit",
          "check",
          "close"
        ]
      },
      "icon-left": {
        "type": "string",
        "default": "",
        "description": "Compatibility alias for icon-start.",
        "examples": [
          "home",
          "settings",
          "search",
          "edit",
          "check",
          "close"
        ]
      },
      "icon-right": {
        "type": "string",
        "default": "",
        "description": "Compatibility alias for icon-end.",
        "examples": [
          "home",
          "settings",
          "search",
          "edit",
          "check",
          "close"
        ]
      },
      "icon-position": {
        "type": "string",
        "default": "start",
        "description": "Placement for the single icon shortcut.",
        "enum": [
          "start",
          "end"
        ]
      },
      "spacing": {
        "type": "string",
        "default": "normal",
        "description": "Semantic internal spacing profile.",
        "enum": [
          "compact",
          "normal",
          "comfortable",
          "spacious"
        ]
      },
      "tightness": {
        "type": "string",
        "default": "",
        "description": "Compatibility alias for spacing.",
        "enum": [
          "",
          "low",
          "high",
          "highest"
        ]
      },
      "radius": {
        "type": "string",
        "default": "",
        "description": "Border radius modifier.",
        "enum": [
          "",
          "default",
          "square",
          "rounded"
        ]
      },
      "root-class": {
        "type": "string",
        "default": "",
        "description": "Extra classes applied to the inner button element."
      },
      "loading": {
        "type": "boolean",
        "default": false,
        "description": "Loading state flag."
      },
      "disabled": {
        "type": "boolean",
        "default": false,
        "description": "Disabled state flag."
      },
      "native-type": {
        "type": "string",
        "default": "button",
        "description": "Native button type attribute.",
        "enum": [
          "button",
          "submit",
          "reset"
        ]
      },
      "aria-label": {
        "type": "string",
        "default": "",
        "description": "Accessible label for icon-only or custom buttons."
      },
      "type": {
        "type": "string",
        "default": "default",
        "description": "Legacy name for appearance, still honoured. See contracts/public-api-axes.json.",
        "enum": [
          "default",
          "tonal",
          "outline",
          "link",
          "surface",
          "ghost"
        ]
      }
