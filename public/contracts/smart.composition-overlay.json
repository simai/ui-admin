{
  "schema_version": 2,
  "id": "smart.composition-overlay",
  "version": "1.2.2",
  "title": "Composition overlay",
  "summary": "Editor chrome over a rendered Composition Document: frames, labels, badges, action toolbar, insertion places, drag and keyboard moves and a keyboard tree, without changing the canvas HTML. A framed mode draws the same chrome over a same-origin iframe fed a flat node list, with plain-string inline editing.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "composition",
    "editor",
    "overlay"
  ],
  "capabilities": [
    "interaction",
    "keyboard",
    "responsive",
    "theme"
  ],
  "custom_element": "sf-composition-overlay",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "smart.sortable"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "properties": {
      "for": {
        "type": "string",
        "default": "",
        "description": "id of the canvas element that holds SF.Composition.render output"
      },
      "accepts": {
        "type": "string",
        "default": "",
        "description": "sf-sortable groups whose items may be dropped on insertion places"
      },
      "label": {
        "type": "string",
        "default": ""
      },
      "frame": {
        "type": "string",
        "default": "",
        "description": "id of a same-origin iframe canvas (framed mode, fed by setNodes); used instead of for"
      },
      "actions": {
        "type": "array",
        "default": []
      }
    },
    "additionalProperties": false
  },
  "item_contract": {},
  "contracts": {
    "canvas": {
      "type": "object",
      "description": "The canvas holds host-rendered Composition HTML with data-sf-composition-id; the overlay never writes into it, so published HTML and digests are identical with the editor open or closed. Place the overlay before the canvas so its tree comes first in Tab order."
    },
    "actions": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "label": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "browser_api": {
      "type": "object",
      "description": "Once loaded, SF.CompositionOverlay exposes OVERLAY_EVENTS, overlayNodes(document), checkOverlayActions(actions) and checkOverlayNodes(nodes)."
    },
    "frame_canvas": {
      "type": "object",
      "description": "Framed mode: the canvas is a same-origin iframe (sandbox allow-same-origin is enough; the frame needs no script). The overlay reads the frame's document, listens to its pointer, key, scroll and resize events and maps frame coordinates to the host through the iframe's position, border, padding, transform or zoom and the frame's scroll. It writes nothing into the frame except a temporary contenteditable on the element being edited. A frame that reloads (srcdoc) is listened to again on load; the host then calls setNodes with the new document's elements."
    },
    "nodes": {
      "type": "array",
      "description": "Framed mode's flat node list, in selection order. element is a node inside the frame document; rect is in frame-document coordinates (viewport box plus the frame's scroll). parent names another node of the list (siblings share a parent; the top level has none). editable allows plain-string inline editing of the element.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "rect": {
            "type": "object",
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number",
                "minimum": 0
              },
              "height": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "element": {
            "type": "object",
            "description": "Element of the frame document"
          },
          "label": {
            "type": "string"
          },
          "parent": {
            "type": [
              "string",
              "null"
            ]
          },
          "editable": {
            "type": "boolean",
            "description": "Requires element"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "methods": {
    "attach": {
      "summary": "Binds the overlay to a canvas element.",
      "arguments": [
        {
          "name": "canvas",
          "type": "Element"
        }
      ],
      "returns": {
        "type": [
          "object",
          "boolean",
          "null"
        ]
      }
    },
    "attachFrame": {
      "summary": "Binds the overlay to a same-origin iframe canvas (framed mode).",
      "arguments": [
        {
          "name": "iframe",
          "type": "Element"
        }
      ],
      "returns": {
        "type": [
          "object",
          "boolean",
          "null"
        ]
      }
    },
    "setDocument": {
      "summary": "Sets the Document and describe(node) → {label, badges}.",
      "arguments": [
        {
          "name": "document",
          "type": "object"
        },
        {
          "name": "options",
          "type": "object"
        }
      ],
      "returns": {
        "type": [
          "object",
          "boolean",
          "null"
        ]
      }
    },
    "setNodes": {
      "summary": "Sets the framed canvas's flat node list and an optional describe(node) → {label, badges}.",
      "arguments": [
        {
          "name": "nodes",
          "type": "array"
        },
        {
          "name": "options",
          "type": "object"
        }
      ],
      "returns": {
        "type": [
          "object",
          "boolean",
          "null"
        ]
      }
    },
    "setActions": {
      "summary": "Sets toolbar actions {id, label}.",
      "arguments": [
        {
          "name": "actions",
          "type": "array"
        }
      ],
      "returns": {
        "type": [
          "object",
          "boolean",
          "null"
        ]
      }
    },
    "setMessages": {
      "summary": "Overrides interface texts.",
      "arguments": [
        {
          "name": "messages",
          "type": "object"
        }
      ],
      "returns": {
        "type": [
          "object",
          "boolean",
          "null"
        ]
      }
    },
    "setDropFilter": {
      "summary": "Hides drop places the host would refuse: (place, item) => boolean.",
      "arguments": [
        {
          "name": "filter",
          "type": "function"
        }
      ],
      "returns": {
        "type": [
          "object",
          "boolean",
          "null"
        ]
      }
    },
    "setInsertionTarget": {
      "summary": "Marks an insertion place or clears it with null.",
      "arguments": [
        {
          "name": "target",
          "type": [
            "object",
            "null"
          ]
        }
      ],
      "returns": {
        "type": [
          "object",
          "boolean",
          "null"
        ]
      }
    },
    "select": {
      "summary": "Selects a node by id.",
      "arguments": [
        {
          "name": "id",
          "type": [
            "string",
            "null"
          ]
        },
        {
          "name": "options",
          "type": "object"
        }
      ],
      "returns": {
        "type": [
          "object",
          "boolean",
          "null"
        ]
      }
    },
    "edit": {
      "summary": "Starts plain-string inline editing of an editable node in the frame; returns whether it started.",
      "arguments": [
        {
          "name": "id",
          "type": "string"
        }
      ],
      "returns": {
        "type": "boolean"
      }
    },
    "refresh": {
      "summary": "Measures again on the next frame, after a change no observer reports (a transform on an ancestor).",
      "arguments": [],
      "returns": {
        "type": [
          "object",
          "boolean",
          "null"
        ]
      }
    }
  },
  "events": {
    "sf-composition-overlay-apply": {
      "summary": "A toolbar action was chosen for the selected node: {action, scope: entry, ids} (vocabulary apply). The host performs it.",
      "payload": {
        "type": "object",
        "required": [
          "action",
          "scope",
          "ids"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": [
              "entry"
            ]
          },
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "sf-composition-overlay-change": {
      "summary": "A plain-string edit was committed: {id, value, previous}; cancelable, a cancelled change puts the text back.",
      "payload": {
        "type": "object",
        "required": [
          "id",
          "value",
          "previous"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "previous": {
            "type": "string"
          }
        }
      }
    },
    "sf-composition-overlay-select": {
      "summary": "A node was selected.",
      "payload": {
        "type": "object",
        "properties": {
          "node_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "sf-composition-overlay-action": {
      "summary": "Dated alias of sf-composition-overlay-apply until 2026-12-01: A toolbar action was chosen.",
      "payload": {
        "type": "object",
        "required": [
          "action_id",
          "node_id"
        ],
        "properties": {
          "action_id": {
            "type": "string"
          },
          "node_id": {
            "type": "string"
          }
        }
      }
    },
    "sf-composition-overlay-insert": {
      "summary": "Insertion was requested at a place, optionally with a library item. In framed mode the top-level list is parent_id \"\" and slot is \"default\".",
      "payload": {
        "type": "object",
        "required": [
          "parent_id",
          "slot",
          "index"
        ],
        "properties": {
          "parent_id": {
            "type": "string"
          },
          "slot": {
            "type": "string"
          },
          "index": {
            "type": "integer"
          },
          "item": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "move",
              "copy"
            ]
          }
        }
      }
    },
    "sf-composition-overlay-move": {
      "summary": "A canvas node was moved to a place.",
      "payload": {
        "type": "object",
        "required": [
          "node_id",
          "parent_id",
          "slot",
          "index"
        ],
        "properties": {
          "node_id": {
            "type": "string"
          },
          "parent_id": {
            "type": "string"
          },
          "slot": {
            "type": "string"
          },
          "index": {
            "type": "integer"
          }
        }
      }
    },
    "sf-composition-overlay-edit": {
      "summary": "Dated alias of sf-composition-overlay-change until 2026-12-01: A plain-string inline edit was committed with a changed value (framed mode). Cancelable: preventDefault puts the previous text back.",
      "payload": {
        "type": "object",
        "required": [
          "node_id",
          "value",
          "previous"
        ],
        "properties": {
          "node_id": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "previous": {
            "type": "string"
          }
        }
      }
    }
  },
  "state": {
    "machines": {
      "move": [
        "idle",
        "picking",
        "dropped",
        "cancelled"
      ],
      "edit": [
        "idle",
        "editing",
        "committed",
        "cancelled"
      ]
    },
    "visual_states": [
      "default",
      "selected",
      "active"
    ]
  },
  "persistence": {
    "mode": "none",
    "source_of_truth": "host",
    "network_owner": "none",
    "revision_field": null
  },
  "ownership": {
    "source": "simai/ui-source",
    "data": "host",
    "effects": "host",
    "forbidden_client_responsibilities": [
      "backend access decisions",
      "host route invention",
      "saving or reordering host data"
    ]
  },
  "security": {
    "permissions_owner": "host",
    "untrusted_inputs": [
      "props",
      "children"
    ],
    "network_policy": "deny"
  },
  "accessibility": {
    "role": "tree",
    "accessible_name": "recommended",
    "keyboard": [
      "ArrowUp",
      "ArrowDown",
      "ArrowLeft",
      "ArrowRight",
      "Home",
      "End",
      "Enter",
      "Space",
      "Escape"
    ],
    "focus": "The tree has one treeitem per node; arrows move in document order and between parent and child, Enter opens the toolbar, Escape returns or clears. Space starts a keyboard move, arrows choose a place, Enter drops, Escape cancels. Selection and moves are announced. In framed mode the tree follows the node list order, pointer and keys inside the frame select too, Enter on an editable node starts plain-text editing in the frame (Enter commits, Escape cancels, focus returns to the tree), and Escape gives way to an inner open surface."
  },
  "presentation": {
    "themes": [
      "light",
      "dark"
    ],
    "locales": [
      "ru",
      "en"
    ],
    "responsive": [
      "desktop",
      "mobile",
      "ltr",
      "rtl",
      "reduced-motion"
    ],
    "skeleton": {
      "shape": "none",
      "while_loading": "none"
    }
  },
  "adapter": {
    "kind": "generic",
    "protocol": "simai.smart-studio-adapter.v1",
    "module": null
  },
  "artifacts": {
    "fixtures": [
      "studio.fixture.json"
    ],
    "scenarios": [
      "studio.scenario.json"
    ]
  },
  "readiness": {
    "level": "runnable",
    "required_checks": [
      "manifest",
      "fixture",
      "runtime-upgrade",
      "scenario-smoke",
      "keyboard",
      "responsive",
      "a11y"
    ]
  },
  "compatibility": {
    "contract_schema": {
      "id": "https://simai.io/contracts/smart-component-manifest.v2.schema.json",
      "version": 2
    },
    "runtime_pair": {
      "ui_revision": "094f3d549aa7921d2d7f8773972c73711dd6a72e",
      "ui_smart_revision": "856fb5d751fad1c76104c32515f4c1869dd75b6c"
    },
    "aliases": [],
    "deprecations": [],
    "replacement": null,
    "migrations": []
  },
