  "ai_guidance": {
    "use_when": "Use sf-composition-overlay on an editor page over SF.Composition.render output. Treat every event as intent: the host changes the Document, saves it with an expected revision, validates and re-renders. For a canvas isolated in a same-origin iframe (a mail letter), use attachFrame (or frame=\"id\") and setNodes with a flat node list; edits arrive as sf-composition-overlay-edit.",
    "do_not": [
      "Do not copy generated ui-smart code",
      "Do not write editor markup into the canvas HTML",
      "Do not treat setDropFilter as validation; Document validation stays authoritative",
      "Do not put the overlay after the canvas in Tab order",
      "Do not expect the overlay to keep an edited text: it raises the intent, the host updates its model and re-renders the frame",
      "Do not point the framed mode at a cross-origin frame"
    ],
    "required_reads": [
      "inputs",
      "contracts",
      "methods",
      "events",
      "ownership",
      "provenance"
    ],
    "minimal_example": "<sf-composition-overlay id=\"overlay\" for=\"canvas\" accepts=\"blocks\"></sf-composition-overlay><div id=\"canvas\"></div>",
    "owner_commands": [
      "npm run contract:verify",
      "npm test"
    ]
  }
}
