  "ai_guidance": {
    "use_when": "Use sf-context-menu for a short action surface. Prefer logical position values so the tail mirrors in RTL. The surface uses --sf-radius--surface; long host-bounded content scrolls without clipping the tail, while forced-colors boundaries remain visible.",
    "do_not": [
      "Do not copy generated ui-smart code",
      "Do not move host data or access decisions into the component",
      "Do not treat position as an anchor or viewport placement engine; the opening host owns placement, zoom and soft-keyboard reactions",
