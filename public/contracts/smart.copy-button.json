  },
  "ai_guidance": {
    "use_when": "Use sf-copy-button to copy an identifier, a key, a command or a code block, naming each button by what it copies.",
    "do_not": [
      "Do not copy generated ui-smart code",
      "Do not leave several icon-only copy buttons named only «Копировать»"
    ],
    "required_reads": [
      "inputs",
      "events",
      "accessibility",
      "provenance"
    ],
    "minimal_example": "<sf-copy-button value=\"npm i @simai/ui\" label=\"Скопировать команду\"></sf-copy-button>",
    "owner_commands": [
      "npm run contract:verify",
      "npm test"
    ]
  }
}
