{
  "schema_version": 2,
  "id": "smart.copy-button",
  "version": "1.1.2",
  "title": "Copy button",
  "summary": "Copies a value or a target's text, confirms with a check and a polite announcement, and selects the text for Ctrl+C when the browser refuses the clipboard.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "copy",
    "clipboard",
    "button"
  ],
  "capabilities": [
    "interaction",
    "keyboard",
    "responsive"
  ],
  "custom_element": "sf-copy-button",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "smart.button",
      "smart.icon-button",
      "smart.icon"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "properties": {
      "value": {
        "type": "string",
        "default": "",
        "description": "The text to copy."
      },
      "target": {
        "type": "string",
        "default": "",
        "description": "#id of an input (its value) or an element (its text; a numbered code block without its numbers). value and target together are an error."
      },
      "text": {
        "type": "string",
        "default": "",
        "description": "A visible label; empty draws an icon-only button."
      },
      "label": {
        "type": "string",
        "default": "",
        "description": "The accessible name, saying what is copied («Скопировать команду»); «Копировать» / Copy by default."
      },
      "size": {
        "type": "string",
        "enum": [
          "1/3",
          "1/2",
          "1",
          "2"
        ],
        "default": "1/2"
      },
      "appearance": {
        "type": "string",
        "enum": [
          "link",
          "ghost",
          "outline",
          "tonal"
        ],
        "default": "link"
      },
      "icon": {
        "type": "string",
        "default": "content_copy",
        "description": "The resting glyph: link, key, ..."
      },
      "success-icon": {
        "type": "string",
        "default": "check"
      },
      "success-text": {
        "type": "string",
        "default": ""
      },
      "error-text": {
        "type": "string",
        "default": ""
      },
      "duration": {
        "type": "string",
        "default": "2000",
        "description": "Milliseconds the result stays."
      },
      "root-class": {
        "type": "string",
        "default": ""
      },
      "template": {
        "type": "string",
        "default": "default"
      }
    },
    "additionalProperties": false
  },
  "contracts": {},
  "methods": {
    "copy": {
      "summary": "Copies as a press would; a press while a copy is in flight is ignored.",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "A promise of {text, method}, or null on failure."
      }
    }
  },
  "events": {
    "sf-copy": {
      "summary": "The value was copied.",
      "payload": {
        "type": "object",
        "required": [
          "text",
          "method"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "method": {
            "enum": [
              "native",
              "legacy"
            ]
          }
        }
      }
    },
    "sf-copy-error": {
      "summary": "The value was not copied; on denied the text was selected for Ctrl+C.",
      "payload": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "enum": [
              "empty_source",
              "missing_target",
              "ambiguous_source",
              "denied"
            ]
          }
        }
      }
    }
  },
  "state": {
    "machines": {
      "copy": [
        "idle",
        "pending",
        "success",
        "error"
      ]
    },
    "visual_states": [
      "default",
      "success",
      "error"
    ]
  },
  "persistence": {
    "mode": "none",
    "source_of_truth": "host",
    "network_owner": "none",
    "revision_field": null
  },
  "ownership": {
    "source": "simai/ui-source",
    "data": "host",
    "effects": "host",
    "forbidden_client_responsibilities": [
      "backend access decisions",
      "saving the width on a server"
    ]
  },
  "security": {
    "permissions_owner": "host",
    "untrusted_inputs": [
      "props",
      "children"
    ],
    "network_policy": "deny"
  },
  "accessibility": {
    "role": "button",
    "accessible_name": "recommended",
    "keyboard": [
      "Enter",
      "Space"
    ],
    "focus": "An ordinary button named by label (what is copied); the result is announced in a polite status; a refused clipboard selects the text and says to press Ctrl+C (⌘C on macOS)."
  },
  "presentation": {
    "themes": [
      "light",
      "dark"
    ],
    "locales": [
      "ru",
      "en"
    ],
    "responsive": [
      "desktop",
      "mobile",
      "ltr",
      "rtl",
      "reduced-motion"
    ],
    "skeleton": {
      "shape": "none",
      "while_loading": "none"
    }
  },
  "adapter": {
    "kind": "generic",
    "protocol": "simai.smart-studio-adapter.v1",
    "module": null
  },
  "artifacts": {
    "fixtures": [
      "studio.fixture.json"
    ],
    "scenarios": [
      "studio.scenario.json"
    ]
  },
  "readiness": {
    "level": "runnable",
    "required_checks": [
      "manifest",
      "fixture",
      "runtime-upgrade",
      "scenario-smoke",
      "keyboard",
      "responsive",
      "a11y"
    ]
  },
  "compatibility": {
    "contract_schema": {
      "id": "https://simai.io/contracts/smart-component-manifest.v2.schema.json",
      "version": 2
    },
    "runtime_pair": {
      "ui_revision": "094f3d549aa7921d2d7f8773972c73711dd6a72e",
      "ui_smart_revision": "856fb5d751fad1c76104c32515f4c1869dd75b6c"
    },
    "aliases": [],
    "deprecations": [],
    "replacement": null,
    "migrations": []
  },
  "provenance": {
    "source_repository": "simai/ui-source",
    "source_revision": "b26e52222c029f1caa6258d719d93b101a2d3b5d",
    "source_artifacts": [
      {
        "path": "src/smart/copy-button/index.js",
        "sha256": "ec00682b3d19f218ba050a4c7518db55195d86d6b3d0b958e1d3a232ab8c4906"
      },
      {
        "path": "src/smart/copy-button/js/templates/default.js",
        "sha256": "58a760eef42f4016576a0252b021b0329d97a75a93ea7bb9c17460b7a831309e"
      },
      {
        "path": "src/smart/copy-button/scss/_smart__copy_button.scss",
        "sha256": "9bfe86eb0f4f8d7b8309cfddd4d3a527d70b1a86be1651f33c7aaa5451b07039"
      },
      {
        "path": "src/smart/copy-button/rule.js",
        "sha256": "db0a8b24387169ab2c222755d2d375e2cebe5e8d96d88227715d2d871a9c1ac9"
