  "ai_guidance": {
    "use_when": "Use the whole Data View for an admin collection that needs server search, filters, table preferences, actions or pagination.",
    "do_not": [
      "Do not rebuild the toolbar, table and pagination from unrelated primitives",
      "Do not let the browser own query or access semantics",
      "Do not send arbitrary field, operator, route or action identifiers to the backend"
    ],
    "required_reads": [
      "contracts",
      "events",
      "persistence",
      "ownership",
      "backend",
      "scenarios"
    ],
    "minimal_example": "<sf-table aria-label=\"Записи\" table-settings-key=\"package.records\"></sf-table>"
  }
}
