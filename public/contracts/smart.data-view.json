{
  "schema_version": 2,
  "id": "smart.data-view",
  "version": "1.9.0",
  "title": "Data view",
  "summary": "Complete server-backed collection view with search, filters, table preferences, row and bulk actions, and pagination.",
  "kind": "composite",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "admin",
    "collection",
    "data",
    "filter",
    "table"
  ],
  "capabilities": [
    "data-view",
    "search",
    "filtering",
    "sorting",
    "selection",
    "preferences",
    "pagination",
    "responsive"
  ],
  "custom_element": "sf-table",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "smart.avatar",
      "smart.badges",
      "smart.buttons",
      "smart.checkbox",
      "smart.context-menu",
      "smart.datepicker",
      "smart.dropdown",
      "smart.icon-buttons",
      "smart.inputs",
      "smart.list-item",
      "smart.modal",
      "smart.pagination",
      "smart.range-slider",
      "smart.spinner",
      "smart.tags"
    ],
    "public_parts": [],
    "declarative": {
      "standard": "simai.composition.document.v1",
      "type": "smart.data-view",
      "mode": "leaf",
      "profiles": [
        "ui-layout"
      ],
      "props": [
        "aria-label",
        "table-settings-key",
        "selectable",
        "toolbar",
        "settings",
        "actions",
        "row-actions",
        "pagin",
        "pagination-total",
        "pagination-page-size",
        "page-sizes",
        "filter-text",
        "clear-text",
        "search-placeholder",
        "create-text",
        "loading-text",
        "empty-text",
        "error-text",
        "retry-text",
        "context-menu-columns",
        "data-state"
      ],
      "data": {
        "columns": {
          "contract": "columns"
        },
        "rows": {
          "contract": "rows"
        }
      },
      "events": [
        "sf-table-search-change",
        "sf-table-filter-change",
        "sf-table-sort-change",
        "sf-table-create-intent",
        "sf-table-template-save",
        "sf-table-template-select",
        "sf-table-template-delete",
        "sf-table-column-settings-change",
        "sf-table-action-intent",
        "sf-table-query-intent",
        "sf-table-retry",
        "sf-table-toolbar-action"
      ],
      "persistence": {
        "settings_key_prop": "table-settings-key",
        "revision_prop": null
      },
      "presentation": {
        "views": [
          "default"
        ],
        "presets": [],
        "modifiers": []
      },
      "slots": {},
      "renderer": {
        "kind": "custom-element",
        "name": "sf-table"
      },
      "assets": [
        "smart/table"
      ],
      "host_port": {
        "port": "simai.dataview-port",
        "version": "1.0.0",
        "path": "src/smart/table/port/1.0.0/port.json",
        "sha256": "208db0e9709639c46f25830cac255f35d7d8c50ea4dfb1c578adc0055798c46e",
        "supported_versions": [
          "1.0.0"
        ]
      }
    }
  },
  "inputs": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "aria-label",
      "table-settings-key"
    ],
    "properties": {
      "template": {
        "type": "string",
        "const": "default",
        "default": "default"
      },
      "aria-label": {
        "type": "string",
        "minLength": 1,
        "default": "Data table",
        "description": "The table's accessible name. Read it from the props context and never from the element: `aria-label` is reflected by the platform, so element.ariaLabel returns null with no attribute set and shadows what the component resolves. Whether an English default belongs in a family whose other fourteen text inputs default to Russian is the owner's open question about the Framework's default language."
      },
      "selectable": {
        "type": "boolean",
        "default": true
      },
      "settings": {
        "type": "boolean",
        "default": true
      },
      "actions": {
        "type": "boolean",
        "default": true
      },
      "row-actions": {
        "type": "boolean",
        "default": true
      },
      "pagin": {
        "type": "boolean",
        "default": false
      },
      "filter-text": {
        "type": "string",
        "default": "Filter"
      },
      "clear-text": {
        "type": "string",
        "default": "Clear"
      },
      "search-placeholder": {
        "type": "string",
        "default": "Search"
      },
      "create-text": {
        "type": "string",
        "default": "Create"
      },
      "pagination-total": {
        "type": "integer",
        "minimum": 0,
        "default": 10
      },
      "pagination-page-size": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 10
      },
      "page-sizes": {
        "type": "string",
        "default": "10,20,30,40"
      },
      "context-menu-columns": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4,
        "default": 1,
        "description": "How many columns the settings menu splits its items into. One until a host asks for more: the read was bare for the whole life of this input, so neither its declared default nor a value a host passed ever reached the menu."
      },
      "table-settings-key": {
        "type": "string",
        "minLength": 1,
        "default": "",
        "description": "Which stored settings this table uses. Empty means the element's own id, and then its instance id, so each table on a page keeps its own. A real default here would make every table share one key and overwrite the others."
      },
      "data-state": {
        "type": "string",
        "enum": [
          "auto",
          "loading",
          "populated",
          "empty",
          "error"
        ],
        "default": "auto"
      },
      "loading-text": {
        "type": "string",
        "default": "Loading"
      },
      "empty-text": {
        "type": "string",
        "default": "No data"
      },
      "error-text": {
        "type": "string",
        "default": "The data could not be loaded"
      },
      "retry-text": {
        "type": "string",
        "default": "Try again"
      },
      "toolbar": {
        "type": "boolean",
        "default": true,
        "description": "Show the built-in toolbar; a composite can provide its own toolbar slot."
      },
      "pin-column-label": {
        "type": "string",
        "default": "Pin the column",
        "description": "Accessible name and tooltip of the control that pins a column."
      },
      "unpin-column-label": {
        "type": "string",
        "default": "Unpin the column",
        "description": "Accessible name and tooltip of the control that unpins a column."
      },
      "column-move-label": {
        "type": "string",
        "default": "Move the column",
        "description": "Accessible name of the handle that moves a column in the settings list; the column label is appended to it."
      },
      "column-search-placeholder": {
        "type": "string",
        "default": "Search the fields",
        "description": "Placeholder and accessible name of the search field above the column settings list."
      },
      "column-search-empty-text": {
        "type": "string",
        "default": "No field matches",
        "description": "Shown in place of the column settings list when the search matches no field."
      },
      "vertical-scroll": {
        "type": "string",
        "default": "self",
        "description": "Whether the table scrolls within itself or lets the page scroll. Declared as a string with two values; the manifest previously said boolean true, which was wrong in both the type and the default.",
        "enum": [
          "self",
          "page"
        ]
      },
      "filter-apply-text": {
        "type": "string",
        "default": "Apply the filter",
        "description": "Label of the filter window’s commit button; the number of conditions a press would change is appended to it while a draft is pending."
      }
    }
  },
  "item_contract": {
    "stable_id_attribute": "row.id",
    "package_owned": [
      "columns[].key",
      "columns[].label",
      "filter_fields[].key",
      "filter_fields[].operators",
      "actions[].id"
    ],
    "preference_fields": [
      "column_settings.*.order",
      "column_settings.*.width",
      "column_settings.*.visible",
      "column_settings.*.pinned",
      "query.page_size"
    ],
    "supports": [
      "structured-cells",
      "row-selection",
      "bulk-selection",
      "column-resize",
      "column-reorder",
      "column-visibility",
      "filter-templates",
      "row-actions"
    ]
  },
  "contracts": {
    "query_intent": {
      "type": "object",
      "required": [
        "search",
        "filters",
        "sort",
        "page",
        "page_size"
      ],
      "properties": {
        "search": {
          "type": "string"
        },
        "filters": {
          "type": "object"
        },
        "sort": {
          "type": "array"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "column_settings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "order": {
            "type": "number"
          },
          "width": {
            "type": "string"
          },
          "visible": {
            "type": "boolean"
          },
          "pinned": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "action_intent": {
      "type": "object",
      "required": [
        "action_id",
        "record_ids"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "record_ids": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "integer"
            ],
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "query_context": {
      "type": "object",
      "required": [
        "record_ids"
      ],
      "properties": {
        "record_ids": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": [
              "string",
              "integer"
            ],
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "additionalProperties": false
    },
    "composition_ports": {
      "manifest": "simai.composition.port-manifest.v1",
      "element": "sf-table",
      "version": "1.0.0",
      "outputs": {
        "selection": "record-ids.v1"
      },
      "inputs": {
        "context": "record-ids.v1"
      }
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "visible": {
            "type": "boolean"
          },
          "order": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "width": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "colWidth": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "size": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "minWidth": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "maxWidth": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "sortable": {
            "type": "boolean"
          },
          "resizable": {
            "type": "boolean"
          },
          "draggable": {
            "type": "boolean"
          },
          "renderer": {
            "enum": [
              "link"
            ]
          },
          "system": {
            "type": "boolean"
          },
          "component": {
            "type": "object"
          },
          "rowComponent": {
            "type": "object"
          }
        }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": [
              "string",
              "integer"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "methods": {
    "addRows": {
      "summary": "Append another backend page for show-more mode.",
      "arguments": [
        {
          "name": "rows",
          "schema": {
            "type": "array"
          }
        }
      ],
      "returns": {
        "type": "object"
      }
    },
    "applyQueryResult": {
      "summary": "Apply rows answering the newest pending context query. Returns false and changes nothing for a stale, repeated or unknown sequence.",
      "arguments": [
        {
          "name": "sequence",
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        },
        {
          "name": "rows",
          "schema": {
            "type": "array"
          }
        }
      ],
      "returns": {
        "type": "boolean"
      }
    },
    "clearSelection": {
      "summary": "Clear the explicit selection of this instance; emits the selection port once when it changes.",
      "arguments": [],
      "returns": {
        "type": "object"
      }
    },
    "getActiveFilterFieldKeys": {
      "summary": "Which filter fields the filter is showing, in the host's field order.",
      "arguments": [],
      "returns": {
        "type": "array"
      }
    },
    "getColumnSettings": {
      "summary": "Read the current column-preference delta.",
      "arguments": [],
      "returns": {
        "type": "object"
      }
    },
    "getFilterPayload": {
      "summary": "Read the current filter draft for host-side query validation.",
      "arguments": [],
      "returns": {
        "type": "object"
      }
    },
    "getInstanceId": {
      "summary": "Identity of this instance: the author's id when there is one, an own counter otherwise. Ids, the settings key fallback and the portal derive from it.",
      "arguments": [],
      "returns": {
        "type": "string"
      }
    },
    "getQueryContext": {
      "summary": "Read the immutable context last received through the context input port, or null.",
      "arguments": [],
      "returns": {
        "type": [
          "object",
          "null"
        ]
      }
    },
    "getSelectedRecordIds": {
      "summary": "Read the typed record identities selected in this table result, without DOM parsing.",
      "arguments": [],
      "returns": {
        "type": "array",
        "items": {
          "type": [
            "string",
            "integer"
          ]
        }
      }
    },
    "getSort": {
      "summary": "Read the sort shown on the headers.",
      "arguments": [],
      "returns": {
        "type": "object"
      }
    },
    "getToolbarActions": {
      "summary": "The toolbar actions as declared, copied.",
      "arguments": [],
      "returns": {
        "type": "array"
      }
    },
    "requestActionIntent": {
      "summary": "Emit a typed row or bulk action request; the host owns execution and authorization. Invalid arguments throw TypeError before emission.",
      "arguments": [
        {
          "name": "actionId",
          "schema": {
            "type": "string",
            "minLength": 1
          }
        },
        {
          "name": "recordIds",
          "schema": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "integer"
              ],
              "minLength": 1
            },
            "minItems": 1
          }
        }
      ],
      "returns": {
        "type": "object"
      }
    },
    "requestContextQuery": {
      "summary": "Internal to the context port: emit sf-table-query-intent for the current context with a new pending sequence.",
      "arguments": [
        {
          "name": "sequence",
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "returns": {
        "type": "object"
      }
    },
    "requestCreateIntent": {
      "summary": "Emit sf-table-create-intent for the main button (null) or a declared create item id.",
      "arguments": [
        {
          "name": "itemId",
          "schema": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      ],
      "returns": {
        "type": "object"
      }
    },
    "requestRetry": {
      "summary": "Emit a retry intent after a failed data request.",
      "arguments": [],
      "returns": {
        "type": "object"
      }
    },
    "setActiveFilterFields": {
      "summary": "Show exactly these filter fields in the selected filter template. Used when a saved view is opened: settings.filter_fields names the fields it was showing.",
      "arguments": [
        {
          "name": "keys",
          "schema": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      ],
      "returns": {
        "type": "object"
      }
    },
    "setBulkActions": {
      "summary": "Register labeled opaque actions for the current selection. Empty selection disables their controls.",
      "arguments": [
        {
          "name": "actions",
          "schema": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "returns": {
        "type": "object"
      }
    },
    "setColumns": {
      "summary": "Replace canonical backend-provided columns.",
      "arguments": [
        {
          "name": "columns",
          "schema": {
            "type": "array"
          }
        }
      ],
      "returns": {
        "type": "object"
      }
    },
    "setCreateItems": {
      "summary": "Set the create split-button menu items ({id, name} only). Without items the create button has no arrow.",
      "arguments": [
        {
          "name": "items",
          "schema": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "returns": {
        "type": "object"
      }
    },
    "setDataState": {
      "summary": "Switch between automatic, loading, populated, empty and error presentation states.",
      "arguments": [
        {
          "name": "state",
          "schema": {
            "type": "string",
            "enum": [
              "auto",
              "loading",
              "populated",
              "empty",
              "error"
            ]
          }
        }
      ],
      "returns": {
        "type": "object"
      }
    },
    "setFilterFields": {
      "summary": "Register backend-allowlisted filter fields and controls.",
      "arguments": [
        {
          "name": "fields",
          "schema": {
            "type": "array"
          }
        }
      ],
      "returns": {
        "type": "object"
      }
    },
    "setRows": {
      "summary": "Replace the current backend result rows.",
      "arguments": [
        {
          "name": "rows",
          "schema": {
            "type": "array"
          }
        }
      ],
      "returns": {
        "type": "object"
      }
    },
    "setSort": {
      "summary": "Show the host's current sort on the headers without emitting an event; (null, null) clears it.",
      "arguments": [
        {
          "name": "key",
          "schema": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        {
          "name": "direction",
          "schema": {
            "enum": [
              "asc",
              "desc",
              null
            ]
          }
        }
      ],
      "returns": {
        "type": "object"
      }
    },
    "setTableData": {
      "summary": "Patch columns, rows or related table state supplied by the host.",
      "arguments": [
        {
          "name": "patch",
          "schema": {
            "type": "object"
          }
        }
      ],
      "returns": {
        "type": "object"
      }
    },
    "setTableSettings": {
      "summary": "Apply a column-preference delta without emitting a save request.",
      "arguments": [
        {
          "name": "settings",
          "schema": {
            "type": "object"
          }
        }
      ],
      "returns": {
        "type": "object"
      }
    },
    "setTemplates": {
      "summary": "Apply saved filter/view templates.",
      "arguments": [
        {
          "name": "templates",
          "schema": {
            "type": "array"
          }
        }
      ],
      "returns": {
        "type": "object"
      }
    },
    "setToolbarActions": {
      "summary": "Declare the view's own actions for the toolbar menu: {id, label, icon?, href?}. An href must name this same site. Without actions the control is not rendered.",
      "arguments": [
        {
          "name": "items",
          "schema": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      ],
      "returns": {
        "type": "object"
      }
    },
    "sfPortInput": {
      "summary": "Composition input port entry used by sf-composition-scope. Accepts only the declared context port with record-ids.v1; invalid ports or values throw TypeError before any state change.",
      "arguments": [
        {
          "name": "port",
          "schema": {
            "const": "context"
          }
        },
        {
          "name": "value",
          "schema": {
            "type": "array",
            "maxItems": 1000,
            "uniqueItems": true,
            "items": {
              "type": [
                "string",
                "integer"
              ],
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        {
          "name": "meta",
          "schema": {
            "type": "object"
          }
        }
      ],
      "returns": {
        "type": "null"
      }
    }
  },
  "events": {
    "sf-port-output": {
      "summary": "Composition port output. The table emits port selection (record-ids.v1) once per change of its explicit selection, including clearing; a common sf-composition-scope routes it.",
      "payload": {
        "type": "object",
        "required": [
          "port",
          "value"
        ],
        "properties": {
          "port": {
            "const": "selection"
          },
          "value": {
            "type": "array",
            "maxItems": 1000,
            "uniqueItems": true,
            "items": {
              "type": [
                "string",
                "integer"
              ],
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "additionalProperties": false
      }
    },
    "sf-table-action-intent": {
      "summary": "Request one host-resolved row or bulk operation. Event source is the owning table instance; emission is not operation success.",
      "payload": {
        "type": "object",
        "required": [
          "action_id",
          "record_ids"
        ],
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "record_ids": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "integer"
              ],
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "sf-table-column-settings-change": {
      "summary": "Request persistence of a column preference delta after resize, reorder or visibility changes.",
      "payload": {
        "type": "object",
        "required": [
          "reason",
          "tableSettingsKey",
          "columnSettings"
        ],
        "properties": {
          "reason": {
            "type": "string"
          },
          "tableSettingsKey": {
            "type": "string"
          },
          "columnSettings": {
            "$ref": "#/contracts/column_settings"
          }
        }
      }
    },
    "sf-table-column-settings-reset": {
      "summary": "Runtime event sf-table-column-settings-reset.",
      "payload": {
        "type": "object"
      }
    },
    "sf-table-create-intent": {
      "summary": "The user pressed the create button (item null) or chose an item from its menu (item id). Intent only: the host opens its create form.",
      "payload": {
        "type": "object",
        "required": [
          "item"
        ],
        "properties": {
          "item": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "sf-table-filter-change": {
      "summary": "Request a host-side query after the active filter draft changes.",
      "payload": {
        "type": "object"
      }
    },
    "sf-table-query-intent": {
      "summary": "Request a host-side query after the context input port changed. The host resolves the relation and access, then answers with applyQueryResult(sequence, rows); older sequences are ignored.",
      "payload": {
        "type": "object",
        "required": [
          "reason",
          "context",
          "sequence"
        ],
        "properties": {
          "reason": {
            "const": "context"
          },
          "context": {
            "$ref": "#/contracts/query_context"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "sf-table-retry": {
      "summary": "Request another host-side load after the error state.",
      "payload": {
        "type": "null"
      }
    },
    "sf-table-search-change": {
      "summary": "Request a host-side query after the debounced search value changes.",
      "payload": {
        "type": "string"
      }
    },
    "sf-table-sort-change": {
      "summary": "The user activated a sortable header. Direction cycles asc, desc, null (unsorted). Intent only: the table marks the header but does not reorder rows; the host reorders or reloads.",
      "payload": {
        "type": "object",
        "required": [
          "key",
          "direction"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "asc",
              "desc",
              null
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "sf-table-template-delete": {
      "summary": "The user deleted saved templates on the Templates tab and pressed Apply. Intent only: the host removes the saved view. One event per deleted template.",
      "payload": {
        "type": "object",
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "sf-table-template-save": {
      "summary": "Request persistence of one or more filter templates (order, pin, delete, default, selected flags or data). Loading a saved view is reported by sf-table-template-select.",
      "payload": {
        "type": [
          "object",
          "array"
        ]
      }
    },
    "sf-table-template-select": {
      "summary": "The user applied a different saved template on the Templates tab. Intent only: the host loads that saved view.",
      "payload": {
        "type": "object",
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "sf-table-toolbar-action": {
      "summary": "The user chose one of the view's own actions from the toolbar menu. Intent only, and cancelable: the component follows an item's same-site href unless the host takes the navigation over with preventDefault.",
      "payload": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "href": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
