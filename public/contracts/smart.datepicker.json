{
  "schema_version": 2,
  "id": "smart.datepicker",
  "version": "1.0.0",
  "title": "Datepicker",
  "summary": "Accessible date and date-range picker with popup and inline presentation, calendar navigation and host-owned values.",
  "kind": "composite",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "calendar",
    "date",
    "datepicker",
    "form",
    "range"
  ],
  "capabilities": [
    "date-selection",
    "date-range",
    "keyboard-navigation",
    "popup",
    "inline",
    "theme",
    "responsive"
  ],
  "custom_element": "sf-datepicker",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "component.datepicker",
      "smart.inputs",
      "smart.buttons",
      "smart.icon-buttons",
      "smart.icons"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "properties": {
      "template": {
        "type": "string",
        "default": "default"
      },
      "value": {
        "type": "string",
        "default": ""
      },
      "date": {
        "type": "string",
        "default": ""
      },
      "start-value": {
        "type": "string",
        "default": ""
      },
      "end-value": {
        "type": "string",
        "default": ""
      },
      "max-date": {
        "type": "string",
        "default": ""
      },
      "min-date": {
        "type": "string",
        "default": ""
      },
      "range": {
        "type": "boolean",
        "default": false
      },
      "month": {
        "type": "number",
        "default": null
      },
      "year": {
        "type": "number",
        "default": null
      },
      "context": {
        "type": "string",
        "default": ""
      },
      "week-start": {
        "type": "number",
        "default": 1
      },
      "locale": {
        "type": "string",
        "default": ""
      },
      "format": {
        "type": "string",
        "default": "DD.MM.YYYY"
      },
      "root-class": {
        "type": "string",
        "default": ""
      },
      "close-on-select": {
        "type": "boolean",
        "default": true
      },
      "input": {
        "type": "boolean",
        "default": true
      },
      "open": {
        "type": "boolean",
        "default": false
      },
      "portal": {
        "type": "boolean",
        "default": true
      },
      "input-type": {
        "type": "string",
        "default": "bordered"
      },
      "size": {
        "type": "string",
        "default": "1",
        "enum": [
          "1/2",
          "1",
          "2"
        ],
        "description": "Form size of the field."
      },
      "input-size": {
        "type": "string",
        "default": "1",
        "enum": [
          "1/2",
          "1",
          "2"
        ],
        "description": "Legacy name for size, still honoured; size wins when both are set. See contracts/public-api-axes.json."
      },
      "input-name": {
        "type": "string",
        "default": ""
      },
      "placeholder": {
        "type": "string",
        "default": ""
      },
      "label": {
        "type": "string",
        "default": ""
      },
      "disabled": {
        "type": "boolean",
        "default": false
      },
      "required": {
        "type": "boolean",
        "default": false
      },
      "icon-start": {
        "type": "string",
        "default": "calendar_today"
      },
      "left-icon": {
        "type": "string",
        "default": "calendar_today"
      },
      "input-root-class": {
        "type": "string",
        "default": ""
      },
      "mask": {
        "type": "boolean",
        "default": false
      },
      "mask-pattern": {
        "type": "string",
        "default": "00.00.0000",
        "description": "Input mask; when not set it is derived from format, so the default format DD.MM.YYYY gives 00.00.0000."
      },
      "mask-lazy": {
        "type": "string",
        "default": false
      },
      "mask-placeholder-char": {
        "type": "string",
        "default": "_"
      },
      "mask-options": {
        "type": "string",
        "default": ""
      }
    },
    "additionalProperties": false
  },
  "item_contract": {
    "value_format": "ISO date strings are stored in YYYY-MM-DD form; format controls only the visible field value.",
    "range_value": "Range mode exposes start-value and end-value and restarts the range after a completed selection.",
    "host_owned": [
      "validation beyond min-date and max-date",
      "persistence",
      "timezone and domain-date interpretation"
    ]
  },
  "contracts": {
    "change_detail": {
      "type": "object",
      "required": [
        "value",
        "range",
        "format"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "array"
          ]
        },
        "range": {
          "type": "boolean"
        },
        "format": {
          "type": "string"
        },
        "formattedValue": {
          "type": "string"
        }
      }
    }
  },
  "methods": {
    "setContext": {
      "summary": "Open the day, month or year calendar context.",
      "arguments": [
        {
          "name": "context",
          "schema": {
            "type": "string",
            "enum": [
              "",
              "month",
              "year"
            ]
          }
        }
      ],
      "returns": {
        "type": "object"
      }
    },
    "openPanel": {
      "summary": "Open the popup; optionally move focus into the calendar.",
      "arguments": [
        {
          "name": "options",
          "schema": {
            "type": "object"
          }
        }
      ],
      "returns": {
        "type": "object"
      }
    },
    "closePanel": {
      "summary": "Close the popup; optionally restore focus to the field.",
      "arguments": [
        {
          "name": "options",
          "schema": {
            "type": "object"
          }
        }
      ],
      "returns": {
        "type": "object"
      }
    },
    "togglePanel": {
      "summary": "Toggle the popup without changing the selected value.",
      "arguments": [],
      "returns": {
        "type": "object"
      }
    }
  },
  "events": {
    "change": {
      "summary": "A date or range endpoint was selected; dispatched on the host. The name to bind.",
      "payload": {
        "$ref": "#/contracts/change_detail"
      },
      "canonical": true
    },
    "sf-datepicker-change": {
      "summary": "Legacy name for change, still emitted with the same detail; bind change.",
      "payload": {
        "$ref": "#/contracts/change_detail"
      },
      "alias_of": "change"
    },
    "sf-change": {
      "summary": "Legacy name for change, still emitted with the same detail; bind change.",
      "payload": {
        "type": "object"
      },
      "alias_of": "change"
    }
  },
  "state": {
    "machines": {
      "panel": [
        "closed",
        "open-below",
        "open-above"
      ],
      "context": [
        "day",
        "month",
        "year"
      ],
      "selection": [
        "empty",
        "single",
        "range-start",
        "range-complete"
      ]
    },
    "visual_states": [
      "default",
      "open",
      "selected",
      "disabled"
    ]
  },
  "persistence": {
    "mode": "none",
    "source_of_truth": "component",
    "network_owner": "none",
    "revision_field": null
  },
  "ownership": {
    "source": "simai/ui-source source and machine manifest",
    "data": "host",
    "effects": "component",
    "forbidden_client_responsibilities": [
      "timezone policy",
      "business-day validation",
      "persistence",
      "backend access decisions",
      "host route invention"
    ]
  },
  "security": {
    "permissions_owner": "none",
    "untrusted_inputs": [
      "props",
      "children"
    ],
    "network_policy": "deny"
  },
  "accessibility": {
    "role": "dialog in popup mode; group in inline mode",
    "accessible_name": "required",
    "keyboard": [
      "Tab",
      "Shift+Tab",
      "Enter",
      "Space",
      "Escape",
      "ArrowLeft",
      "ArrowRight",
      "ArrowUp",
      "ArrowDown",
      "Home",
      "End",
      "PageUp",
      "PageDown"
    ],
    "focus": "ArrowDown opens the popup and moves focus to the active day. Only one day is in the tab order. Escape closes the popup and restores focus to the field. RTL reverses physical horizontal arrows while preserving chronological movement."
  },
  "presentation": {
    "themes": [
      "light",
      "dark"
    ],
    "locales": [
      "ru",
      "en"
    ],
    "responsive": [
      "desktop-popup",
      "mobile-popup",
      "inline",
      "visual-viewport-bounded-overlay"
    ]
  },
  "adapter": {
    "kind": "generic",
    "protocol": "simai.smart-studio-adapter.v1",
    "module": null
  },
  "artifacts": {
    "fixtures": [
      "studio.fixture.json"
