    "use_when": "Use sf-datepicker for a single date or date range that benefits from calendar navigation. Use a plain input when free-form entry is the primary task.",
    "do_not": [
      "Do not copy generated ui-smart code",
      "Do not use color as the only selected or disabled signal",
      "Do not encode timezone or business-date rules in the visual component",
      "Do not move host data or access decisions into the component"
    ],
