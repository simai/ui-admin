  "ai_guidance": {
    "use_when": "Use sf-dropdown when a form needs one or several values from a concealed option set. Use direct sf-list-item children with stable machine values and visible labels. Use portal only when an ancestor clips the popup.",
    "do_not": [
      "Do not copy generated ui-smart code",
      "Do not move host data or access decisions into the component",
      "Do not use the visible label as the submitted value when a stable machine identifier exists",
      "Do not make decorative checkbox, avatar or icon content independently focusable inside an option"
