  "provenance": {
    "source_repository": "simai/ui-source",
    "source_revision": "38559ce2a0e50b559ede7c7030676e11862d62d2",
    "source_artifacts": [
      {
        "path": "src/smart/editor-overlay/index.js",
        "sha256": "1e1369185c9e31e038f27e73b5f19ea02c0811608b26299023e7d1de305c7d57"
