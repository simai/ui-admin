  "ai_guidance": {
    "use_when": "Use sf-header-page at the top of every admin page: it is the only place a page states its path, heading, count, favourite and main action once the admin top bar is gone.",
    "do_not": [
      "Do not keep favourites in the component; answer sf-page-header-star from the host",
      "Do not put totals in the menu; they belong here",
      "Do not style the heading yourself; it is the fourth heading step"
    ],
    "required_reads": [
      "inputs",
      "events",
      "ownership"
    ],
    "minimal_example": "<sf-header-page heading=\"Каталог решений\" count=\"448\" star=\"off\"><sf-breadcrumbs slot=\"path\"><sf-breadcrumbs-item href=\"/\">simai.ru</sf-breadcrumbs-item><sf-breadcrumbs-item href=\"/data\">Данные</sf-breadcrumbs-item></sf-breadcrumbs><sf-button slot=\"actions\" icon-start=\"add\">Создать</sf-button></sf-header-page>",
    "owner_commands": [
      "npm run contract:verify",
      "npm test"
    ]
  }
}
