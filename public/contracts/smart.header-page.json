{
  "schema_version": 2,
  "id": "smart.header-page",
  "version": "1.2.6",
  "title": "Page header",
  "summary": "The head of an admin page: path, heading, count, favourite star, install mark and main action. Replaces the admin top bar together with sf-admin-menu.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "page-header",
    "admin",
    "navigation"
  ],
  "capabilities": [
    "render",
    "theme",
    "responsive",
    "i18n"
  ],
  "custom_element": "sf-header-page",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "smart.badge",
      "smart.button-icon",
      "smart.icon"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "properties": {
      "template": {
        "type": "string",
        "default": "default",
        "description": "Template variant name for SfBaseElement external templates."
      },
      "root-class": {
        "type": "string",
        "default": "",
        "description": "Classes added to the root element the component draws."
      },
      "root-style": {
        "type": "string",
        "default": "",
        "description": "Inline style declarations set on the root element the component draws, custom properties included."
      },
      "heading": {
        "type": "string",
        "default": "",
        "description": "The page heading, drawn as the fourth heading step"
      },
      "count": {
        "type": "string",
        "default": "",
        "description": "How many records the page holds, as the host writes it (448, ~1 200); empty draws no count"
      },
      "level": {
        "type": "string",
        "default": "site",
        "description": "install marks a page shared by every site",
        "enum": [
          "site",
          "install"
        ]
      },
      "star": {
        "type": "boolean",
        "default": false,
        "description": "Absent draws no star; false (or off) and true (or on) draw it in that state"
      }
    },
    "additionalProperties": false
  },
  "item_contract": {},
  "contracts": {},
  "methods": {},
  "events": {
    "sf-header-page-toggle": {
      "summary": "The person pressed the star: the request to make the page a favourite (on) or not; a host that answers itself cancels it and writes star",
      "payload": {
        "type": "object",
        "required": [
          "on"
        ],
        "properties": {
          "on": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      },
      "canonical": true
    },
    "sf-page-header-star": {
      "summary": "The person pressed the star. Cancelable: a host that waits for its own answer cancels it and sets star itself.",
      "payload": {
        "type": "object",
        "required": [
          "on"
        ],
        "properties": {
          "on": {
            "type": "boolean"
          }
        }
      },
      "alias_of": "sf-header-page-toggle"
    },
    "sf-page-header-toggle": {
      "summary": "Dated alias of sf-header-page-toggle until 2027-01-01 (same-detail).",
      "payload": {
        "type": "object"
      },
      "alias_of": "sf-header-page-toggle"
    }
  },
  "state": {
    "machines": {},
    "visual_states": [
      "default",
      "selected"
    ]
  },
  "persistence": {
    "mode": "none",
    "source_of_truth": "host",
    "network_owner": "host",
    "revision_field": null
  },
  "ownership": {
    "source": "simai/ui-source",
    "data": "host",
    "effects": "host",
    "forbidden_client_responsibilities": [
      "backend access decisions",
      "host route invention",
      "keeping favourites"
    ]
  },
  "security": {
    "permissions_owner": "none",
    "untrusted_inputs": [
      "props",
      "children"
    ],
    "network_policy": "deny"
  },
  "accessibility": {
    "role": "none",
    "accessible_name": "internal",
    "keyboard": [
      "Tab reaches the star and the actions",
      "Enter or Space toggles the star"
    ],
    "focus": "The star is a native button in sf-icon-button with a label that says what pressing it does, and so its state; it carries no aria-pressed (rule C12)."
  },
  "presentation": {
    "themes": [
      "light",
      "dark"
    ],
    "locales": [
      "ru",
      "en"
    ],
    "responsive": [
      "desktop",
      "mobile"
    ],
    "skeleton": {
      "shape": "block",
      "while_loading": "none"
    }
  },
  "adapter": {
    "kind": "generic",
    "protocol": "simai.smart-studio-adapter.v1",
    "module": null
  },
  "artifacts": {
    "fixtures": [
      "studio.fixture.json"
    ],
    "scenarios": [
      "studio.scenario.json"
    ]
  },
  "readiness": {
    "level": "described",
    "required_checks": [
      "manifest",
      "fixture",
      "runtime-upgrade",
      "scenario-smoke"
    ]
  },
  "compatibility": {
    "contract_schema": {
      "id": "https://simai.io/contracts/smart-component-manifest.v2.schema.json",
      "version": 2
    },
    "runtime_pair": {
      "ui_revision": "094f3d549aa7921d2d7f8773972c73711dd6a72e",
      "ui_smart_revision": "856fb5d751fad1c76104c32515f4c1869dd75b6c"
    },
    "aliases": [
      "<sf-page-header>"
    ],
    "deprecations": [
      {
        "path": "<sf-page-header>",
        "since": "1.2.0",
        "replacement": "<sf-header-page>"
      }
    ],
    "replacement": null,
    "migrations": []
  },
  "provenance": {
    "source_repository": "simai/ui-source",
    "source_revision": "f252b04f9b44be83fee96585bfab244c9f4e6fd7",
    "source_artifacts": [
      {
        "path": "src/smart/header-page/index.js",
        "sha256": "b13c0023ea8f771f33768ab0f4e7356c08407bfe501f1ea7778010d12ac812a1"
