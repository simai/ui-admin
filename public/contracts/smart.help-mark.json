      "placement": {
        "type": "string",
        "default": "auto",
        "enum": [
          "auto",
          "top",
          "bottom",
          "start",
          "end"
        ]
      },
      "title": {
        "type": "string",
        "default": "",
        "description": "Dated alias of heading until 2026-12-01."
