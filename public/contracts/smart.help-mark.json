      "payload": {
        "type": "object",
        "properties": {}
      },
      "alias_of": "sf-help-mark-opened"
    },
    "sf-help-mark-close": {
      "summary": "The explanation closed.",
      "payload": {
        "type": "object",
        "properties": {}
      },
      "alias_of": "sf-help-mark-closed"
    }
