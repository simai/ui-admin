      "template": {
        "type": "string",
        "default": "default",
        "description": "Template variant name for SfBaseElement external templates.",
        "enum": [
          "default"
        ]
      },
      "kind": {
        "type": "string",
        "default": "icon",
        "enum": [
          "icon",
          "close"
        ],
        "description": "What the icon button is: an ordinary icon action or a close control."
      },
      "size": {
        "type": "string",
        "default": "1",
