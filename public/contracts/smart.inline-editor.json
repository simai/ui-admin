  "ai_guidance": {
    "use_when": "Use the inline editor for text of content.heading and content.paragraph on an editor page. Save the committed content through the host Property contract, validate the Document and re-render.",
    "do_not": [
      "Do not copy generated ui-smart code",
      "Do not save HTML; events carry the content model",
      "Do not offer lists; the content model has none",
      "Do not call startInlineEdit before sf-inline-editor is defined"
    ],
    "required_reads": [
      "contracts",
      "methods",
      "events",
      "ownership",
      "provenance"
    ],
    "minimal_example": "<sf-inline-editor></sf-inline-editor><script>await customElements.whenDefined('sf-inline-editor'); SF.Composition.startInlineEdit(paragraph, {content, nodeId: 'p1', label: 'Paragraph'});</script>",
    "owner_commands": [
      "npm run contract:verify",
      "npm test"
    ]
  }
}
