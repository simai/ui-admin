{
  "schema_version": 2,
  "id": "smart.input",
  "version": "1.3.4",
  "title": "Text fields",
  "summary": "A native single-line form control with Framework presentation, validation messaging and optional mask integration.",
  "kind": "smart",
  "reuse_mode": "both",
  "lifecycle": "experimental",
  "tags": [
    "inputs"
  ],
  "capabilities": [
    "render",
    "theme",
    "responsive"
  ],
  "custom_element": "sf-input",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "component.icon-buttons",
      "component.inputs",
      "smart.icon"
    ],
    "public_parts": [
      "native-input",
      "label",
      "field",
      "hint",
      "leading",
      "trailing"
    ]
  },
  "inputs": {
    "type": "object",
    "properties": {
      "template": {
        "type": "string",
        "default": "default",
        "description": "Template variant name for SfBaseElement external templates."
      },
      "root-class": {
        "type": "string",
        "default": ""
      },
      "root-style": {
        "type": "string",
        "default": ""
      },
      "size": {
        "type": "string",
        "default": "1",
        "enum": [
          "1/2",
          "1",
          "2"
        ]
      },
      "appearance": {
        "type": "string",
        "default": "bordered",
        "description": "How the field looks: a bordered box, a filled one, or hidden.",
        "enum": [
          "bordered",
          "filled",
          "hidden"
        ]
      },
      "label": {
        "type": "string",
        "default": ""
      },
      "required": {
        "type": "boolean",
        "default": false
      },
      "placeholder": {
        "type": "string",
        "default": ""
      },
      "input-type": {
        "type": "string",
        "default": "text",
        "enum": [
          "text",
          "email",
          "password",
          "search",
          "tel",
          "url"
        ]
      },
      "autocomplete": {
        "type": "string",
        "default": ""
      },
      "inputmode": {
        "type": "string",
        "default": "",
        "enum": [
          "",
          "none",
          "text",
          "tel",
          "url",
          "email",
          "numeric",
          "decimal",
          "search"
        ]
      },
      "minlength": {
        "type": "string",
        "default": ""
      },
      "maxlength": {
        "type": "string",
        "default": ""
      },
      "pattern": {
        "type": "string",
        "default": ""
      },
      "hint": {
        "type": "string",
        "default": ""
      },
      "default-value": {
        "type": "string",
        "default": ""
      },
      "name": {
        "type": "string",
        "default": ""
      },
      "icon-start": {
        "type": "string",
        "default": ""
      },
      "text-end": {
        "type": "string",
        "default": ""
      },
      "hint-icon": {
        "type": "string",
        "default": ""
      },
      "disabled": {
        "type": "boolean",
        "default": false
      },
      "readonly": {
        "type": "boolean",
        "default": false
      },
      "invalid": {
        "type": "boolean",
        "default": false
      },
      "error-message": {
        "type": "string",
        "default": ""
      },
      "mask": {
        "type": "boolean",
        "default": false
      },
      "mask-pattern": {
        "type": "string",
        "default": ""
      },
      "mask-lazy": {
        "type": "string",
        "default": ""
      },
      "mask-placeholder-char": {
        "type": "string",
        "default": ""
      },
      "mask-options": {
        "type": "string",
        "default": ""
      },
      "value": {
        "type": "string",
        "default": ""
      },
      "aria-label": {
        "type": "string",
        "default": "",
        "description": "Accessible name for a field rendered without a visible label; it lands on the native input."
      },
      "error": {
        "type": "boolean",
        "default": false,
        "description": "Dated alias of invalid until 2026-12-01."
      },
      "type": {
        "type": "string",
        "default": "bordered",
        "description": "Legacy name for appearance, still honoured. See contracts/public-api-axes.json.",
        "enum": [
          "bordered",
          "filled",
          "hidden"
        ]
      },
      "left-icon": {
        "type": "string",
        "default": "",
        "description": "Dated alias of icon-start until 2026-12-01."
      },
      "right-text": {
        "type": "string",
        "default": "",
        "description": "Dated alias of text-end until 2026-12-01."
      },
      "inherited-value": {
        "type": "string",
        "default": "",
        "description": "What the field falls back to while it holds no value of its own -- a default from a parent setting, a brand, a theme. Shown as inherited, in the placeholder's ink with an «inherited» marker, never as the value: the form value stays empty. Once the field holds a value of its own, a reset button returns it here. A number field is sf-input with inputmode numeric or decimal and takes it the same way."
      },
      "inherited-text": {
        "type": "string",
        "default": "",
        "description": "The words of the marker shown while the inherited value applies. Unset, it follows the page's language («inherited», «наследуется»)."
      },
      "reset-label": {
        "type": "string",
        "default": "",
        "description": "The accessible name of the button that returns the field to the inherited value. Unset, it follows the page's language («Reset to inherited», «Сбросить к наследуемому»)."
      }
    },
    "additionalProperties": false
  },
  "item_contract": {},
  "contracts": {
    "state_owner": {
      "const": "native_input"
    },
    "value_owner": {
      "const": "native_input"
    },
    "form_owner": {
      "const": "native_form"
    },
    "reset": {
      "const": "native_form_reset"
    },
    "mask_owner": {
      "const": "optional_sf_mask_adapter"
    },
    "field_states": {
      "type": "string",
      "enum": [
        "empty",
        "filled",
        "hover",
        "focus-visible",
        "readonly",
        "disabled",
        "invalid"
      ]
    }
  },
  "methods": {
    "getInputElement": {
      "summary": "Returns the inner native input, or null before render.",
      "arguments": [],
      "returns": {
        "type": [
          "object",
          "null"
        ],
        "description": "The HTMLInputElement."
      }
    },
    "onInput": {
      "summary": "Adds a listener for input on the host. Returns the element.",
      "arguments": [
        {
          "name": "handler",
          "type": "function",
          "required": true
        },
        {
          "name": "options",
          "type": [
            "object",
            "boolean"
          ],
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "onChange": {
      "summary": "Adds a listener for change on the host. Returns the element.",
      "arguments": [
        {
          "name": "handler",
          "type": "function",
          "required": true
        },
        {
          "name": "options",
          "type": [
            "object",
            "boolean"
          ],
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "onKeyUp": {
      "summary": "Adds a listener for keyup on the host. Returns the element.",
      "arguments": [
        {
          "name": "handler",
          "type": "function",
          "required": true
        },
        {
          "name": "options",
          "type": [
            "object",
            "boolean"
          ],
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "onKeyDown": {
      "summary": "Adds a listener for keydown on the host. Returns the element.",
      "arguments": [
        {
          "name": "handler",
          "type": "function",
          "required": true
        },
        {
          "name": "options",
          "type": [
            "object",
            "boolean"
          ],
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "onFocus": {
      "summary": "Adds a listener for focusin on the host. Returns the element.",
      "arguments": [
        {
          "name": "handler",
          "type": "function",
          "required": true
        },
        {
          "name": "options",
          "type": [
            "object",
            "boolean"
          ],
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "onBlur": {
      "summary": "Adds a listener for focusout on the host. Returns the element.",
      "arguments": [
        {
          "name": "handler",
          "type": "function",
          "required": true
        },
        {
          "name": "options",
          "type": [
            "object",
            "boolean"
          ],
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "resetToInherited": {
      "summary": "Returns the field to its inherited value, as the reset button does: fires the cancellable sf-field:reset, then empties the own value and focuses the control. Returns whether it was reset (false without an inherited value, without an own value, while disabled or readonly, or when the event was prevented).",
      "arguments": [],
      "returns": {
        "type": "boolean",
        "description": "Whether the field was reset."
      }
    }
  },
  "events": {
    "change": {
      "summary": "The value was committed; the native event bubbles from the inner input, which is its target. It carries no detail.",
      "payload": {
        "type": "null",
        "description": "A native Event: there is no detail."
      },
      "canonical": true
    },
    "input": {
      "summary": "The value changed while typing; the native event bubbles from the inner input, which is its target. It carries no detail.",
      "payload": {
        "type": "null",
        "description": "A native Event: there is no detail."
      }
    },
    "sf-field:reset": {
      "summary": "The person pressed the reset back to the inherited value. Fired before the field is emptied and cancellable: preventDefault keeps the value. When it is not prevented the field empties, says so with its ordinary change, shows the inherited value again and takes focus back.",
      "payload": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "description": "The field's own value before the reset."
          },
          "inheritedValue": {
            "type": "string",
            "description": "The inherited value it returns to."
          },
          "name": {
            "type": "string",
            "description": "The form name, empty when the field has none."
          }
        }
      }
    }
  },
