  "ai_guidance": {
    "use_when": "Use sf-list for a list a person acts on -- conversations, letters, templates, files, members, versions: open a row, rename it, its actions, the next page. For a column a person reads from the newest at the end use sf-list-feed; for a choice in a field use sf-dropdown.",
    "do_not": [
      "Do not fetch or sort in the element; give the items in order and answer its events",
      "Do not pass markup in text or supporting; they are text",
      "Do not apply an action in the element; answer apply and update the items"
    ],
    "required_reads": [
      "inputs",
      "events",
      "accessibility"
    ],
    "minimal_example": "<sf-list label=\"Письма\" renamable></sf-list>",
    "owner_commands": [
      "npm run contract:verify",
      "node scripts/run-browser-probes.mjs <output>"
    ]
  }
}
