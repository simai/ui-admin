{
  "schema_version": 2,
  "id": "smart.list",
  "version": "1.3.4",
  "title": "List",
  "summary": "A list a person acts on -- conversations, letters, templates, files, members, versions: rows from data drawn as sf-list-item, grouped by day or by key, one Tab stop, the open row, row actions in one shared menu, rename in place, the next page at the end, an empty state. Fetches nothing; every request is an event.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "list",
    "rows",
    "actions",
    "rename",
    "groups"
  ],
  "capabilities": [
    "content",
    "selection",
    "rename",
    "row-actions",
    "pagination",
    "grouping",
    "pinning",
    "responsive"
  ],
  "custom_element": "sf-list",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "component.dropdown",
      "component.icon-buttons",
      "smart.avatar",
      "smart.badge",
      "smart.button",
      "smart.empty-state",
      "smart.icon",
      "smart.list-item",
      "smart.menu-context"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "properties": {
      "template": {
        "type": "string",
        "default": "default",
        "description": "Template variant name for SfBaseElement external templates."
      },
      "root-class": {
        "type": "string",
        "default": "",
        "description": "Classes added to the root element the component draws."
      },
      "root-style": {
        "type": "string",
        "default": "",
        "description": "Inline style declarations set on the root element the component draws, custom properties included."
      },
      "selected": {
        "type": "string",
        "default": "",
        "description": "The id of the open row: aria-current and the open tint. Controlled: a press asks open {id}, the host writes it back."
      },
      "group-by": {
        "type": "string",
        "default": "none",
        "description": "none: one list. day: by the calendar day of each item's date in the reader's time zone (Сегодня, Вчера, a weekday, the date). key: by each item's group, in the order of groups.",
        "enum": [
          "none",
          "day",
          "key"
        ]
      },
      "renamable": {
        "type": "boolean",
        "default": false,
        "description": "Rows are renamed in place: F2 and «Переименовать» in the menu; rename {id, text} says the new name."
      },
      "has-more": {
        "type": "boolean",
        "default": false,
        "description": "A next page exists: «Показать ещё» shows, and the end coming into reach asks for it."
      },
      "loading": {
        "type": "boolean",
        "default": false,
        "description": "The first page is on its way: the rows' shape instead of words."
      },
      "size": {
        "type": "string",
        "default": "1",
        "description": "The rows' step on the size ladder (sf-list-item size); the «⋯» and the rename field take the same.",
        "enum": [
          "1/2",
          "1",
          "2"
        ]
      },
      "no-wrap": {
        "type": "boolean",
        "default": false,
        "description": "Every row's title and its second line stay one line each, cut at the end with an ellipsis; the whole text stays in the row for a screen reader and is the row's tooltip (title). Off: the title of a one-line row wraps."
      },
      "label": {
        "type": "string",
        "description": "The list's accessible name; empty is «List» in the page's language."
      },
      "heading-level": {
        "type": "integer",
        "default": 3,
        "description": "The level of the groups' headings in the page's outline.",
        "minimum": 2,
        "maximum": 6
      },
      "empty-text": {
        "type": "string",
        "description": "The empty state's heading (sf-empty-state no-data); the empty slot replaces the whole state."
      },
      "items": {
        "type": "array",
        "default": [],
        "items": {
          "type": "object"
        },
        "description": "The rows, in the host's order: {id, text, supporting?, icon?, avatar?, date?, group?, count?, badge?, pinned?, disabled?, actions?}."
      },
      "groups": {
        "type": "array",
        "default": [],
        "description": "With group-by key: the groups in order, [{key, text}]; a key not listed follows, its key as its heading."
      },
      "actions": {
        "type": "array",
        "default": [],
        "description": "The row actions in the shared menu, after «Переименовать»: [{id, text, icon?, destructive?}]. Chosen, one leaves as apply {action, scope: entry, ids}."
      }
    },
    "additionalProperties": false
  },
  "item_contract": {},
  "contracts": {
    "item": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "number"
          ],
          "description": "The stable key of the item."
        },
        "text": {
          "type": "string",
          "description": "The row's title, as text."
        },
        "supporting": {
          "type": "string",
          "description": "A quiet second line under the title."
        },
        "icon": {
          "type": "string",
          "description": "A glyph before the title (a Material Symbols name)."
        },
        "avatar": {
          "type": "object",
          "properties": {
            "image-url": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "shape": {
              "type": "string",
              "enum": [
                "circle",
                "square"
              ]
            },
            "icon": {
              "type": "string"
            }
          },
          "description": "The row's picture (sf-avatar): an image, the initials in text, or a sign (icon without an image); square for a group or a channel."
        },
        "date": {
          "type": "string",
          "description": "ISO 8601; with group-by day, the calendar day it is grouped under."
        },
        "group": {
          "type": "string",
          "description": "With group-by key, the key of its group."
        },
        "disabled": {
          "type": "boolean",
          "description": "Shown, not opened, renamed or acted on."
        },
        "actions": {
          "description": "false: no row actions; a list of action ids: only those."
        },
        "count": {
          "type": "number",
          "description": "A count at the row's end (unread); 0 draws nothing, above 99 «99+»."
        },
        "badge": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "tone": {
              "type": "string",
              "enum": [
                "neutral",
                "info",
                "success",
                "warning",
                "error"
              ]
            }
          },
          "required": [
            "text"
          ],
          "description": "A short tonal badge at the row's end, before the count."
        },
        "pinned": {
          "type": "boolean",
          "description": "Leads the list, under its own heading when the list is grouped."
        }
      },
      "required": [
        "id"
      ],
      "description": "Plain data; any further fields are the host's."
    }
  },
  "methods": {
    "setItems": {
      "summary": "The whole list and whether more follows, together; ends a page request.",
      "arguments": [
        {
          "name": "args",
          "type": "object",
          "required": true,
          "schema": {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": [
                        "string",
                        "number"
                      ],
                      "description": "The stable key of the item."
                    },
                    "text": {
                      "type": "string",
                      "description": "The row's title, as text."
                    },
                    "supporting": {
                      "type": "string",
                      "description": "A quiet second line under the title."
                    },
                    "icon": {
                      "type": "string",
                      "description": "A glyph before the title (a Material Symbols name)."
                    },
                    "date": {
                      "type": "string",
                      "description": "ISO 8601; with group-by day, the calendar day it is grouped under."
                    },
                    "group": {
                      "type": "string",
                      "description": "With group-by key, the key of its group."
                    },
                    "disabled": {
                      "type": "boolean",
                      "description": "Shown, not opened, renamed or acted on."
                    },
                    "actions": {
                      "description": "false: no row actions; a list of action ids: only those."
                    }
                  },
                  "required": [
                    "id"
                  ],
                  "description": "Plain data; any further fields are the host's."
                }
              },
              "options": {
                "type": "object",
                "properties": {
                  "hasMore": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            },
            "required": [
              "items"
            ]
          }
        }
      ],
      "returns": {
        "type": "object",
        "description": "{outcome: applied}"
      }
    },
    "appendItems": {
      "summary": "The next page after what is shown; ends the page request.",
      "arguments": [
        {
          "name": "args",
          "type": "object",
          "required": true,
          "schema": {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": [
                        "string",
                        "number"
                      ],
                      "description": "The stable key of the item."
                    },
                    "text": {
                      "type": "string",
                      "description": "The row's title, as text."
                    },
                    "supporting": {
                      "type": "string",
                      "description": "A quiet second line under the title."
                    },
                    "icon": {
                      "type": "string",
                      "description": "A glyph before the title (a Material Symbols name)."
                    },
                    "date": {
                      "type": "string",
                      "description": "ISO 8601; with group-by day, the calendar day it is grouped under."
                    },
                    "group": {
                      "type": "string",
                      "description": "With group-by key, the key of its group."
                    },
                    "disabled": {
                      "type": "boolean",
                      "description": "Shown, not opened, renamed or acted on."
                    },
                    "actions": {
                      "description": "false: no row actions; a list of action ids: only those."
                    }
                  },
                  "required": [
                    "id"
                  ],
                  "description": "Plain data; any further fields are the host's."
                }
              },
              "options": {
                "type": "object",
                "properties": {
                  "hasMore": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            },
            "required": [
              "items"
            ]
          }
        }
      ],
      "returns": {
        "type": "object",
        "description": "{outcome: applied}"
      }
    },
    "upsert": {
      "summary": "A new item at the start, or a changed one in its place.",
      "arguments": [
        {
          "name": "args",
          "type": "object",
          "required": true,
          "schema": {
            "type": "object",
            "properties": {
              "item": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "number"
                    ],
                    "description": "The stable key of the item."
                  },
                  "text": {
                    "type": "string",
                    "description": "The row's title, as text."
                  },
                  "supporting": {
                    "type": "string",
                    "description": "A quiet second line under the title."
                  },
                  "icon": {
                    "type": "string",
                    "description": "A glyph before the title (a Material Symbols name)."
                  },
                  "date": {
                    "type": "string",
                    "description": "ISO 8601; with group-by day, the calendar day it is grouped under."
                  },
                  "group": {
                    "type": "string",
                    "description": "With group-by key, the key of its group."
                  },
                  "disabled": {
                    "type": "boolean",
                    "description": "Shown, not opened, renamed or acted on."
                  },
                  "actions": {
                    "description": "false: no row actions; a list of action ids: only those."
                  }
                },
                "required": [
                  "id"
                ],
                "description": "Plain data; any further fields are the host's."
              }
            },
            "required": [
              "item"
            ]
          }
        }
      ],
      "returns": {
        "type": "object",
        "description": "{outcome: applied} or {outcome: refused, reason}"
      }
    },
    "detach": {
      "summary": "Take one item off; the focus on it goes to its neighbour.",
      "arguments": [
        {
          "name": "args",
          "type": "object|string",
          "required": true,
          "schema": {
            "type": "object",
            "properties": {
              "id": {}
            },
            "required": [
              "id"
            ]
          }
        }
      ],
      "returns": {
        "type": "object",
        "description": "{outcome: applied} or {outcome: refused, reason}"
      }
    },
    "rename": {
      "summary": "Start renaming a row in place, as F2 does.",
      "arguments": [
        {
          "name": "args",
          "type": "object|string",
          "required": true,
          "schema": {
            "type": "object",
            "properties": {
              "id": {}
            },
            "required": [
              "id"
            ]
          }
        }
      ],
      "returns": {
        "type": "object",
        "description": "{outcome: applied} or {outcome: refused, reason}"
      }
    },
    "openMenu": {
      "summary": "Open a row's actions, as its «⋯» and Shift+F10 do.",
      "arguments": [
        {
          "name": "args",
          "type": "object|string",
          "required": true,
          "schema": {
            "type": "object",
            "properties": {
              "id": {}
            },
            "required": [
              "id"
            ]
          }
        }
      ],
      "returns": {
        "type": "object",
        "description": "{outcome: applied} or {outcome: refused, reason}"
      }
    },
    "requestMore": {
      "summary": "Ask for the next page, as reaching the end and «Показать ещё» do; nothing while a request is out.",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "{outcome: applied} or {outcome: refused, reason}"
      }
    },
    "moreFailed": {
      "summary": "The next page could not be loaded: «Показать ещё» and the end ask again.",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "{outcome: applied}"
      }
    }
  },
  "events": {
    "sf-list-open": {
      "summary": "A row is asked for (vocabulary open): a press or Enter; the host opens it and writes selected back.",
      "payload": {
        "type": "object",
        "required": [
          "id",
          "trigger"
        ],
        "properties": {
          "id": {},
          "trigger": {
            "enum": [
              "pointer",
              "keyboard"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "sf-list-apply": {
      "summary": "One of the row actions was chosen: {action, scope: entry, ids} (vocabulary apply).",
      "payload": {
        "type": "object",
        "required": [
          "action",
          "scope",
          "ids"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "scope": {
            "const": "entry"
          },
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "sf-list-rename": {
      "summary": "A row was renamed in place; the new text is shown at once. Cancel it to keep the old text.",
      "payload": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {},
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "additionalProperties": true
      }
    },
    "sf-list-load-more": {
      "summary": "The next page is asked for: the end came into reach, or «Показать ещё»: {direction: after, after}. Cancelling it is moreFailed().",
      "payload": {
        "type": "object",
        "required": [
          "direction",
          "after"
        ],
        "properties": {
          "direction": {
            "const": "after"
          },
          "after": {
            "description": "The id of the last row shown."
          }
        },
        "additionalProperties": true
      }
    }
  },
  "state": {
    "machines": {
      "more": [
        "idle",
        "loading"
      ],
      "row": [
        "shown",
        "renaming"
      ]
    },
    "visual_states": [
      "default",
      "selected",
      "empty",
      "loading"
    ]
  },
  "persistence": {
    "mode": "none",
    "source_of_truth": "host",
    "network_owner": "host",
    "revision_field": null
  },
  "ownership": {
    "source": "simai/ui-source",
    "data": "host",
    "effects": "host",
    "forbidden_client_responsibilities": [
      "fetching or sorting items",
      "applying an action",
      "access decisions"
    ]
  },
  "security": {
    "permissions_owner": "host",
    "untrusted_inputs": [
      "item text and supporting line (drawn as text)"
    ],
    "network_policy": "deny"
  },
  "accessibility": {
    "role": "list",
    "accessible_name": "internal",
    "keyboard": [
      "Tab",
      "ArrowUp",
      "ArrowDown",
      "Home",
      "End",
      "Enter",
      "F2",
      "Shift+F10",
      "ContextMenu"
    ],
    "focus": "One Tab stop for the whole list: the row last moved to, else the open one, else the first. Arrows, Home and End move between rows across groups; Enter opens; F2 opens the rename field and takes the focus into it, Enter keeps, Escape gives up, and the focus comes back to the row; Shift+F10 or the menu key opens the row's actions and the menu gives the focus back. A row taken off gives the focus to its neighbour."
  },
  "presentation": {
    "themes": [
      "light",
      "dark"
    ],
    "locales": [
      "en",
      "ru"
    ],
    "responsive": [
      "desktop",
      "mobile"
    ],
    "skeleton": {
      "shape": "block",
      "while_loading": "template"
    }
  },
  "adapter": {
    "kind": "generic",
    "protocol": "simai.smart-studio-adapter.v1",
    "module": null
  },
  "artifacts": {
    "fixtures": [
      "studio.fixture.json"
    ],
    "scenarios": []
  },
  "readiness": {
    "level": "host-required",
    "required_checks": [
      "manifest",
      "loader-rule",
      "list-contract",
      "list-browser"
    ]
  },
  "compatibility": {
    "contract_schema": {
      "id": "https://simai.io/contracts/smart-component-manifest.v2.schema.json",
      "version": 2
    },
