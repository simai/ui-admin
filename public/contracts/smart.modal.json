  "ai_guidance": {
    "use_when": "Use sf-modal for one bounded task that temporarily owns the top interaction layer. It shares stack, focus return and scroll-lock ownership with ordinary Modal. Prefer center or logical inline-start/inline-end/top/bottom positions; left/right are compatibility aliases. The dialog and iframe are large surfaces on --sf-radius-default, while compact header actions retain --sf-radius--ui. Inline display stays in document flow and does not capture focus. Minimized instances remain open but leave the visible interaction stack.",
    "do_not": [
      "Do not copy generated ui-smart code",
      "Do not use Modal for a long independent workflow that belongs on its own page",
      "Do not replace semantic spacing, motion, color or radius tokens with absolute design values",
      "Do not assume remote or iframe content is trusted; the host owns CSP, permissions, errors and data decisions",
      "Do not move host data or access decisions into the component"
    ],
