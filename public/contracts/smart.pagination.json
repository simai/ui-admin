            ]
          },
          "current": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "pageSize": {
            "type": "number"
          },
          "pageCount": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "additionalProperties": true
      },
      "canonical": true
    },
    "sf-action-apply": {
      "summary": "Runtime event sf-action-apply.",
      "payload": {
        "type": "object",
        "properties": {
          "component": {
            "type": "object",
