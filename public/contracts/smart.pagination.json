          "pageSize"
        ],
        "properties": {
          "reason": {
            "enum": [
              "total",
              "last-page",
              "action-for-all"
            ]
          },
          "current": {
            "type": "number"
          },
          "pageSize": {
            "type": "number"
          }
        },
        "additionalProperties": true
      },
      "canonical": true
    },
    "sf-pagination-load-more": {
