        "type": "boolean",
        "default": false,
        "description": "Current all-items toggle value."
      },
      "action-for-all-label": {
        "type": "string",
        "default": "For all",
        "description": "Label of the all-items toggle."
      },
      "actions-label": {
        "type": "string",
        "default": "Action for the selected records",
        "description": "Accessible name of the batch-action selector."
      },
      "action-choose-label": {
        "type": "string",
        "default": "Choose an action",
        "description": "Placeholder of the batch-action selector, shown until an action is chosen."
      },
      "actions-region-label": {
        "type": "string",
        "default": "Actions for the selected",
        "description": "Accessible name of the panel that appears while rows are marked."
      },
      "clear-selection-label": {
        "type": "string",
        "default": "Clear the selection",
        "description": "Accessible name and tooltip of the control that drops the selection."
      },
      "count-known": {
        "type": "boolean",
        "default": true,
        "description": "Whether the number of records is known. A host that does not count every answer sets it false, and the view offers the number instead of showing it."
      },
      "can-count": {
        "type": "boolean",
        "default": false,
        "description": "Whether the host can count on request. Without it the view offers nothing and asks for nothing."
      },
      "counting": {
        "type": "boolean",
        "default": false,
        "description": "A count is on its way; the view shows a short wait in place of the number."
      },
      "has-next": {
        "type": "boolean",
        "default": false,
        "description": "Whether a further page exists. It is what moves forward and Show more when no total was sent."
      },
      "show-count-label": {
        "type": "string",
        "default": "Show the number",
        "description": "Text of the control that asks the host for the number."
      },
      "counting-label": {
        "type": "string",
        "default": "Counting",
        "description": "Accessible name of the short wait shown while the count is on its way."
      },
      "first-label": {
        "type": "string",
        "default": "First",
        "description": "Accessible name and tooltip of the control that goes to the first page."
      },
      "page-field-label": {
        "type": "string",
        "default": "Page:",
        "description": "Label of the field that takes a page number."
      },
      "show-more-busy": {
        "type": "boolean",
        "default": false,
        "description": "Mark the Show more control as working while the host fetches the next portion; it is disabled and shows a loader."
      }
    },
    "additionalProperties": false
  },
  "item_contract": {
    "page": "Positive one-based page number bounded by total and page-size.",
    "ellipsis": "Non-interactive indicator for omitted pages."
  },
  "contracts": {
    "navigation": {
      "const": "The visible root is a named nav; page actions are native buttons because the component emits state events instead of owning URLs."
    },
    "current": {
      "const": "Exactly one rendered page exposes aria-current=page when total is greater than zero."
    },
    "empty": {
      "const": "A zero-sized collection renders no page controls and emits no page-change."
    },
    "responsive": {
      "const": "A long desktop range keeps edge pages and static ellipses; a narrow range keeps the current page, adjacent pages and directional actions on one line."
    },
    "composition": {
      "const": "Show-more, page-size and batch-action sections remain compatible optional compositions; data loading and host actions stay outside the component."
    }
  },
