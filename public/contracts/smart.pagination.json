        "default": 0,
        "minimum": 0,
        "description": "Selected item count, clamped between zero and total."
      },
      "show-more-text": {
        "type": "string",
        "default": "Показать ещё",
        "description": "Label of the compatible show-more action."
      },
      "current": {
        "type": "integer",
        "minimum": 1,
        "default": 1,
        "description": "Current one-based page number."
      },
      "total": {
        "type": "integer",
        "minimum": 0,
        "default": 10,
        "description": "Non-negative total item count."
      },
      "page-size": {
        "type": "integer",
        "minimum": 1,
        "default": 10,
        "description": "Positive number of items per page."
      },
      "page-sizes": {
        "type": "string",
        "default": "10,20,30,40",
        "description": "Comma-separated positive page-size choices."
      },
      "show-page-size": {
        "type": "boolean",
        "default": true,
        "description": "Show the page-size selector for a non-empty collection."
      },
      "page-size-label": {
        "type": "string",
        "default": "На странице:",
        "description": "Visible and accessible label of the page-size selector."
      },
      "show-actions": {
        "type": "boolean",
        "default": true,
        "description": "Show batch actions when actions are supplied."
      },
      "actions": {
        "type": "string",
        "default": "",
        "description": "Pipe-separated compatible batch-action definitions."
      },
      "action": {
        "type": "string",
        "default": "",
