{
  "schema_version": 2,
  "id": "smart.pagination",
  "version": "1.3.3",
  "title": "Pagination",
  "summary": "Source-driven navigation for a collection split into numbered pages.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "pagination"
  ],
  "capabilities": [
    "render",
    "interaction",
    "keyboard",
    "theme",
    "responsive"
  ],
  "custom_element": "sf-pagination",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "component.pagination",
      "smart.button",
      "smart.checkbox",
      "smart.dropdown",
      "smart.icon-button",
      "smart.input",
      "smart.list-item",
      "smart.spinner"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "properties": {
      "template": {
        "type": "string",
        "default": "default",
        "description": "Template name."
      },
      "root-class": {
        "type": "string",
        "default": ""
      },
      "root-style": {
        "type": "string",
        "default": ""
      },
      "top": {
        "type": "boolean",
        "default": true,
        "description": "Show the compatible show-more section."
      },
      "middle": {
        "type": "boolean",
        "default": true,
        "description": "Show page navigation and collection summary."
      },
      "bottom": {
        "type": "boolean",
        "default": true,
        "description": "Allow the compatible batch-action section."
      },
      "top-class": {
        "type": "string",
        "default": "",
        "description": "Framework utility classes for the show-more section."
      },
      "main-class": {
        "type": "string",
        "default": "",
        "description": "Framework utility classes for the navigation section."
      },
      "bottom-class": {
        "type": "string",
        "default": "",
        "description": "Framework utility classes for the batch-action section."
      },
      "pages-label": {
        "type": "string",
        "description": "Visible label before page controls. Empty: the text of the page's language (\"Pages:\" in English)."
      },
      "page-label": {
        "type": "string",
        "description": "Accessible prefix for a numbered page action. Empty: the text of the page's language (\"Page\" in English)."
      },
      "previous-label": {
        "type": "string",
        "description": "Accessible name of the previous-page action. Empty: the text of the page's language (\"Previous page\" in English)."
      },
      "next-label": {
        "type": "string",
        "description": "Accessible name of the next-page action. Empty: the text of the page's language (\"Next page\" in English)."
      },
      "last-label": {
        "type": "string",
        "description": "Visible label of the compatible last-page action. Empty: the text of the page's language (\"Last\" in English)."
      },
      "total-label": {
        "type": "string",
        "description": "Visible label for the total item count. Empty: the text of the page's language (\"Total:\" in English)."
      },
      "selected-label": {
        "type": "string",
        "description": "Visible label for the selected item count. Empty: the text of the page's language (\"Selected:\" in English)."
      },
      "selected-count": {
        "type": "integer",
        "default": 0,
        "description": "Selected item count, clamped between zero and total.",
        "minimum": 0
      },
      "show-more-text": {
        "type": "string",
        "description": "Label of the compatible show-more action. Empty: the text of the page's language (\"Show more\" in English)."
      },
      "total": {
        "type": "integer",
        "default": 10,
        "description": "Non-negative total item count.",
        "minimum": 0
      },
      "page-size": {
        "type": "integer",
        "default": 10,
        "description": "Positive number of items per page.",
        "minimum": 1
      },
      "page-sizes": {
        "type": "string",
        "default": "10,20,30,40",
        "description": "Comma-separated positive page-size choices."
      },
      "show-page-size": {
        "type": "boolean",
        "default": true,
        "description": "Show the page-size selector for a non-empty collection."
      },
      "page-size-label": {
        "type": "string",
        "description": "Visible and accessible label of the page-size selector. Empty: the text of the page's language (\"Per page:\" in English)."
      },
      "show-actions": {
        "type": "boolean",
        "default": true,
        "description": "Show batch actions when actions are supplied."
      },
      "actions": {
        "type": "string",
        "default": "",
        "description": "Pipe-separated compatible batch-action definitions."
      },
      "action": {
        "type": "string",
        "default": "",
        "description": "Selected batch-action value."
      },
      "action-apply-text": {
        "type": "string",
        "description": "Label of the batch-action apply button. Empty: the text of the page's language (\"Apply\" in English)."
      },
      "show-action-for-all": {
        "type": "boolean",
        "default": false,
        "description": "Show the compatible all-items toggle."
      },
      "action-for-all": {
        "type": "boolean",
        "default": false,
        "description": "Current all-items toggle value."
      },
      "action-for-all-label": {
        "type": "string",
        "description": "Label of the all-items toggle. Empty: the text of the page's language (\"For all\" in English)."
      },
      "actions-label": {
        "type": "string",
        "description": "Accessible name of the batch-action selector. Empty: the text of the page's language (\"Action for the selected records\" in English)."
      },
      "action-choose-label": {
        "type": "string",
        "description": "Placeholder of the batch-action selector, shown until an action is chosen. Empty: the text of the page's language (\"Choose an action\" in English)."
      },
      "actions-region-label": {
        "type": "string",
        "description": "Accessible name of the panel that appears while rows are marked. Empty: the text of the page's language (\"Actions for the selected\" in English)."
      },
      "clear-selection-label": {
        "type": "string",
        "description": "Accessible name and tooltip of the control that drops the selection. Empty: the text of the page's language (\"Clear the selection\" in English)."
      },
      "count-known": {
        "type": "boolean",
        "default": true,
        "description": "Whether the number of records is known. A host that does not count every answer sets it false, and the view offers the number instead of showing it."
      },
      "total-exact": {
        "type": "boolean",
        "default": true,
        "description": "false when total is an estimate: the row reads «~N», the last page and the page count are not offered as exact, and the count link asks for the number (vocabulary 1.1.5 total-exact; gate 29)"
      },
      "can-count": {
        "type": "boolean",
        "default": false,
        "description": "Whether the host can count on request. Without it the view offers nothing and asks for nothing."
      },
      "counting": {
        "type": "boolean",
        "default": false,
        "description": "A count is on its way; the view shows a short wait in place of the number."
      },
      "has-next": {
        "type": "boolean",
        "default": false,
        "description": "Whether a further page exists. It is what moves forward and Show more when no total was sent."
      },
      "show-count-label": {
        "type": "string",
        "description": "Text of the control that asks the host for the number. Empty: the text of the page's language (\"Show the number\" in English)."
      },
      "counting-label": {
        "type": "string",
        "description": "Accessible name of the short wait shown while the count is on its way. Empty: the text of the page's language (\"Counting\" in English)."
      },
      "first-label": {
        "type": "string",
        "description": "Accessible name and tooltip of the control that goes to the first page. Empty: the text of the page's language (\"First\" in English)."
      },
      "page-field-label": {
        "type": "string",
        "description": "Label of the field that takes a page number. Empty: the text of the page's language (\"Page:\" in English)."
      },
      "show-more-busy": {
        "type": "boolean",
        "default": false,
        "description": "Mark the Show more control as working while the host fetches the next portion; it is disabled and shows a loader."
      },
      "size": {
        "type": "string",
        "default": "1",
        "description": "The step of the size ladder its fields, buttons, labels and page numbers take: 1, or the dense 1/2 of an admin.",
        "enum": [
          "1/2",
          "1"
        ]
      },
      "current": {
        "type": "integer",
        "default": 1,
        "description": "the page being read, from 1 (vocabulary 1.1.5 page)",
        "minimum": 1
      },
      "aria-label": {
        "type": "string",
        "default": "",
        "description": "Accessible name of the navigation landmark. Empty: the text of the page's language (\"Result pages\" in English)."
      }
    },
    "additionalProperties": false
  },
  "item_contract": {
    "page": "Positive one-based page number bounded by total and page-size.",
    "ellipsis": "Non-interactive indicator for omitted pages."
  },
  "contracts": {
    "navigation": {
      "const": "The visible root is a named nav; page actions are native buttons because the component emits state events instead of owning URLs."
    },
    "current": {
      "const": "Exactly one rendered page exposes aria-current=page when total is greater than zero."
    },
    "empty": {
      "const": "A zero-sized collection renders no page controls and emits no page-change."
    },
    "responsive": {
      "const": "A long desktop range keeps edge pages and static ellipses; a narrow range keeps the current page, adjacent pages and directional actions on one line."
    },
    "composition": {
      "const": "Show-more, page-size and batch-action sections remain compatible optional compositions; data loading and host actions stay outside the component."
    }
  },
  "methods": {
    "goToPage": {
      "summary": "Moves to a page: the number is parsed as an integer and clamped to 1..pageCount when the count is known (only to at least 1 when it is not). Emits sf-pagination-change when the page actually changes; does nothing when the total is a known zero.",
      "arguments": [
        {
          "name": "page",
          "schema": {
            "type": "number"
          }
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "showMore": {
      "summary": "Emits sf-pagination-load-more with the current paging and the given item; performs no request and changes no state.",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "getTopSection": {
      "summary": "Returns the top section element (.sf-pagination-top), or null when it is not rendered.",
      "arguments": [],
      "returns": {
        "type": [
          "object",
          "null"
        ]
      }
    },
    "getMainSection": {
      "summary": "Returns the main section element (.sf-pagination-main), or null when it is not rendered.",
      "arguments": [],
      "returns": {
        "type": [
          "object",
          "null"
        ]
      }
    },
    "getBottomSection": {
      "summary": "Returns the bottom section element (.sf-pagination-bottom), or null when it is not rendered.",
      "arguments": [],
      "returns": {
        "type": [
          "object",
          "null"
        ]
      }
    },
    "setPageSize": {
      "summary": "Sets a positive page size, keeps the current page within the new page count and emits sf-pagination-size-change. A non-positive, non-numeric or unchanged size is ignored.",
      "arguments": [
        {
          "name": "size",
          "type": "number|string",
          "required": true
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "setAction": {
      "summary": "Selects a batch action by value (an empty value clears the choice) and emits sf-pagination-action-change when it differs from the current one.",
      "arguments": [
        {
          "name": "action",
          "type": "string",
          "required": true
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "setActionForAll": {
      "summary": "Sets whether the batch action applies to every record under the filter and emits sf-pagination-action-for-all-change. Turning it on also requests the count (sf-pagination-count with reason action-for-all) when the count is not yet known.",
      "arguments": [
        {
          "name": "value",
          "type": "boolean",
          "required": true
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "setState": {
      "summary": "Writes each key as its kebab-case attribute: false, null, undefined or an empty string removes the attribute, true sets it empty, anything else is stringified.",
      "arguments": [
        {
          "name": "nextState",
          "type": "object",
          "required": true
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "onPageChange": {
      "summary": "Adds a listener for sf-pagination-change; the handler is called with (current, detail, event). Ignores a non-function handler.",
      "arguments": [
        {
          "name": "handler",
          "type": "function",
          "required": true
        },
        {
          "name": "options",
          "type": "object|boolean",
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "onShowMore": {
      "summary": "Adds a listener for sf-pagination-load-more; the handler is called with (detail, event). Ignores a non-function handler.",
      "arguments": [
        {
          "name": "handler",
          "type": "function",
          "required": true
        },
        {
          "name": "options",
          "type": "object|boolean",
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    }
  },
  "events": {
    "sf-pagination-change": {
      "summary": "change (vocabulary).",
      "payload": {
        "type": "object",
        "required": [
          "previous",
          "current",
          "total",
          "pageCount",
          "pageSize"
        ],
        "properties": {
          "previous": {
            "type": "number"
          },
          "current": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "pageCount": {
            "type": [
              "number",
              "null"
            ]
          },
          "pageSize": {
            "type": "number"
          }
        },
        "additionalProperties": true
      },
      "canonical": true
    },
    "sf-pagination-size-change": {
      "summary": "size-change (vocabulary).",
      "payload": {
        "type": "object",
        "required": [
          "previous",
          "pageSize",
          "current",
          "total",
          "pageCount"
        ],
        "properties": {
          "previous": {
            "type": "number"
          },
          "pageSize": {
            "type": "number"
          },
          "current": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "pageCount": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "additionalProperties": true
      },
      "canonical": true
    },
    "sf-pagination-count": {
      "summary": "count (vocabulary).",
