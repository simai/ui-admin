{
  "schema_version": 2,
  "id": "smart.progress-bar",
  "version": "1.3.2",
  "title": "Progress Bar",
  "summary": "Continuous determinate progress with normalized value, accessible range semantics and explicit semantic tone.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "progress-bar"
  ],
  "capabilities": [
    "render",
    "theme",
    "responsive",
    "determinate-progress",
    "accessible-range",
    "indeterminate-progress"
  ],
  "custom_element": "sf-progress-bar",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "component.progress-bar"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "properties": {
      "template": {
        "type": "string",
        "default": "default",
        "description": "Template variant name for SfBaseElement external templates."
      },
      "root-class": {
        "type": "string",
        "default": "",
        "description": "Classes added to the root element the component draws."
      },
      "root-style": {
        "type": "string",
        "default": "",
        "description": "Inline style declarations set on the root element the component draws, custom properties included."
      },
      "size": {
        "type": "string",
        "default": "1",
        "enum": [
          "1/3",
          "1/2",
          "1",
          "2",
          "3"
        ]
      },
      "value": {
        "type": "number",
        "default": 0,
        "minimum": 0,
        "maximum": 100,
        "pattern": "^(?:100|[1-9]?[0-9])(?:\\.[0-9]+)?$"
      },
      "text-position": {
        "type": "string",
        "default": "none",
        "enum": [
          "none",
          "inline-end",
          "bottom",
          "right"
        ]
      },
      "status": {
        "type": "string",
        "default": "neutral",
        "description": "What the progress reports, in the shared status vocabulary. The word this component used before, primary, is still accepted and means neutral. With warning-at or error-at the bar takes the more serious of this status and the threshold the value reached.",
        "enum": [
          "neutral",
          "info",
          "success",
          "warning",
          "error"
        ]
      },
      "warning-at": {
        "type": "number",
        "description": "A threshold in per cent: from this value on, the bar is a warning by itself (a disk 83 % full of a warning-at 80). The page sets the threshold; the bar only compares. Unset, no threshold.",
        "minimum": 0,
        "maximum": 100
      },
      "error-at": {
        "type": "number",
        "description": "A threshold in per cent: from this value on, the bar is an error by itself. Above warning-at when both are set. Unset, no threshold.",
        "minimum": 0,
        "maximum": 100
      },
      "indeterminate": {
        "type": "boolean",
        "default": false,
        "description": "The work runs and its size is not known yet: a segment of the fill crosses the track and the value is not read (aria-valuenow is left out). The page takes it off once the size is known and the same bar fills from the value, once (C34). Reduced motion: the segment stands still."
      },
      "paused": {
        "type": "boolean",
        "default": false,
        "description": "The work is paused: the bar is a warning (unless its status or a threshold says error) and says so to a screen reader: the value text reads «35 %, на паузе» / «35%, paused» when the page gives no value-text (C34). The page sets it where the work really stopped."
      },
      "label": {
        "type": "string",
        "default": ""
      },
      "value-text": {
        "type": "string",
        "default": ""
      },
      "aria-label": {
        "type": "string",
        "default": ""
      },
      "tone": {
        "type": "string",
        "default": "neutral",
        "description": "Legacy name for status, still honoured. See contracts/public-api-axes.json.",
        "enum": [
          "neutral",
          "info",
          "success",
          "warning",
          "error"
        ]
      }
    },
    "additionalProperties": false
  },
  "item_contract": {},
  "contracts": {},
  "methods": {
    "chunk": {
      "summary": "The action chunk.",
      "arguments": [
        {
          "name": "args",
          "type": "object",
          "required": true,
          "schema": {
            "type": "object",
            "properties": {
              "done": {
                "type": "number"
              },
              "total": {
                "type": "number"
              }
            },
            "required": [
              "done",
              "total"
            ]
          }
        }
      ],
      "returns": {
        "type": "object"
      }
    },
    "getProgress": {
      "summary": "Returns the value attribute as a number (0 when absent); it is not clamped.",
      "arguments": [],
      "returns": {
        "type": "number"
      }
    },
    "setProgress": {
      "summary": "Sets the value attribute; null or undefined removes it.",
      "arguments": [
        {
          "name": "nextValue",
          "type": "number|string",
          "required": true
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "setTextPosition": {
      "summary": "Sets text-position; null or undefined removes it.",
      "arguments": [
        {
          "name": "nextValue",
          "type": "string",
          "required": true
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    }
  },
  "events": {},
  "state": {
    "machines": {
      "progress": [
        "active",
        "complete",
        "error"
      ]
    },
    "visual_states": [
      "default"
    ]
  },
  "persistence": {
    "mode": "none",
    "source_of_truth": "component",
    "network_owner": "none",
    "revision_field": null
  },
  "ownership": {
    "source": "simai/ui-source",
    "data": "host",
    "effects": "component",
    "forbidden_client_responsibilities": [
      "backend access decisions",
      "host route invention",
      "running, cancelling or retrying the task",
      "inventing thresholds: warning or error from the percentage only where the page set warning-at or error-at",
      "inventing the accessible process label"
    ]
  },
  "security": {
    "permissions_owner": "none",
    "untrusted_inputs": [
      "props",
      "children"
    ],
    "network_policy": "deny"
  },
  "accessibility": {
    "role": "progressbar",
    "accessible_name": "required",
    "keyboard": [],
    "focus": "Progress Bar is not interactive and never enters the focus order."
  },
  "presentation": {
    "themes": [
      "light",
      "dark"
    ],
    "locales": [
      "ru",
      "en"
    ],
    "responsive": [
      "desktop",
      "mobile"
    ],
    "skeleton": {
      "shape": "none",
      "while_loading": "none"
    }
  },
  "adapter": {
    "kind": "generic",
    "protocol": "simai.smart-studio-adapter.v1",
    "module": null
  },
  "artifacts": {
    "fixtures": [
      "studio.fixture.json"
    ],
    "scenarios": [
      "studio.scenario.json"
    ]
  },
  "readiness": {
    "level": "described",
    "required_checks": [
      "manifest",
      "fixture",
      "runtime-upgrade",
      "scenario-smoke"
    ]
  },
  "compatibility": {
    "contract_schema": {
      "id": "https://simai.io/contracts/smart-component-manifest.v2.schema.json",
      "version": 2
    },
    "runtime_pair": {
      "ui_revision": "094f3d549aa7921d2d7f8773972c73711dd6a72e",
      "ui_smart_revision": "856fb5d751fad1c76104c32515f4c1869dd75b6c"
    },
    "aliases": [],
