  "ai_guidance": {
    "use_when": "Use sf-progress-bar for continuous progress with a value from 0 to 100, or indeterminate while the size of the work is not known.",
    "do_not": [
      "Do not copy generated ui-smart code",
      "Do not move host data or access decisions into the component",
      "Do not use Progress Bar for an unknown value without indeterminate; set indeterminate until the size is known, or use Spinner",
      "Do not omit a localized accessible label",
      "Do not infer semantic tone from the percentage in the page; give the bar warning-at and error-at and let it compare",
      "Do not make the progress indicator focusable"
    ],
    "required_reads": [
      "inputs",
      "methods",
      "events",
      "ownership",
      "provenance"
    ],
    "minimal_example": "<sf-progress-bar label=\"Загрузка файлов\" value=\"40\"></sf-progress-bar>",
    "owner_commands": [
      "npm run contract:verify",
      "npm test"
    ]
  }
}
