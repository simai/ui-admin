{
  "schema_version": 2,
  "id": "smart.progress-scale",
  "version": "1.0.0",
  "title": "Progress Scale",
  "summary": "Segmented determinate progress with exact accessible value, explicit semantic tone and ten visual steps.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "progress-scale"
  ],
  "capabilities": [
    "render",
    "theme",
    "responsive",
    "determinate-progress",
    "accessible-range"
  ],
  "custom_element": "sf-progress-scale",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "component.progress-scale"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "properties": {
      "template": {
        "type": "string",
        "default": "default",
        "enum": [
          "default"
        ]
      },
      "size": {
        "type": "string",
        "default": "1",
        "enum": [
          "1/3",
          "1/2",
          "1",
          "2",
          "3"
        ]
      },
      "value": {
        "type": "string",
        "default": "0",
        "pattern": "^(?:100|[1-9]?[0-9])(?:\\.[0-9]+)?$"
      },
      "show-text": {
        "type": "boolean",
        "default": true
      },
      "tone": {
        "type": "string",
        "default": "primary",
        "enum": [
          "primary",
          "success",
          "warning",
          "error"
        ]
      },
      "label": {
        "type": "string",
        "default": ""
      },
      "value-text": {
        "type": "string",
        "default": ""
      }
    },
    "additionalProperties": false
  },
  "item_contract": {},
  "contracts": {},
  "methods": {
    "getProgress": {
      "summary": "Public runtime method getProgress.",
      "arguments": [],
      "returns": {
        "type": [
          "object",
          "boolean",
          "null"
        ]
      }
    },
    "setProgress": {
      "summary": "Public runtime method setProgress.",
      "arguments": [],
      "returns": {
        "type": [
          "object",
          "boolean",
          "null"
        ]
      }
    }
  },
  "events": {},
  "state": {
    "machines": {
      "progress": [
        "active",
        "complete",
        "error"
      ]
    },
    "visual_states": [
      "default"
    ]
  },
  "persistence": {
    "mode": "none",
