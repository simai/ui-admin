{
  "schema_version": 2,
  "id": "smart.reference-link",
  "version": "1.0.0",
  "title": "Reference Link",
  "summary": "Navigation surface that pairs a real destination with a compact reference.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "reference-link"
  ],
  "capabilities": [
    "render",
    "theme",
    "responsive"
  ],
  "custom_element": "sf-reference-link",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "component.reference-link",
      "smart.icons"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "properties": {
      "appearance": {
        "type": "string",
        "enum": [
          "card",
          "plain"
        ],
        "default": "card",
        "description": "card is the reference as its own box: frame, fill and padding. plain is the link alone, taking the width of its text, for a reference inside something that is already a box -- a record’s field, a table cell -- where a second frame reads as a control the value is not."
      },
      "aria-label": {
        "type": "string",
        "default": ""
      },
      "disabled": {
        "type": "boolean",
        "default": false,
        "description": "Render an unavailable, non-focusable reference without navigation."
      },
      "href": {
        "type": "string",
        "default": "",
        "description": "Real navigation destination. Required for an enabled reference."
      },
      "icon": {
        "type": "string",
        "default": "arrow_forward",
        "description": "Decorative icon name. An absent attribute is the arrow; an empty one draws no icon, for a reference that stands beside its own label."
      },
      "label": {
        "type": "string",
        "default": "",
        "description": "Destination-oriented visible link label."
      },
      "line": {
        "type": "string",
        "default": "",
        "enum": [
          "",
          "1/2",
          "1",
          "2"
        ],
        "description": "Takes the text line of this form size as a link without the card, for a table cell, so the row keeps its control height."
      },
      "size": {
        "type": "string",
        "default": "",
        "enum": [
          "",
          "1/2",
          "1",
          "2"
        ],
        "description": "Form size: the reference becomes a control of that size, for a row of fields or a table cell. Empty keeps the card spacing."
      },
      "target": {
        "type": "string",
        "default": "_self",
        "description": "Native browsing-context target. Disclose new-context navigation in the name."
      },
      "template": {
        "type": "string",
        "default": "default",
        "enum": [
          "default"
        ]
      },
      "text": {
        "type": "string",
        "default": "",
        "description": "Compact route, source or reference shown beside the label."
      }
    },
    "additionalProperties": false
  },
  "item_contract": {},
  "contracts": {
    "navigation": {
      "enabled": "native anchor with a real href",
      "disabled": "non-interactive content with no href",
      "boundary": "the complete reference surface is the pointer and keyboard-focus boundary"
    },
    "canonical_elements": {
      "type": "string",
      "enum": [
        "sf-reference-link__main",
        "sf-reference-link__link",
        "sf-reference-link__icon",
        "sf-reference-link__meta"
      ]
    },
    "interaction_states": {
      "type": "string",
      "enum": [
        "hover",
        "active",
        "focus-visible"
      ]
    }
  },
  "methods": {
    "onClick": {
      "summary": "Public runtime method onClick.",
      "arguments": [],
      "returns": {
        "type": [
          "object",
          "boolean",
          "null"
        ]
      }
    }
  },
  "events": {},
  "state": {
    "machines": {},
    "visual_states": [
      "default",
      "active",
      "disabled"
    ]
  },
  "persistence": {
    "mode": "none",
    "source_of_truth": "component",
    "network_owner": "none",
    "revision_field": null
  },
  "ownership": {
    "source": "simai/ui-source",
    "data": "fixture",
    "effects": "component",
    "forbidden_client_responsibilities": [
      "backend access decisions",
      "host route invention"
    ]
  },
  "security": {
