  "ai_guidance": {
    "use_when": "Use sf-resizer when a person should widen or narrow a panel, a menu column or a side area by its edge. Put it inside the panel; give min and max; write the width to the variable the panel's stylesheet reads.",
    "do_not": [
      "Do not copy generated ui-smart code",
      "Do not rely on pointer dragging alone; keep the keyboard path",
      "Do not save the width on a server from the component; listen to sf-resize"
    ],
    "required_reads": [
      "inputs",
      "events",
      "accessibility",
      "provenance"
    ],
    "minimal_example": "<nav style=\"position:relative; inline-size: var(--menu-width, 16rem)\"><sf-resizer min=\"13rem\" max=\"24rem\" property=\"--menu-width\" storage-key=\"menu\" label=\"Menu width\"></sf-resizer></nav>",
    "owner_commands": [
      "npm run contract:verify",
      "npm test"
    ]
  }
}
