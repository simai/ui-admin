        "sha256": "b83228dff112c7e3f0cb8f5be37e44a9c9281615e839bca10b2b1e88557b6336"
      },
      {
        "path": "src/smart/resizer/rule.js",
        "sha256": "dba7fc18309d260feb0cb0dc343ddde289ad68af8c99c750716d7c12175b69aa"
