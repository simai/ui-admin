{
  "schema_version": 2,
  "id": "smart.resizer",
  "version": "1.0.0",
  "title": "Resizer",
  "summary": "A handle on a panel's edge that changes the panel's width by a drag, the keyboard or a double click back to the default, within limits; optionally remembered in the browser.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "resizer",
    "splitter",
    "layout"
  ],
  "capabilities": [
    "interaction",
    "keyboard",
    "responsive"
  ],
  "custom_element": "sf-resizer",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "properties": {
      "min": {
        "type": "string",
        "default": "12rem",
        "description": "The narrowest width, a CSS length (tokens and percentages of the panel's parent too)."
      },
      "max": {
        "type": "string",
        "default": "40rem",
        "description": "The widest width, a CSS length."
      },
      "property": {
        "type": "string",
        "default": "",
        "description": "A CSS custom property the width is written to on the target; empty writes inline-size."
      },
      "target": {
        "type": "string",
        "default": "",
        "description": "A selector of the closest ancestor that is the panel; empty is the parent."
      },
      "edge": {
        "type": "string",
        "default": "inline-end",
        "enum": [
          "inline-end",
          "inline-start"
        ]
      },
      "step": {
        "type": "string",
        "default": "16",
        "description": "Pixels an arrow key moves; Shift moves four steps."
      },
      "storage-key": {
        "type": "string",
        "default": "",
        "description": "Remembers the width in this browser under sf-resizer:<key>; a double click forgets it."
      },
      "label": {
        "type": "string",
        "default": "",
        "description": "The accessible name; defaults to the page language's «Resize»."
      },
      "disabled": {
        "type": "boolean",
        "default": false
      }
    },
    "additionalProperties": false
  },
  "contracts": {},
  "methods": {},
  "events": {
    "sf-resize": {
      "summary": "The width changed: while dragging (move), after a drag or a key (end), or back to the stylesheet's width (reset).",
      "payload": {
        "type": "object",
        "required": [
          "width",
          "phase"
        ],
        "properties": {
          "width": {
            "type": "number"
          },
          "phase": {
            "enum": [
              "move",
              "end",
              "reset"
            ]
          }
        }
      }
    }
  },
  "state": {
    "machines": {
      "drag": [
        "idle",
        "resizing"
      ]
    },
    "visual_states": [
      "default",
      "active",
      "disabled"
    ]
  },
  "persistence": {
    "mode": "none",
    "source_of_truth": "host",
    "network_owner": "none",
    "revision_field": null
  },
  "ownership": {
    "source": "simai/ui-source",
    "data": "host",
    "effects": "host",
    "forbidden_client_responsibilities": [
      "backend access decisions",
      "saving the width on a server"
    ]
  },
  "security": {
    "permissions_owner": "host",
    "untrusted_inputs": [
      "props",
      "children"
    ],
    "network_policy": "deny"
  },
  "accessibility": {
    "role": "separator",
    "accessible_name": "recommended",
    "keyboard": [
      "ArrowLeft",
      "ArrowRight",
      "Home",
      "End",
      "PageUp",
      "PageDown",
      "Enter",
      "Space"
    ],
    "focus": "The handle is in the tab order with role separator, aria-orientation vertical and aria-valuenow/min/max in pixels. Arrows change the width by a step (Shift: four), Home and End set a limit, Enter, Space and a double click restore the stylesheet's width."
  },
  "presentation": {
    "themes": [
      "light",
      "dark"
    ],
    "locales": [
      "ru",
      "en"
    ],
    "responsive": [
      "desktop",
      "mobile",
      "ltr",
      "rtl",
      "reduced-motion"
    ]
  },
  "adapter": {
    "kind": "generic",
    "protocol": "simai.smart-studio-adapter.v1",
    "module": null
  },
  "artifacts": {
    "fixtures": [
      "studio.fixture.json"
    ],
    "scenarios": [
      "studio.scenario.json"
    ]
  },
  "readiness": {
    "level": "runnable",
    "required_checks": [
      "manifest",
      "fixture",
      "runtime-upgrade",
      "scenario-smoke",
      "keyboard",
      "responsive",
      "a11y"
    ]
  },
  "compatibility": {
    "contract_schema": {
      "id": "https://simai.io/contracts/smart-component-manifest.v2.schema.json",
      "version": 2
    },
    "runtime_pair": {
      "ui_revision": "094f3d549aa7921d2d7f8773972c73711dd6a72e",
      "ui_smart_revision": "856fb5d751fad1c76104c32515f4c1869dd75b6c"
    },
    "aliases": [],
    "deprecations": [],
    "replacement": null,
    "migrations": []
  },
  "provenance": {
    "source_repository": "simai/ui-source",
    "source_revision": "d73527c92056a684b5f34a46ec7315e1ded9be19",
    "source_artifacts": [
      {
