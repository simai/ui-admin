  "ai_guidance": {
    "use_when": "Use sf-sortable when people reorder or move host items, or drag library entries onto an editor canvas. Apply sf-sortable-intent to the host model with an expected revision; a refusal leaves the page unchanged. Give inserter-items when people insert new items at a place in the list; create the item on sf-sortable-insert.",
    "do_not": [
      "Do not copy generated ui-smart code",
      "Do not let the component move host DOM or save data",
      "Do not rely on pointer dragging alone; keep the keyboard path",
      "Do not bundle a private drag session; use SF.Sortable.registerSortableDropTarget",
      "Do not let the component create the inserted item; add it on sf-sortable-insert"
    ],
    "required_reads": [
      "inputs",
      "item_contract",
      "events",
      "ownership",
      "provenance",
      "contracts"
    ],
    "minimal_example": "<sf-sortable id=\"sections\" group=\"sections\" label=\"Sections\"><div data-sf-sortable-item=\"s1\">Section 1</div><div data-sf-sortable-item=\"s2\">Section 2</div></sf-sortable>",
    "owner_commands": [
      "npm run contract:verify",
      "npm test"
    ]
  }
}
