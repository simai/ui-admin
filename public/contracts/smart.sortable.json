{
  "schema_version": 2,
  "id": "smart.sortable",
  "version": "1.1.3",
  "title": "Drag and drop",
  "summary": "A list whose items move by pointer, touch and keyboard, between lists of a group and onto registered drop targets; it asks the host to move and never moves the host's DOM or data.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "sortable",
    "drag-and-drop",
    "editor",
    "inserter"
  ],
  "capabilities": [
    "interaction",
    "keyboard",
    "responsive"
  ],
  "custom_element": "sf-sortable",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "component.icon-buttons",
      "component.icons",
      "smart.context-menu"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "properties": {
      "template": {
        "type": "string",
        "default": "default",
        "description": "Template variant name for SfBaseElement external templates."
      },
      "root-class": {
        "type": "string",
        "default": ""
      },
      "root-style": {
        "type": "string",
        "default": ""
      },
      "group": {
        "type": "string",
        "default": "",
        "description": "The list's group: an item moves between lists of one group; required for a list whose items move",
        "pattern": "^[a-z][a-z0-9-]{0,31}$"
      },
      "accepts": {
        "type": "string",
        "default": "",
        "description": "Other groups whose items this list takes, separated by spaces"
      },
      "mode": {
        "type": "string",
        "default": "move",
        "description": "copy: a library list; its items are copied out and stay",
        "enum": [
          "move",
          "copy"
        ]
      },
      "orientation": {
        "type": "string",
        "default": "vertical",
        "enum": [
          "vertical",
          "horizontal"
        ]
      },
      "label": {
        "type": "string",
        "default": "",
        "description": "The list's name in what is announced"
      },
      "preview": {
        "type": "string",
        "default": "silhouette",
        "description": "silhouette opens a gap the size of the item; line draws a line",
        "enum": [
          "silhouette",
          "line"
        ]
      },
      "inserter-items": {
        "type": "string",
        "default": "",
        "description": "The items an insertion point offers, as JSON [{item, label, icon?, description?}]; empty: no insertion point"
      },
      "aria-label": {
        "type": "string",
        "default": ""
      }
    },
    "additionalProperties": false
  },
  "item_contract": {
    "type": "object",
    "description": "Descendants with data-sf-sortable-item=\"<id>\" are items; an optional data-sf-sortable-handle inside an item limits dragging to the handle and is the touch target.",
    "properties": {
      "attribute": {
        "const": "data-sf-sortable-item"
      },
      "handle": {
        "const": "data-sf-sortable-handle"
      }
    }
  },
  "contracts": {
    "drop_targets": {
      "type": "object",
      "description": "SF.Sortable.registerSortableDropTarget({resolve, keyboardTargets, drop, leave}) joins non-list targets such as sf-composition-overlay to the same drag session; the session is shared across Smart bundles. Once loaded, SF.Sortable exposes SORTABLE_INTENT_EVENT, SORTABLE_STATE_EVENT, activeSortableSession, registerSortableDropTarget and sortableIndexAt."
    },
    "inserter": {
      "type": "object",
      "description": "The insertion point is one native icon button (size 1/3), the list's last tab stop, placed on the gap a pointer is near, after a focused row, or where its arrow keys put it. It opens sf-context-menu (openFor, local search over label, caption and keywords) anchored to the point. The component never creates the inserted item: it raises sf-sortable-insert and the host adds the item. Escape closes only the inserter, the innermost open surface (core open-surface-mark). Once loaded, SF.Sortable exposes SORTABLE_INSERT_EVENT.",
      "properties": {
        "property": {
          "const": "inserterItems"
        },
        "attribute": {
          "const": "inserter-items"
        },
        "item": {
          "type": "object",
          "required": [
            "value",
            "label"
          ],
          "properties": {
            "value": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "icon": {
              "type": "string"
            },
            "caption": {
              "type": "string"
            },
            "keywords": {
              "type": "string"
            },
            "disabled": {
              "type": "boolean"
            }
          }
        }
      }
    }
  },
  "methods": {},
  "events": {
    "sf-sortable-move": {
      "summary": "The request to move (or copy) an item to a place: one manual move of vocabulary 1.1.5 §5 move, {id, parent, position} named item, to and index; the host applies it",
      "payload": {
        "type": "object",
        "required": [
          "item",
          "from",
          "to",
          "index",
          "mode"
        ],
        "properties": {
          "item": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "index": {
            "type": "number"
          },
          "mode": {
            "enum": [
              "move",
              "copy"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "sf-sortable-state": {
      "summary": "A drag's step: picked up, dropped or cancelled",
      "payload": {
        "type": "object",
        "required": [
          "state",
          "item"
        ],
        "properties": {
          "state": {
            "enum": [
              "picked",
              "dropped",
              "cancelled"
            ]
          },
          "item": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "sf-sortable-insert": {
      "summary": "The inserter's request to put a new item of the palette at a place; cancelable",
      "payload": {
        "type": "object",
        "required": [
          "index",
          "item",
          "to"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "item": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "sf-sortable-intent": {
      "summary": "The person dropped an item; the host applies or refuses the change.",
      "payload": {
        "type": "object",
        "required": [
          "item",
          "from",
          "to",
          "index",
          "mode"
        ],
        "properties": {
          "item": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "mode": {
            "enum": [
              "move",
              "copy"
            ]
          }
        }
      }
    }
  },
  "state": {
    "machines": {
      "drag": [
        "idle",
        "picked",
        "dropped",
        "cancelled"
      ],
      "inserter": [
        "closed",
        "open"
      ]
    },
    "visual_states": [
      "default",
      "active",
      "open"
    ]
  },
  "persistence": {
    "mode": "none",
    "source_of_truth": "host",
    "network_owner": "none",
    "revision_field": null
  },
  "ownership": {
    "source": "simai/ui-source",
    "data": "host",
    "effects": "host",
    "forbidden_client_responsibilities": [
      "backend access decisions",
      "host route invention",
      "saving or reordering host data",
      "creating the inserted item"
    ]
  },
  "security": {
    "permissions_owner": "host",
    "untrusted_inputs": [
      "props",
      "children"
    ],
    "network_policy": "deny"
  },
  "accessibility": {
    "role": "none",
    "accessible_name": "recommended",
    "keyboard": [
      "Space",
      "Enter",
      "ArrowUp",
      "ArrowDown",
      "ArrowLeft",
      "ArrowRight",
      "Escape",
      "Tab",
      "+",
      "Home",
      "End"
    ],
    "focus": "Items become focusable and describe the instructions. Space or Enter picks up, arrows move within a list and to other accepting lists or external targets, Space or Enter drops, Escape or Tab cancels. Every step is announced in a polite live region in the page language. With inserter items, + on a focused row opens the inserter for the place after it, and the insertion point is the list's last tab stop: arrows move it between places, Home and End go to the first and the last, Enter or Space opens the inserter; in the inserter typing filters, arrows and Enter choose, Escape closes it and returns focus."
  },
  "presentation": {
    "themes": [
      "light",
      "dark"
    ],
    "locales": [
      "ru",
      "en"
    ],
    "responsive": [
      "desktop",
      "mobile",
      "ltr",
      "rtl",
      "reduced-motion"
    ],
    "skeleton": {
      "shape": "none",
      "while_loading": "none"
    }
  },
  "adapter": {
    "kind": "generic",
    "protocol": "simai.smart-studio-adapter.v1",
    "module": null
  },
  "artifacts": {
    "fixtures": [
      "studio.fixture.json"
    ],
    "scenarios": [
      "studio.scenario.json"
    ]
  },
  "readiness": {
    "level": "runnable",
    "required_checks": [
      "manifest",
      "fixture",
      "runtime-upgrade",
      "scenario-smoke",
      "keyboard",
      "responsive",
      "a11y"
    ]
  },
  "compatibility": {
    "contract_schema": {
      "id": "https://simai.io/contracts/smart-component-manifest.v2.schema.json",
      "version": 2
    },
    "runtime_pair": {
      "ui_revision": "094f3d549aa7921d2d7f8773972c73711dd6a72e",
      "ui_smart_revision": "856fb5d751fad1c76104c32515f4c1869dd75b6c"
    },
    "aliases": [],
    "deprecations": [],
    "replacement": null,
    "migrations": []
  },
  "provenance": {
    "source_repository": "simai/ui-source",
    "source_revision": "95b7c37d027ee436ed1ff8e7fbba3688f34f9c3f",
    "source_artifacts": [
      {
        "path": "src/smart/sortable/index.js",
        "sha256": "c807f90dfbc0064c497bf43aae9238eb7c19e2d7114c0828cff6b436cc34cf34"
      },
      {
        "path": "src/smart/sortable/scss/_smart__sortable.scss",
        "sha256": "dff4655fc5611feafee44ce1f77b3b5f00405a4add5a2b8efae11d6336613748"
      },
      {
        "path": "src/smart/sortable/rule.js",
        "sha256": "879aa49480db913c8c3274366845be6d7784e131dcb65d38bcb24f5cad25de9e"
