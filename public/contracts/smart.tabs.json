{
  "schema_version": 2,
  "id": "smart.tabs",
  "version": "1.0.0",
  "title": "Tabs",
  "summary": "A tab list that shows one local panel at a time, with text or icon tabs given as attributes, slots or data, roving keyboard focus and linked tab panels.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "tabs"
  ],
  "capabilities": [
    "render",
    "interaction",
    "keyboard",
    "theme",
    "responsive"
  ],
  "custom_element": "sf-tabs",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "component.tabs",
      "smart.buttons",
      "smart.icon-buttons"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "properties": {
      "template": {
        "type": "string",
        "default": "default"
      },
      "type": {
        "type": "string",
        "default": null
      },
      "size": {
        "type": "string",
        "default": "1"
      },
      "variant": {
        "type": "string",
        "default": "buttons"
      },
      "scheme": {
        "type": "string",
        "default": "default",
        "description": "Built-in button appearance: default, outline or link. Historical name retained; this is not a semantic color selector. Custom templates may interpret it separately."
      },
      "top-position": {
        "type": "string",
        "default": "start"
      },
      "active-index": {
        "type": "number",
        "default": 0
      },
      "items": {
        "type": "string",
        "default": []
      },
      "root-class": {
        "type": "string",
        "default": ""
      },
      "top-class": {
        "type": "string",
        "default": ""
      },
      "panel-class": {
        "type": "string",
        "default": ""
      }
    },
    "additionalProperties": false
  },
  "item_contract": {},
  "contracts": {},
  "methods": {
    "getData": {
      "summary": "Returns the data set with setData: {tabs, panels, ...}; {tabs: [], panels: []} when none was set.",
      "arguments": [],
      "returns": {
        "type": "object"
      }
    },
    "setData": {
      "summary": "Merges data into the current data (a function receives the current data and returns the next) and re-renders. tabs or items become tab items; panels or content become panels. A non-object is ignored.",
      "arguments": [
        {
          "name": "data",
          "type": "object|function",
          "required": true
        },
        {
          "name": "reason",
          "type": "string",
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "setItems": {
      "summary": "Replaces the tabs in the data (a function receives the current tabs) and re-renders.",
      "arguments": [
        {
          "name": "items",
          "type": "array|function",
          "required": true
        },
        {
          "name": "reason",
          "type": "string",
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "setPanels": {
      "summary": "Replaces the panels in the data (a function receives the current panels) and re-renders.",
      "arguments": [
        {
          "name": "panels",
          "type": "array|function",
          "required": true
        },
        {
          "name": "reason",
          "type": "string",
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "setState": {
      "summary": "Writes each key as its kebab-case attribute; an array (items) is serialised as label::flags entries joined by |. false, null, undefined or empty removes the attribute, true sets it empty.",
      "arguments": [
        {
          "name": "nextState",
          "type": "object",
          "required": true
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "goTo": {
      "summary": "Activates the tab at index (an index out of range means 0); does nothing for a disabled or the active tab. Sets active-index and emits sf-tab-change.",
      "arguments": [
        {
          "name": "index",
          "type": "number|string",
          "required": true
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "onTabChange": {
      "summary": "Adds a listener for sf-tab-change; the handler is called with (current, detail, event). Ignores a non-function handler.",
      "arguments": [
        {
          "name": "handler",
          "type": "function",
          "required": true
        },
        {
          "name": "options",
          "type": "object|boolean",
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    }
  },
  "events": {
    "sf-tab-change": {
      "summary": "Runtime event sf-tab-change.",
      "payload": {
        "type": "object",
        "properties": {
          "component": {
            "type": "object",
            "description": "The emitting element."
          },
          "tagName": {
            "type": "string"
          },
          "template": {
            "type": "string"
          },
          "previous": {
            "type": "number"
          },
          "current": {
            "type": "number"
          },
          "item": {
            "type": "object",
            "description": "A normalised tab item: label plus what was given (disabled, icon, component and so on)."
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "A normalised tab item: label plus what was given (disabled, icon, component and so on)."
            }
          }
        },
        "required": [
          "component",
          "tagName",
          "template",
          "previous",
          "current",
          "item",
          "items"
        ]
      }
    }
  },
