    "accessibility"
  ],
  "custom_element": "sf-tag",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "component.avatars",
      "component.dot",
      "smart.icon-buttons",
      "component.tags"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "properties": {
      "template": {
        "type": "string",
        "default": "default",
        "enum": [
          "default"
        ],
        "description": "Template name."
      },
      "type": {
        "type": "string",
        "default": "checkbox",
        "enum": [
          "checkbox",
          "icon",
          "default",
          "color",
          "avatar",
          "success",
          "error",
          "warning"
        ],
        "description": "Tag content and behavior type."
      },
      "size": {
        "type": "string",
        "default": "1/2",
        "enum": [
          "1/2",
          "1"
        ],
        "description": "Compact Framework size token."
      },
      "text": {
        "type": "string",
        "default": "",
        "description": "Visible tag label."
      },
      "count": {
        "type": "string",
        "default": "",
        "description": "Optional count shown with the default tag."
      },
      "icon": {
        "type": "string",
        "default": "",
        "description": "Decorative Framework icon name."
      },
      "color-class": {
        "type": "string",
        "default": "",
        "description": "Framework semantic background utility for the color marker."
      },
      "avatar-image-url": {
        "type": "string",
        "default": "",
        "description": "Avatar image URL; the visible text remains the accessible label."
      },
      "avatar-text": {
        "type": "string",
        "default": "",
        "description": "Avatar initials fallback."
      },
      "root-class": {
        "type": "string",
        "default": "",
        "description": "Framework utility classes for the visible root."
      },
      "avatar-status": {
        "type": "string",
        "default": "",
        "description": "Reserved avatar status value for compatible templates."
      },
      "active": {
        "type": "boolean",
        "default": false,
        "description": "Selected state of a checkbox tag."
      },
      "disabled": {
        "type": "boolean",
        "default": false,
        "description": "Disable interactive toggle and close actions."
      },
      "closable": {
        "type": "boolean",
        "default": false,
        "description": "Show a separate remove action; icon, color and avatar tags enable it by default."
      },
      "aria-label": {
        "type": "string",
        "default": "",
        "description": "Optional accessible name override for a selectable tag."
      },
      "close-label": {
        "type": "string",
        "default": "Удалить",
        "description": "Accessible name of the remove action."
      }
    },
    "additionalProperties": false
  },
  "item_contract": {},
  "contracts": {
    "static": {
      "const": "Default, icon, color, avatar and status tags are labels without an action role or Tab stop."
    },
    "selection": {
      "const": "Checkbox tags render one native toggle button and expose active through aria-pressed."
    },
    "removal": {
      "const": "A removable value keeps its surface static and exposes one separately named close action."
    },
    "events": {
      "const": "A successful toggle emits one change event; a successful removal emits one close event. Disabled controls emit neither."
    },
    "presentation": {
      "const": "Tag geometry uses semantic UI, typography, role-color and motion tokens; static tags do not gain action hover affordance."
    }
  },
  "methods": {
    "onToggle": {
      "summary": "Toggle an enabled checkbox tag and emit its new active state.",
      "arguments": [],
      "returns": {
        "type": [
          "object",
          "boolean",
          "null"
        ]
      }
    },
    "onClose": {
      "summary": "Emit removal intent for an enabled closable tag.",
      "arguments": [],
      "returns": {
        "type": [
          "object",
          "boolean",
          "null"
        ]
      }
    }
  },
  "events": {
    "change": {
      "summary": "The active state of a checkbox tag changed.",
      "payload": {
        "type": "object"
      }
    },
    "close": {
      "summary": "Removal was requested from the separately named close action.",
      "payload": {
        "type": "object"
      }
    }
  },
  "state": {
    "machines": {},
    "visual_states": [
      "default",
      "active",
      "disabled"
    ]
  },
