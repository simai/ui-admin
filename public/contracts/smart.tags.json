{
  "schema_version": 2,
  "id": "smart.tags",
  "version": "1.0.0",
  "title": "Tags",
  "summary": "Compact static, selectable and removable labels with one explicit interaction owner.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "tags"
  ],
  "capabilities": [
    "render",
