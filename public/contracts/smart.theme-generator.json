  "ai_guidance": {
    "use_when": "Use sf-theme-generator where a person chooses a site's or a product's main colour and the rest of its palette should follow.",
    "do_not": [
      "Do not copy generated ui-smart code",
      "Do not copy the palette calculation; import core theme-palette",
      "Do not expect the component to store the choice; the host keeps it"
    ],
    "required_reads": [
      "inputs",
      "events",
      "methods",
      "ownership",
      "provenance"
    ],
    "minimal_example": "<sf-theme-generator value=\"#2e7d32\" apply></sf-theme-generator>",
