{
  "schema_version": 2,
  "id": "smart.theme-generator",
  "version": "1.1.4",
  "title": "Theme generator",
  "summary": "A theme from one colour: the main colour, the generator's own hue and chroma, a preview of the eight palettes and a way back to SIMAI Framework's colour; it stores nothing and changes the page only with apply.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "theme",
    "color",
    "palette",
    "generator"
  ],
  "capabilities": [
    "interaction",
    "keyboard",
    "theme",
    "responsive"
  ],
  "custom_element": "sf-theme-generator",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "smart.button",
      "smart.color",
      "smart.icon",
      "smart.icon-button",
      "smart.input"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "properties": {
      "template": {
        "type": "string",
        "default": "default",
        "description": "Template variant name for SfBaseElement external templates."
      },
      "root-class": {
        "type": "string",
        "default": ""
      },
      "root-style": {
        "type": "string",
        "default": ""
      },
      "value": {
        "type": "string",
        "default": "",
        "description": "The main colour, #rrggbb; empty while SIMAI Framework's own colour applies"
      },
      "hue": {
        "type": "integer",
        "description": "The generator's own hue; unset, the colour's",
        "minimum": 0,
        "maximum": 360
      },
      "chroma": {
        "type": "integer",
        "description": "The generator's own chroma; unset, the colour's",
        "minimum": 0,
        "maximum": 150
      },
      "size": {
        "type": "string",
        "default": "1",
        "enum": [
          "1/2",
          "1",
          "2"
        ]
      },
      "swatches": {
        "type": "string",
        "default": "",
        "description": "The product's colours beside the picker, as sf-color takes them: #hex|Name, #hex"
      },
      "apply": {
        "type": "boolean",
        "default": false,
        "description": "Put the theme on target as inline variables at every change; without it the page is not changed"
      },
      "target": {
        "type": "string",
        "default": "",
        "description": "A CSS selector of the element apply themes; empty, the document's root"
      },
      "selector": {
        "type": "string",
        "default": ":root",
        "description": "The rule's selector in the events and in toCSS()"
      },
      "aria-label": {
        "type": "string",
        "default": ""
      }
    },
    "additionalProperties": false
  },
  "item_contract": {},
  "contracts": {},
  "methods": {
    "reset": {
      "summary": "Back to SIMAI Framework's own colour; a committed choice",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "Nothing."
      }
    },
    "toCSS": {
      "summary": "The theme as one stylesheet rule of its 128 primitives and 98 translucent steps, under the given selector or the `selector` attribute.",
      "arguments": [
        {
          "name": "selector",
          "type": "string",
          "required": false
        }
      ],
      "returns": {
        "type": "string",
        "description": "CSS text."
      }
    },
    "toJSON": {
      "summary": "The theme object (simai.framework.theme.v1): source hue and chroma, and each palette's hue, chroma and tones.",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "A copy of the theme."
      }
    }
  },
  "events": {
    "change": {
      "summary": "The choice changed -- a drag in the picker, a swatch, a number typed (vocabulary 1.1.5 §5.1: sf-theme-change → change on the theme generator); the browser's name, with the theme in the detail",
      "payload": {
        "type": "object",
        "required": [
          "value",
          "hue",
          "chroma",
          "theme",
          "variables",
          "css"
        ],
        "properties": {
          "value": {
            "type": "string"
          },
          "hue": {
            "type": "number"
          },
          "chroma": {
            "type": "number"
          },
          "theme": {
            "type": "object"
          },
          "variables": {
            "type": "object"
          },
          "css": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "sf-theme-generator-committed": {
      "summary": "The choice was committed -- the picker's change, a swatch, Enter or leaving a field, Reset: the theme the host keeps",
      "payload": {
        "type": "object",
        "required": [
          "value",
          "hue",
          "chroma",
          "theme",
          "variables",
          "css"
        ],
        "properties": {
          "value": {
            "type": "string"
          },
          "hue": {
            "type": "number"
          },
          "chroma": {
            "type": "number"
          },
          "theme": {
            "type": "object"
          },
          "variables": {
            "type": "object"
          },
          "css": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "sf-theme-generator-change": {
      "summary": "The choice moved: a drag across the picker, a swatch, a number typed in a field.",
      "payload": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "description": "The chosen colour, '' while the Framework's own one applies."
          },
          "hue": {
            "type": "number"
          },
          "chroma": {
            "type": "number"
          },
          "theme": {
            "type": "object",
            "description": "The theme object, as toJSON()."
          },
          "variables": {
            "type": "object",
            "description": "The 226 custom properties -- 128 tones and 98 translucent steps -- {name: value}."
          },
          "css": {
            "type": "string",
            "description": "The theme as a rule under `selector`."
          }
        }
      }
    },
    "sf-theme-generator-apply": {
      "summary": "The choice was committed: the picker's change, a swatch, Enter or leaving a field, Reset.",
      "payload": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "description": "The chosen colour, '' while the Framework's own one applies."
          },
          "hue": {
            "type": "number"
          },
          "chroma": {
            "type": "number"
          },
          "theme": {
            "type": "object",
            "description": "The theme object, as toJSON()."
          },
          "variables": {
            "type": "object",
            "description": "The 226 custom properties -- 128 tones and 98 translucent steps -- {name: value}."
          },
          "css": {
            "type": "string",
            "description": "The theme as a rule under `selector`."
          }
        }
      }
    },
    "sf-theme-change": {
      "summary": "Its first name, still emitted with the same detail until 2026-12-01 (journal event-theme-generator-names); the Loader's light/dark event bears it too. Bind sf-theme-generator-change.",
      "payload": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "description": "The chosen colour, '' while the Framework's own one applies."
          },
          "hue": {
            "type": "number"
          },
          "chroma": {
            "type": "number"
          },
          "theme": {
            "type": "object",
            "description": "The theme object, as toJSON()."
          },
          "variables": {
            "type": "object",
            "description": "The 226 custom properties -- 128 tones and 98 translucent steps -- {name: value}."
          },
          "css": {
            "type": "string",
            "description": "The theme as a rule under `selector`."
          }
        }
      }
    },
    "sf-theme-apply": {
      "summary": "Its first name, still emitted with the same detail until 2026-12-01 (journal event-theme-generator-names); the Loader's light/dark event bears it too. Bind sf-theme-generator-apply.",
      "payload": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "description": "The chosen colour, '' while the Framework's own one applies."
          },
          "hue": {
            "type": "number"
          },
          "chroma": {
            "type": "number"
          },
          "theme": {
            "type": "object",
            "description": "The theme object, as toJSON()."
          },
          "variables": {
            "type": "object",
            "description": "The 226 custom properties -- 128 tones and 98 translucent steps -- {name: value}."
          },
          "css": {
            "type": "string",
            "description": "The theme as a rule under `selector`."
          }
        }
      }
    }
  },
  "state": {
    "machines": {
      "advanced": [
        "folded",
        "open"
      ]
    },
    "visual_states": [
      "default"
    ]
  },
  "persistence": {
    "mode": "none",
    "source_of_truth": "host",
    "network_owner": "none",
    "revision_field": null
  },
  "ownership": {
    "source": "simai/ui-source",
    "data": "host",
    "effects": "host",
    "forbidden_client_responsibilities": [
      "backend access decisions",
      "storing the chosen theme"
    ]
  },
  "security": {
    "permissions_owner": "host",
    "untrusted_inputs": [
      "props",
      "children"
    ],
    "network_policy": "deny"
  },
  "accessibility": {
    "role": "group",
    "accessible_name": "recommended",
    "keyboard": [
      "Tab",
      "Enter",
      "Space"
    ],
    "focus": "The colour control, Reset, the «Advanced» disclosure and its two number fields are in the focus order; Enter in a field commits the theme. The preview is a named region of labelled swatches, each giving its palette, tone and hex."
  },
  "presentation": {
    "themes": [
      "light",
      "dark"
    ],
    "locales": [
      "ru",
      "en"
    ],
    "responsive": [
      "desktop",
      "mobile",
      "ltr",
      "rtl",
      "reduced-motion"
    ],
    "skeleton": {
      "shape": "block",
      "while_loading": "none"
    }
  },
  "adapter": {
    "kind": "generic",
    "protocol": "simai.smart-studio-adapter.v1",
    "module": null
  },
  "artifacts": {
    "fixtures": [
      "studio.fixture.json"
    ],
    "scenarios": [
      "studio.scenario.json"
    ]
  },
  "readiness": {
    "level": "runnable",
    "required_checks": [
      "manifest",
      "fixture",
      "runtime-upgrade",
      "scenario-smoke",
      "keyboard",
      "responsive",
      "a11y"
    ]
  },
  "compatibility": {
