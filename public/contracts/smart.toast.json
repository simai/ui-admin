{
  "schema_version": 2,
  "id": "smart.toast",
  "version": "1.0.0",
  "title": "Toast",
  "summary": "Transient overlay feedback with semantic roles, optional action, pause-safe lifetime and dismiss behavior.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "toast"
  ],
  "capabilities": [
    "render",
    "theme",
    "responsive"
  ],
  "custom_element": "sf-toast",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "component.toast",
      "component.buttons",
      "smart.icon-buttons",
      "smart.icons"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "default": "neutral",
        "enum": [
          "neutral",
          "info",
          "success",
          "warning",
          "error"
        ],
        "description": "What the message reports, in the shared status vocabulary. The words this component used before — default and primary — are still accepted and mean neutral and info."
      },
      "icon": {
        "type": "string",
        "default": "",
        "description": "Optional decorative icon name."
      },
      "title": {
        "type": "string",
        "default": "",
        "description": "Short result heading."
      },
      "supporting-text": {
        "type": "string",
        "default": "",
        "description": "Concise supporting text at the normal body size."
      },
      "action-text": {
        "type": "string",
        "default": "",
        "description": "Visible label of the one optional action."
      },
      "action": {
        "type": "string",
        "default": "action",
        "description": "Stable action value emitted in sf-toast-action."
      },
      "closable": {
        "type": "boolean",
        "default": true,
        "description": "Render an explicitly named close action."
      },
      "close-label": {
        "type": "string",
        "default": "Close message",
        "description": "Localized accessible name of the close action."
      },
      "duration": {
        "type": "number",
        "default": 0,
        "minimum": 0,
        "description": "Explicit lifetime in milliseconds. Zero keeps the message until dismissed."
      },
      "role": {
        "type": "string",
        "default": "",
        "description": "Live-region role for dynamically inserted feedback only.",
        "enum": [
          "",
          "status",
          "alert"
        ]
      },
      "root-class": {
        "type": "string",
        "default": ""
      },
      "type": {
        "type": "string",
        "default": "neutral",
        "description": "Legacy name for status, still honoured. See contracts/public-api-axes.json.",
        "enum": [
          "neutral",
          "info",
          "success",
          "warning",
          "error"
        ]
      }
    },
    "additionalProperties": false
  },
  "item_contract": {},
  "contracts": {
    "semantic_types": {
      "type": "string",
      "enum": [
        "default",
        "primary",
        "error",
        "warning",
        "success"
      ]
    },
    "canonical_behavior_attributes": {
      "type": "string",
      "enum": [
        "data-action",
        "data-close",
        "data-duration"
      ]
    },
    "dismissal_state": {
      "const": "closing"
    },
    "lifetime": {
      "persistent": "duration=0; required for messages whose action or content must not be missed",
      "timed": "positive duration; pauses while pointer or keyboard focus is inside the toast",
      "dismiss": "token motion completes before the visual owner is removed"
    },
    "live_region_guidance": {
      "assertive": "role=alert only for a newly inserted urgent error",
      "polite": "role=status for a newly inserted non-urgent result",
      "static": "omit a live-region role when the toast is present on initial page load"
    }
  },
  "methods": {
    "close": {
      "summary": "Public runtime method close.",
      "arguments": [],
      "returns": {
        "type": [
          "object",
          "boolean",
          "null"
        ]
      }
    },
    "setState": {
      "summary": "Public runtime method setState.",
      "arguments": [],
      "returns": {
        "type": [
          "object",
          "boolean",
          "null"
        ]
      }
    },
    "onAction": {
      "summary": "Public runtime method onAction.",
      "arguments": [],
      "returns": {
        "type": [
          "object",
          "boolean",
          "null"
        ]
      }
    },
    "onClose": {
      "summary": "Public runtime method onClose.",
      "arguments": [],
      "returns": {
        "type": [
          "object",
          "boolean",
          "null"
        ]
      }
    }
  },
  "events": {
    "sf-toast-action": {
      "summary": "Emitted once when the optional enabled action is activated.",
      "payload": {
        "type": "object"
      }
    },
    "sf-toast-close": {
      "summary": "Emitted once before token-based dismissal removes the toast owner.",
      "payload": {
        "type": "object"
      }
    }
  },
  "state": {
    "machines": {},
    "visual_states": [
      "default"
    ]
  },
  "persistence": {
    "mode": "none",
    "source_of_truth": "component",
    "network_owner": "none",
    "revision_field": null
  },
  "ownership": {
    "source": "simai/ui-source",
