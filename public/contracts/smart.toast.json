  "ai_guidance": {
    "use_when": "Use sf-toast for concise transient overlay feedback that does not block the current task.",
    "do_not": [
      "Do not use Toast for persistent inline guidance; use Alert",
      "Do not auto-dismiss a message whose content or action must not be missed",
      "Do not use role=alert for routine success feedback",
      "Do not choose a semantic type only for its color",
      "Do not copy generated ui-smart code",
      "Do not move host data or access decisions into the component"
    ],
    "required_reads": [
      "inputs",
      "methods",
      "events",
      "ownership",
      "provenance"
    ],
    "minimal_example": "<sf-toast type=\"success\" title=\"Saved\" supporting-text=\"Your changes are available.\" role=\"status\" close-label=\"Close message\"></sf-toast>",
    "owner_commands": [
      "npm run contract:verify",
      "npm test"
    ]
  }
