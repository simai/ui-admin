    ],
    "network_policy": "deny"
  },
  "accessibility": {
    "role": null,
    "accessible_name": "internal",
    "keyboard": [
      "Tab"
    ],
    "focus": "Native actions use focus-visible; a timed toast pauses while focus is inside it."
  },
  "presentation": {
    "themes": [
      "light",
      "dark"
    ],
    "locales": [
      "ru",
      "en"
    ],
    "responsive": [
      "desktop",
      "mobile"
    ]
  },
  "adapter": {
    "kind": "generic",
    "protocol": "simai.smart-studio-adapter.v1",
    "module": null
  },
  "artifacts": {
