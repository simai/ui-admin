{
  "schema_version": 2,
  "id": "smart.tree-item",
  "version": "1.1.4",
  "title": "Tree item",
  "summary": "A node of a tree: a folder that opens a group of nodes, or a file or link. Inside sf-tree it is read once as data and the tree draws its row; alone it draws itself.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "tree-item"
  ],
  "capabilities": [
    "render",
    "keyboard-focus",
    "selection",
    "theme",
    "responsive"
  ],
  "custom_element": "sf-tree-item",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "component.icon-buttons",
      "component.icons",
      "component.tree-item"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "properties": {
      "template": {
        "type": "string",
        "default": "default",
        "description": "Template variant name for SfBaseElement external templates."
      },
      "root-class": {
        "type": "string",
        "default": ""
      },
      "root-style": {
        "type": "string",
        "default": ""
      },
      "label": {
        "type": "string",
        "default": "",
        "description": "The node's name; without it the node's own text is"
      },
      "href": {
        "type": "string",
        "default": ""
      },
      "target": {
        "type": "string",
        "default": ""
      },
      "rel": {
        "type": "string",
        "default": ""
      },
      "kind": {
        "type": "string",
        "default": "folder",
        "description": "What the tree item is: a folder or a file.",
        "enum": [
          "folder",
          "file"
        ]
      },
      "value": {
        "type": "string",
        "default": "",
        "description": "The node's id: data-value of its row, the id its events carry"
      },
      "disabled": {
        "type": "boolean",
        "default": false
      },
      "open-icon": {
        "type": "string",
        "default": "folder_open"
      },
      "closed-icon": {
        "type": "string",
        "default": "folder"
      },
      "icon": {
        "type": "boolean",
        "default": true,
        "description": "false hides the folder or file icon"
      },
      "chevron-open-icon": {
        "type": "string",
        "default": "keyboard_arrow_down"
      },
      "chevron-closed-icon": {
        "type": "string",
        "default": "chevron_right"
      },
      "open-label": {
        "type": "string",
        "description": "The chevron's name while the branch is closed"
      },
      "close-label": {
        "type": "string",
        "description": "The chevron's name while the branch is open"
      },
      "item-class": {
        "type": "string",
        "default": "",
        "description": "Classes for the row's box"
      },
      "container-class": {
        "type": "string",
        "default": "",
        "description": "Classes for the row's line"
      },
      "name-class": {
        "type": "string",
        "default": "",
        "description": "Classes for the row's name"
      },
      "open": {
        "type": "boolean",
        "default": false,
        "description": "The branch is open"
      },
      "selected": {
        "type": "boolean",
        "default": false
      },
      "active": {
        "type": "boolean",
        "default": false,
        "description": "The node is the current page: aria-current"
      },
      "text": {
        "type": "string",
        "default": "",
        "description": "Dated alias of label until 2026-12-01."
      },
      "type": {
        "type": "string",
        "default": "folder",
        "description": "Legacy name for kind, still honoured. See contracts/public-api-axes.json.",
        "enum": [
          "folder",
          "file"
        ]
      },
      "items-data": {
        "type": "array",
        "default": [],
        "items": {
          "type": "object"
        },
        "description": "The node's children as data (sf-tree's entry shape); children written inside are read once otherwise"
      }
    },
    "additionalProperties": false
  },
  "item_contract": {},
  "contracts": {},
  "methods": {
    "expand": {
      "summary": "Opens the branch; refused for a file, a leaf or a disabled node",
      "arguments": [],
      "returns": {
        "type": "object"
      }
    },
    "collapse": {
      "summary": "Closes the branch",
      "arguments": [],
      "returns": {
        "type": "object"
      }
    },
    "toggleOpen": {
      "summary": "Opens a closed branch, closes an open one",
      "arguments": [],
      "returns": {
        "type": "object"
      }
    },
    "activate": {
      "summary": "What Enter does on a leaf: follows its link, or sends open",
      "arguments": [],
      "returns": {
        "type": [
          "object"
        ]
      }
    },
    "focusItem": {
      "summary": "Moves the focus to the node's row",
      "arguments": [],
      "returns": {
        "type": [
          "object"
        ]
      }
    },
    "setOpen": {
      "summary": "Opens or closes a branch and emits sf-tree-item-toggle; does nothing for a file, a leaf, a disabled item or an unchanged state.",
      "arguments": [
        {
          "name": "open",
          "type": "boolean",
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "open": {
      "summary": "Same as setOpen(true).",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "close": {
      "summary": "Same as setOpen(false).",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "toggle": {
      "summary": "Flips the open state through setOpen.",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "onToggle": {
      "summary": "Adds a listener for sf-tree-item-toggle; the handler is called with (open, detail, event). Ignores a non-function handler.",
      "arguments": [
        {
          "name": "handler",
          "type": "function",
          "required": true
        },
        {
          "name": "options",
          "type": "object|boolean",
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    }
  },
  "events": {
    "sf-tree-item-open": {
      "summary": "A press on the name, or Enter on a leaf without a link: open {id} of vocabulary 1.1.5 §5",
      "payload": {
        "type": "object",
        "required": [
          "id",
          "value"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "canonical": true
    },
    "sf-tree-item-toggle": {
      "summary": "The branch opened or closed (vocabulary §5 toggle); the DOM name sf-tree-item-toggle is unchanged",
      "payload": {
        "type": "object",
        "required": [
          "id",
          "open",
          "value"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "open": {
            "type": "boolean"
          },
          "value": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "sf-tree-item-click": {
      "summary": "Runtime event sf-tree-item-click.",
      "payload": {
        "type": "object",
        "properties": {
          "component": {
            "type": "object",
            "description": "The emitting element."
          },
          "tagName": {
            "type": "string"
          },
          "template": {
            "type": "string"
          },
          "item": {
            "type": "object",
            "description": "The sf-tree-item."
          },
          "value": {
            "type": "string"
          },
          "originalEvent": {
            "type": [
              "object",
              "null"
            ],
            "description": "The click; null when activated from the keyboard (Enter) on an item without a link."
          }
        },
        "required": [
          "component",
          "tagName",
          "template",
          "item",
          "value",
          "originalEvent"
        ]
      },
      "alias_of": "sf-tree-item-open"
    }
  },
  "state": {
    "machines": {
      "disclosure": [
        "closed",
        "open"
      ],
      "focus": [
        "active"
      ],
      "selection": [
        "selected"
      ]
    },
    "visual_states": [
      "default",
      "open",
      "closed",
      "active",
      "selected",
      "disabled"
    ]
  },
  "persistence": {
    "mode": "none",
    "source_of_truth": "component",
    "network_owner": "none",
    "revision_field": null
  },
  "ownership": {
