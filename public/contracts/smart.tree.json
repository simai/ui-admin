{
  "schema_version": 2,
  "id": "smart.tree",
  "version": "2.0.6",
  "title": "Tree",
  "summary": "A tree of entries: folders that open, files and links; one Tab stop walked with the arrows, optional selection, drops of records and files on an entry. Thousands of entries: keyed rows, a window over more than 300.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "tree"
  ],
  "capabilities": [
    "render",
    "keyboard-navigation",
    "selection",
    "theme",
    "responsive"
  ],
  "custom_element": "sf-tree",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "component.icon-buttons",
      "component.icons",
      "component.tree",
      "component.tree-item",
      "smart.tree-item"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "properties": {
      "template": {
        "type": "string",
        "default": "default",
        "description": "Template variant name for SfBaseElement external templates."
      },
      "root-class": {
        "type": "string",
        "default": ""
      },
      "root-style": {
        "type": "string",
        "default": ""
      },
      "selection": {
        "type": "string",
        "default": "none",
        "description": "What a press does: none opens the entry (or follows its link), one selects one entry, many toggles each",
        "enum": [
          "none",
          "one",
          "many"
        ]
      },
      "accept-records": {
        "type": "boolean",
        "default": false,
        "description": "An entry takes records dragged from a list (application/x-sf-records+json)"
      },
      "accept-files": {
        "type": "boolean",
        "default": false,
        "description": "An entry takes files dragged from the computer"
      },
      "selected": {
        "type": "string",
        "default": "",
        "description": "The current entry's id (§18.2); with selection many, the one pressed last"
      },
      "aria-label": {
        "type": "string",
        "default": ""
      },
      "items": {
        "type": "array",
        "default": [],
        "items": {
          "type": "object"
        },
        "description": "The tree as data: entries with children; sf-tree-item children written inside are read once otherwise. An entry's id is id, else value, else its place"
      },
      "selected-ids": {
        "type": "array",
        "default": [],
        "description": "The selected ids in entry order, with selection many (§18.2)"
      }
    },
    "additionalProperties": false
  },
  "item_contract": {},
  "contracts": {},
  "methods": {
    "expand": {
      "summary": "Opens a branch; refused for an unknown id, a leaf or a disabled entry",
      "arguments": [
        {
          "name": "id",
          "schema": {}
        }
      ],
      "returns": {
        "type": "object"
      }
    },
    "collapse": {
      "summary": "The action collapse.",
      "arguments": [
        {
          "name": "id",
          "schema": {}
        }
      ],
      "returns": {
        "type": "object"
      }
    },
    "focusEntry": {
      "summary": "Moves the focus to an entry, drawing it first when the window holds it out",
      "arguments": [
        {
          "name": "id",
          "schema": {}
        }
      ],
      "returns": {
        "type": "object"
      }
    },
    "onToggle": {
      "summary": "Adds a listener for sf-tree-toggle from any item in the tree; the handler is called with (item, detail, event).",
      "arguments": [
        {
          "name": "handler",
          "type": "function",
          "required": true
        },
        {
          "name": "options",
          "type": "object|boolean",
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    }
  },
  "events": {
    "sf-tree-open": {
      "summary": "A press on an entry's name, or Enter on a leaf without a link (vocabulary 1.1.5 §5 open)",
      "payload": {
        "type": "object",
        "required": [
          "id",
          "value"
        ],
        "properties": {
          "id": {},
          "value": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "canonical": true
    },
    "sf-tree-select": {
      "summary": "The selection changed: ids is the whole selection, id the entry pressed and selected whether it is now selected (vocabulary §5 select)",
      "payload": {
        "type": "object",
        "required": [
          "ids",
          "id",
          "selected"
        ],
        "properties": {
          "ids": {
            "type": "array"
          },
          "id": {},
          "selected": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      },
      "canonical": true
    },
    "sf-tree-toggle": {
      "summary": "A branch opened or closed (vocabulary §5 toggle)",
      "payload": {
        "type": "object",
        "required": [
          "id",
          "open",
          "value"
        ],
        "properties": {
          "id": {},
          "open": {
            "type": "boolean"
          },
          "value": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "canonical": true
    },
    "sf-tree-move": {
      "summary": "Records dragged from a list were dropped on an entry: the request to move them into it (vocabulary §5 move); the tree moves nothing itself",
      "payload": {
        "type": "object",
        "required": [
          "ids",
          "parent",
          "before",
          "source"
        ],
        "properties": {
          "ids": {
            "type": "array"
          },
          "parent": {},
          "before": {},
          "source": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "canonical": true
    },
    "sf-tree-attach": {
      "summary": "Files were dropped on an entry: the request to attach them there (vocabulary §5 attach); the tree uploads nothing itself",
      "payload": {
        "type": "object",
        "required": [
          "files",
          "parent"
        ],
        "properties": {
          "files": {
            "type": "array"
          },
          "parent": {}
        },
        "additionalProperties": true
      },
      "canonical": true
    },
    "sf-tree-window": {
      "summary": "With more than 300 visible entries, which of them are drawn (§18.4)",
      "payload": {
        "type": "object",
        "required": [
          "first",
          "last"
        ],
        "properties": {
          "first": {
            "type": "number"
          },
          "last": {
            "type": "number"
          }
        },
        "additionalProperties": true
      }
    },
    "sf-tree-selection-change": {
      "summary": "Selection requested or changed for a tree item.",
      "payload": {
        "type": "object",
        "properties": {
          "component": {
            "type": "object",
            "description": "The emitting element."
          },
          "tagName": {
            "type": "string"
          },
          "template": {
            "type": "string"
          },
          "item": {
            "type": "object",
            "description": "The sf-tree-item."
          },
          "selected": {
            "type": "boolean"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "component",
          "tagName",
          "template",
          "item",
          "selected",
          "value"
        ]
      },
      "alias_of": "sf-tree-select"
    },
    "sf-tree-records-drop": {
      "summary": "Records dragged from a list were dropped on a node: {value, ids, source}. The tree moves nothing.",
      "payload": {
        "type": "object"
      },
      "alias_of": "sf-tree-move"
    },
    "sf-tree-files-drop": {
      "summary": "Files from the computer were dropped on a node: {value, files}. The tree uploads nothing.",
      "payload": {
        "type": "object"
      },
      "alias_of": "sf-tree-attach"
    },
    "sf-tree-item-click": {
      "summary": "Dated alias of sf-tree-open until 2026-12-01 (split).",
      "payload": {
        "type": "object"
      },
      "alias_of": "sf-tree-open"
    },
    "sf-tree-item-toggle": {
      "summary": "Dated alias of sf-tree-toggle until 2026-12-01 (split).",
      "payload": {
        "type": "object"
      },
      "alias_of": "sf-tree-toggle"
    }
  },
  "state": {
    "machines": {
      "disclosure": [
        "closed",
        "open"
      ],
      "focus": [
        "active"
      ],
      "selection": [
        "selected"
      ]
    },
    "visual_states": [
      "default",
      "active",
      "selected",
      "open",
      "closed"
    ]
  },
  "persistence": {
    "mode": "none",
    "source_of_truth": "component",
    "network_owner": "none",
    "revision_field": null
  },
  "ownership": {
    "source": "simai/ui-source",
    "data": "fixture",
    "effects": "component",
    "forbidden_client_responsibilities": [
      "backend access decisions",
      "host route invention"
    ]
  },
  "security": {
    "permissions_owner": "none",
    "untrusted_inputs": [
      "props",
      "children"
    ],
    "network_policy": "deny"
  },
  "accessibility": {
    "role": "tree",
    "accessible_name": "required",
    "keyboard": [
      "Tab",
      "ArrowUp",
      "ArrowDown",
      "ArrowLeft",
      "ArrowRight",
      "Home",
      "End",
      "Enter",
      "Space",
      "typeahead"
    ],
    "focus": "One visible tree item is in the page tab order; arrows move roving focus independently of selection."
  },
  "presentation": {
    "themes": [
      "light",
      "dark"
    ],
    "locales": [
      "ru",
      "en"
    ],
    "responsive": [
      "desktop",
      "mobile"
    ],
    "skeleton": {
      "shape": "menu",
      "while_loading": "none"
    }
  },
  "adapter": {
    "kind": "generic",
    "protocol": "simai.smart-studio-adapter.v1",
    "module": null
  },
  "artifacts": {
    "fixtures": [
      "studio.fixture.json"
    ],
    "scenarios": [
      "studio.scenario.json"
    ]
  },
  "readiness": {
    "level": "described",
    "required_checks": [
      "manifest",
      "fixture",
      "runtime-upgrade",
      "scenario-smoke"
    ]
  },
  "compatibility": {
