{
  "schema_version": 2,
  "id": "smart.tree",
  "version": "2.0.2",
  "title": "Tree",
  "summary": "Accessible hierarchical composite with roving focus, branch expansion and host-owned selection.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "tree"
  ],
  "capabilities": [
    "render",
    "keyboard-navigation",
    "selection",
    "theme",
    "responsive"
  ],
  "custom_element": "sf-tree",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "component.icon-buttons",
      "component.icons",
      "component.tree",
      "component.tree-item",
      "smart.tree-item"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "properties": {
      "template": {
        "type": "string",
        "default": "default"
      },
      "root-class": {
        "type": "string",
        "default": ""
      },
      "aria-label": {
        "type": "string",
        "default": ""
      },
      "role": {
        "type": "string",
        "default": "tree",
        "enum": [
          "tree"
        ]
      },
      "selection": {
        "type": "string",
        "default": "none",
        "enum": [
          "none",
          "one",
          "many"
        ],
        "description": "What a press does: none opens the entry (or follows its link), one selects one entry, many toggles each. single and multiple are the former words of one and many, dated value aliases until 2026-12-01 (compatibility.aliases)."
      },
      "items": {
        "type": "array",
        "default": [],
        "items": {
          "type": "object"
        },
        "description": "Items given as data instead of as sf-tree-item children (set as a property, not an attribute): [{label, href?, target?, rel?, kind?, value?, open?, selected?, active?, disabled?, icon?, openIcon?, closedIcon?, chevronOpenIcon?, chevronClosedIcon?, openLabel?, closeLabel?, children?}]. text or title stand in for label. Setting it replaces the items and re-renders; sf-tree-item children are read once and removed, so a parent that re-renders changed items passes them this way."
      },
      "accept-records": {
        "type": "boolean",
        "default": false,
        "description": "A node takes the records dragged from a list (application/x-sf-records+json) and says so with sf-tree-records-drop."
      },
      "accept-files": {
        "type": "boolean",
        "default": false,
        "description": "A node takes files dropped from the computer and says so with sf-tree-files-drop."
      },
      "selected": {
        "type": "string",
        "default": ""
      },
      "selected-ids": {
        "type": "array",
        "default": []
      }
    },
    "additionalProperties": false
  },
  "item_contract": {},
  "contracts": {},
  "methods": {
    "onToggle": {
      "summary": "Adds a listener for sf-tree-item-toggle from any item in the tree; the handler is called with (item, detail, event).",
      "arguments": [
        {
          "name": "handler",
          "type": "function",
          "required": true
        },
        {
          "name": "options",
          "type": "object|boolean",
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    }
  },
  "events": {
    "sf-tree-selection-change": {
      "summary": "Selection requested or changed for a tree item.",
      "payload": {
        "type": "object",
        "properties": {
          "component": {
            "type": "object",
            "description": "The emitting element."
          },
          "tagName": {
            "type": "string"
          },
          "template": {
            "type": "string"
          },
          "item": {
            "type": "object",
            "description": "The sf-tree-item."
          },
          "selected": {
            "type": "boolean"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "component",
          "tagName",
          "template",
          "item",
          "selected",
          "value"
        ]
      }
    },
    "sf-tree-records-drop": {
      "summary": "Records dragged from a list were dropped on a node: {value, ids, source}. The tree moves nothing.",
      "payload": {
        "type": "object"
      }
    },
    "sf-tree-files-drop": {
      "summary": "Files from the computer were dropped on a node: {value, files}. The tree uploads nothing.",
      "payload": {
        "type": "object"
      }
    }
  },
  "state": {
    "machines": {
      "disclosure": [
        "closed",
        "open"
      ],
      "focus": [
        "active"
      ],
      "selection": [
        "selected"
      ]
    },
    "visual_states": [
      "default",
      "active",
      "selected",
      "open",
      "closed"
    ]
  },
  "persistence": {
    "mode": "none",
    "source_of_truth": "component",
    "network_owner": "none",
    "revision_field": null
  },
  "ownership": {
    "source": "simai/ui-source",
    "data": "fixture",
    "effects": "component",
    "forbidden_client_responsibilities": [
      "backend access decisions",
      "host route invention"
    ]
  },
  "security": {
    "permissions_owner": "none",
    "untrusted_inputs": [
      "props",
      "children"
    ],
    "network_policy": "deny"
  },
  "accessibility": {
    "role": "tree",
    "accessible_name": "required",
    "keyboard": [
      "Tab",
      "ArrowUp",
      "ArrowDown",
      "ArrowLeft",
      "ArrowRight",
      "Home",
      "End",
      "Enter",
      "Space",
      "typeahead"
    ],
    "focus": "One visible tree item is in the page tab order; arrows move roving focus independently of selection."
  },
  "presentation": {
    "themes": [
      "light",
      "dark"
    ],
    "locales": [
      "ru",
      "en"
    ],
    "responsive": [
      "desktop",
      "mobile"
    ],
    "skeleton": {
      "shape": "menu",
      "while_loading": "none"
    }
  },
  "adapter": {
    "kind": "generic",
    "protocol": "simai.smart-studio-adapter.v1",
    "module": null
  },
  "artifacts": {
    "fixtures": [
      "studio.fixture.json"
    ],
    "scenarios": [
      "studio.scenario.json"
    ]
  },
  "readiness": {
    "level": "described",
    "required_checks": [
      "manifest",
      "fixture",
      "runtime-upgrade",
      "scenario-smoke"
    ]
  },
  "compatibility": {
    "contract_schema": {
      "id": "https://simai.io/contracts/smart-component-manifest.v2.schema.json",
      "version": 2
    },
    "runtime_pair": {
      "ui_revision": "094f3d549aa7921d2d7f8773972c73711dd6a72e",
      "ui_smart_revision": "856fb5d751fad1c76104c32515f4c1869dd75b6c"
    },
    "aliases": [
      "selection=single",
      "selection=multiple"
    ],
    "deprecations": [
      {
        "path": "selection=single",
        "since": "2.0.0",
        "replacement": "selection=one"
      },
      {
        "path": "selection=multiple",
        "since": "2.0.0",
        "replacement": "selection=many"
      }
    ],
    "replacement": null,
    "migrations": []
  },
